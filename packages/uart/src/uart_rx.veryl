/// 非同期シリアル入力を受信するUARTレシーバ。
///
/// `CLK_FREQ`と`BAUD_RATE`から1ビットのクロック数を計算し、スタートビット、
/// `DATA_WIDTH`ビットのデータ、ストップビットを順にサンプリングする。
/// 1バイトの受信完了時に`valid`を1クロックだけアサートする。
/// data bitはLSB-firstで、各bitの中央をサンプリングする。stop bitがLowなら
/// framing errorとして破棄し、`valid`をアサートしない。
///
/// ```wavedrom
/// {
///   signal: [
///     { name: 'rx',     wave: '1.0.3.4.5...6.1.', data: ['start', 'D0', 'D1', 'D2..D6', 'D7', 'stop'] },
///     { name: 'sample', wave: '0..101010|10.10.' },
///     { name: 'data',   wave: 'x...........7..', data: ['D7..D0'] },
///     { name: 'valid',  wave: '0...........10.' }
///   ],
///   head: { text: 'UART receive (bit periods abbreviated)' }
/// }
/// ```
pub module UartRx #(
    param CLK_FREQ  : u32 = 50_000_000,
    param BAUD_RATE : u32 = 31250     ,
    param DATA_WIDTH: u8  = 8         ,
) (
    clk  : input  clock            ,
    rst  : input  reset            ,
    rx   : input  logic            ,
    data : output logic<DATA_WIDTH>,
    valid: output logic            ,
) {
    const CYCLES_PER_BIT: u32 = CLK_FREQ / BAUD_RATE;

    enum State {
        Idle,
        Start,
        Data,
        Stop,
    }
    import State::*;

    var state  : State            ;
    var clk_cnt: u32              ;
    var bit_cnt: u8               ;
    var rx_reg : logic<DATA_WIDTH>;

    always_ff {
        if_reset {
            state   = Idle;
            clk_cnt = 0;
            bit_cnt = 0;
            rx_reg  = 0;
            valid   = 0;
            data    = 0;
        } else {
            // validは1クロックのみアサートする
            valid = 0;

            case state {
                Idle: {
                    // Startビット(Low)を検出
                    if !rx {
                        state = Start;
                        // ビットの中央でサンプリングするため、サイクル数を半分に設定
                        // オフバイワン修正: カウンタはN→0でN+1サイクル待つため-1が必要
                        clk_cnt = CYCLES_PER_BIT / 2 - 1;
                    }
                }
                Start: {
                    if clk_cnt == 0 {
                        if !rx {
                            // スタートビット確認OK、データ受信開始
                            state   = Data;
                            clk_cnt = CYCLES_PER_BIT - 1;
                            bit_cnt = 0;
                        } else {
                            // 偽スタート検出、アイドルに戻る
                            state = Idle;
                        }
                    } else {
                        clk_cnt = clk_cnt - 1;
                    }
                }
                Data: {
                    if clk_cnt == 0 {
                        // LSBファーストで受信データをシフトレジスタに格納
                        rx_reg[bit_cnt] = rx;
                        clk_cnt         = CYCLES_PER_BIT - 1;

                        if bit_cnt == DATA_WIDTH - 1 {
                            state = Stop;
                        } else {
                            bit_cnt = bit_cnt + 1;
                        }
                    } else {
                        clk_cnt = clk_cnt - 1;
                    }
                }
                Stop: {
                    if clk_cnt == 0 {
                        state = Idle;
                        if rx {
                            // 正常なストップビット、受信完了
                            data  = rx_reg;
                            valid = 1;
                        }
                        // ストップビットがLowの場合はフレーミングエラー、o_validを出さない
                    } else {
                        clk_cnt = clk_cnt - 1;
                    }
                }
            }
        }
    }
}

/// UART frameから0x90をLSB-firstで受信し、valid pulseを検証
#[test(test_uart_rx)]
module test_uart_rx {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var rx        : logic   ;
    var data      : logic<8>;
    var valid     : logic   ;
    var valid_seen: logic   ; // valid の 1クロックパルスをラッチするフラグ

    // CLK_FREQ=50_000_000, BAUD_RATE=31250, DATA_WIDTH=8
    inst dut: UartRx #(
        CLK_FREQ  : 50_000_000,
        BAUD_RATE : 31250     ,
        DATA_WIDTH: 8         ,
    ) (
        clk         ,
        rst         ,
        rx   : rx   ,
        data : data ,
        valid: valid,
    );

    // valid パルスをラッチ: valid==1 のクロックが来たら valid_seen を 1 にする
    always_ff (clk, rst) {
        if_reset {
            valid_seen = 0;
        } else {
            if valid {
                valid_seen = 1;
            }
        }
    }

    const CYCLES_PER_BIT: u32 = 1600; // 50_000_000 / 31250

    initial {
        rx = 1; // アイドル (High)
        rst.assert();
        clk.next(10);

        // 0x90 (= 0b10010000) をLSBファーストで送信
        // スタートビット
        rx = 0;
        clk.next(CYCLES_PER_BIT);
        // Bit 0 = 0
        rx = 0;
        clk.next(CYCLES_PER_BIT);
        // Bit 1 = 0
        rx = 0;
        clk.next(CYCLES_PER_BIT);
        // Bit 2 = 0
        rx = 0;
        clk.next(CYCLES_PER_BIT);
        // Bit 3 = 0
        rx = 0;
        clk.next(CYCLES_PER_BIT);
        // Bit 4 = 1
        rx = 1;
        clk.next(CYCLES_PER_BIT);
        // Bit 5 = 0
        rx = 0;
        clk.next(CYCLES_PER_BIT);
        // Bit 6 = 0
        rx = 0;
        clk.next(CYCLES_PER_BIT);
        // Bit 7 = 1
        rx = 1;
        clk.next(CYCLES_PER_BIT);
        // ストップビット: 受信完了まで全クロック待つ
        rx = 1;
        clk.next(CYCLES_PER_BIT);

        // valid パルスが来たことをラッチで確認 (valid 自体は既に 0 に戻っている)
        $assert(valid_seen == 1'b1, "o_valid should have been asserted");
        $assert(data == 8'h90, "received data should be 0x90");
        // 受信完了後は valid=0 (アイドル状態)
        $assert(valid == 1'b0, "o_valid should be 0 after reception");

        $finish();
    }
}
