/// ADATフレームパーサ
///
/// ビット列からユーザーデータと8チャンネルPCMデータを抽出する。
/// 30ビットエンコードから24ビットPCMに変換する。
///
/// # フレーム構造 (256 bits)
/// ```text
/// [Sync 10bit][1][User 4bit][1][Ch0 30bit][Ch1 30bit]...[Ch7 30bit]
/// ```
///
/// ビット位置 (終了位置):
/// - User: bit 15
/// - Ch0: bit 45
/// - Ch1: bit 75
/// - Ch2: bit 105
/// - Ch3: bit 135
/// - Ch4: bit 165
/// - Ch5: bit 195
/// - Ch6: bit 225
/// - Ch7: bit 255
///
/// # 30bit → 24bit 変換
/// sync_bitを除去した24bit PCMデータへの変換
/// 各チャンネルは6つの5bitニブルで構成:
/// - 各ニブル: [D3:D0][sync_bit]
/// - 24bit = D[23:20] | D[19:16] | D[15:12] | D[11:8] | D[7:4] | D[3:0]
///
/// # シリアル伝送順とビット有意性の注意
/// - `bits` は bit_decoder からの LSB-aligned 符号化表現
///   例: 5bit間隔（"00001"）は `bits=5'b10000`（`bits[4]=1`）
/// - 本モジュールは `bits[0]` から順に shift へ取り込むため、取り込み時点では nibble 内ビット並びが反転して見える
/// - ただし抽出位置を固定して24bit語へ再構成するため、最終 `data` のビット有意性は `data[23]` がMSB、`data[0]` がLSBで一定
/// - `data` は24bit単一ベクタであり、byte order（エンディアン）に依存しない
module FrameParser (
    clk       : input  clock    , /// システムクロック
    rst       : input  reset    , /// リセット
    bits      : input  logic<5> , /// デコードされたビット列
    bit_count : input  logic<3> , /// ビット数
    valid     : input  logic    , /// ビット有効
    sync      : input  logic    , /// 同期マスク (1=データ期間)
    user_bits : output logic<4> , /// ユーザーデータ出力 (4bit)
    data      : output logic<24>, /// PCMデータ出力 (24bit)
    channel   : output logic<3> , /// チャンネル番号 (0-7)
    data_valid: output logic    , /// データ有効
) {
    // フレーム内ビットカウンタ
    var bit_counter: logic<8>;
    // 30bitシフトレジスタ
    var shift_reg: logic<30>;
    // 次シフトレジスタ値
    var shift_next: logic<30>;
    // 出力レジスタ
    var r_user   : logic<4> ;
    var r_data   : logic<24>;
    var r_channel: logic<3> ;
    var r_valid  : logic    ;

    assign user_bits  = r_user;
    assign data       = r_data;
    assign channel    = r_channel;
    assign data_valid = r_valid;

    // 次シフト値（bit_countに応じてLSB側に追加）
    always_comb {
        shift_next = shift_reg;
        case bit_count {
            3'd1   : shift_next = {shift_reg[28:0], bits[0]};
            3'd2   : shift_next = {shift_reg[27:0], bits[0], bits[1]};
            3'd3   : shift_next = {shift_reg[26:0], bits[0], bits[1], bits[2]};
            3'd4   : shift_next = {shift_reg[25:0], bits[0], bits[1], bits[2], bits[3]};
            3'd5   : shift_next = {shift_reg[24:0], bits[0], bits[1], bits[2], bits[3], bits[4]};
            default: {}
        }
    }

    always_ff {
        if_reset {
            bit_counter = 8'd0;
            shift_reg   = 30'd0;
            r_user      = 4'd0;
            r_data      = 24'd0;
            r_channel   = 3'd0;
            r_valid     = 1'b0;
        } else if !sync {
            // 同期期間: Ch7最後のseparatorだけがSYNC長区間に吸い込まれた場合は回収する
            if bit_counter == 8'd244 && shift_reg[24] == 1'b1 && shift_reg[19] == 1'b1 && shift_reg[14] == 1'b1
                && shift_reg[9] == 1'b1 && shift_reg[4] == 1'b1 {
                r_data    = {
                    shift_reg[28:25], shift_reg[23:20], shift_reg[18:15], shift_reg[13:10], shift_reg[8:5],
                    shift_reg[3:0]
                };
                r_channel = 3'd7;
                r_valid   = 1'b1;
            } else {
                r_valid = 1'b0;
            }
            bit_counter = 8'd0;
            shift_reg   = 30'd0;
        } else if valid {
            // ビットをシフトレジスタに追加
            shift_reg   = shift_next;
            let next_count : logic<8> = bit_counter + {5'd0, bit_count};
            bit_counter = next_count;

            // 各位置でデータ抽出
            // フレーム構造: [Sync 10bit][1][User 4bit][1][Ch0 30bit]...[Ch7 30bit]
            // 本実装は同期期間をフレーム境界として扱い、Sync 10bitはカウントしない。
            // したがって、内部カウンタ上のチャンネル終了位置は35 + 30 * channelとなる。
            if bit_counter <: 8'd5 && next_count >: 8'd4 {
                // ユーザーデータ: bits 1-4 (ビット順を反転)
                r_user  = {shift_next[0], shift_next[1], shift_next[2], shift_next[3]};
                r_valid = 1'b0;
            } else {
                // 30bit -> 24bit: 各5bitのnibbleから上位4bitを抽出する
                // LSBは同期用セパレーターのため破棄する
                let pcm_data: logic<24> = {
                    shift_next[29:26], shift_next[24:21], shift_next[19:16], shift_next[14:11], shift_next[9:6],
                    shift_next[4:1]
                };
                r_valid  = 1'b0;
                for i in 0..8 {
                    let range_end: logic<8> = 8'd35 + ((i as 8) * 8'd30);
                    if bit_counter <: range_end && next_count >: (range_end - 8'd1) {
                        r_data    = pcm_data;
                        r_channel = i as 3;
                        r_valid   = 1'b1;
                    }
                }
            }
        } else {
            r_valid = 1'b0;
        }
    }
}

/// 復号済みbit列からuser bitと8channelのPCMを伝送順に抽出できることを検証
#[test(test_adat_frame_parser)]
module test_adat_frame_parser {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var bits      : logic<5> ;
    var bit_count : logic<3> ;
    var valid     : logic    ;
    var sync      : logic    ;
    var user_bits : logic<4> ;
    var data      : logic<24>;
    var channel   : logic<3> ;
    var data_valid: logic    ;

    inst dut: FrameParser (
        clk       : clk       ,
        rst       : rst       ,
        bits      : bits      ,
        bit_count : bit_count ,
        valid     : valid     ,
        sync      : sync      ,
        user_bits : user_bits ,
        data      : data      ,
        channel   : channel   ,
        data_valid: data_valid,
    );

    function push_bits (
        value: input logic<5>,
        count: input logic<3>,
    ) {
        bits      = value;
        bit_count = count;
        valid     = 1'b1;
        clk.next(1);
        valid = 1'b0;
    }

    function push_channel_123456 () {
        push_bits(5'b11000, 3'd5);
        push_bits(5'b10100, 3'd5);
        push_bits(5'b11100, 3'd5);
        push_bits(5'b10010, 3'd5);
        push_bits(5'b11010, 3'd5);
        push_bits(5'b10110, 3'd5);
    }

    initial {
        bits      = 5'd0;
        bit_count = 3'd0;
        valid     = 1'b0;
        sync      = 1'b1;
        rst.assert();

        // User=0xA。先頭のseparatorを含む反転済み入力
        push_bits(5'b10101, 3'd5);
        $assert(user_bits == 4'hA, "user bits mismatch");

        // 同じPCM値を全8チャンネルへ送り、チャンネル抽出と番号を検証する
        for i in 0..8 {
            push_channel_123456();
            $assert(data_valid == 1'b1, "channel data should be valid");
            $assert(channel == (i as 3), "channel index mismatch");
            $assert(data == 24'h123456, "PCM data mismatch");
        }

        $finish();
    }
}
