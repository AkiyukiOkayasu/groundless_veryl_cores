import Adat::AdatFamily;

/// ADATレシーバ トップモジュール
///
/// ADAT光入力から8チャンネル24ビットPCMをデコードする。
/// クロックはADAT信号から自動復元される（外部PLLは不要）。
///
/// # 実機確認状況
/// システムクロック50MHzの構成で実機動作を確認済み。
/// 50MHz以外のシステムクロックでは実機確認していない。
///
/// # 対応サンプルレート
/// - 48kHz: 8チャンネル
/// - 96kHz: 4チャンネル (S/MUX2)
/// - 192kHz: 2チャンネル (S/MUX4)
///
/// # S/MUX時のチャンネルマッピング（利用側で実装）
/// 本モジュールは `channels[8]` を物理スロットとして出力し、S/MUXの論理チャンネル再構成は行わない。
///
/// - S/MUX2 (96kHz / 88.2kHz, 4ch)
///   - Logical CH0 <= `channels[0]` + `channels[1]`
///   - Logical CH1 <= `channels[2]` + `channels[3]`
///   - Logical CH2 <= `channels[4]` + `channels[5]`
///   - Logical CH3 <= `channels[6]` + `channels[7]`
/// - S/MUX4 (192kHz / 176.4kHz, 2ch)
///   - Logical CH0 <= `channels[0]` + `channels[1]` + `channels[2]` + `channels[3]`
///   - Logical CH1 <= `channels[4]` + `channels[5]` + `channels[6]` + `channels[7]`
///
/// 時間順は、各Logical CH内では添字の小さいスロットが先のサンプル。
///
/// # ADAT論理フレーム概要
///
/// 以下はNRZI復号後の論理ビット列であり、物理入力 `adat` の電気的波形ではない。
/// 伝送位置0が内部ベクタ `frame[255]`、伝送位置255が `frame[0]` に対応する。
///
/// ```text
/// 伝送順 →
/// +-----------+----------+-------------+-----+-------------+
/// | SYNC      | User     | CH0         | ... | CH7         |
/// | 10bit+sep | 4bit+sep | 6*(4bit+sep)|     | 6*(4bit+sep)|
/// +-----------+----------+-------------+-----+-------------+
///     11bit       5bit        30bit             30bit
/// ```
///
/// User bitはU3からU0、各channelの24bit PCMはD23からD0のMSB-firstで伝送される。
/// 4bitごとにseparator=1が続き、NRZI信号に同期用の遷移を作る。
/// `channels[8]` は物理スロットであり、S/MUXの論理channel再構成は利用側で行う。
///
/// 伝送位置と内部ベクタ添字を含む詳細図はpackage READMEを参照。
///
/// # 公開出力の概念タイミング
///
/// 次図は縮尺なし。省略区間には複数フレームを含み得る。
/// `channels` の更新時に `valid` がシステムクロック1周期だけHighになる。
/// `locked` は有効なフレームを連続受信した後にHighになる。
/// `frame_clk` はADATフレーム周期を示し、S/MUX時の論理sample rateではない。
///
/// ```wavedrom
/// {
///   signal: [
///     { name: 'frame_clk', wave: '01...0.1...0|1...0' },
///     { name: 'channels',  wave: 'x..3.....4...|5...', data: ['frame N', 'frame N+1', 'frame N+k'] },
///     { name: 'valid',     wave: '0..10....10...|10..' },
///     { name: 'locked',    wave: '0............|1...' }
///   ],
///   head: { text: 'Conceptual output timing (not to scale)' }
/// }
/// ```
///
/// # 使用例
/// ```veryl
/// inst adat: AdatRx (
///     clk        : sys_clk_50mhz,
///     rst        : reset,
///     adat       : toslink_in,
///     channels   : audio,
///     frame_clk  : frame_clk,
///     smux_active: smux_active,
///     valid      : valid,
///     locked     : locked,
/// );
/// ```
///
/// # タイミング
/// - 推奨クロック: 50MHz
/// - ADAT入力: TOSLINK光→電気変換済み信号
pub module AdatRx (
    /// システムクロック (50MHz推奨)
    clk: input clock,
    rst: input reset,
    /// ADAT入力 (光→電気変換済み)
    adat: input logic,
    /// ADATフレーム周期のクロック出力（sample rateではない）
    /// 通常は44.1/48kHz。
    /// warning: S/MUX有効時でも44.1kHz/48kHzが出力されることに注意
    frame_clk: output logic,
    /// UserBit2に基づいて検出されたS/MUX有効状態 (1: enabled, 0: disabled)
    /// warning: S/MUX2とS/MUX4の判別は原理的に不可能なので、あくまでS/MUXが有効or無効のみを示す
    smux_active: output bbool,
    /// 8チャンネルPCMデータ出力（ADAT物理スロット）
    /// warning: S/MUX有効時の論理チャンネル再構成は利用側の実装が必要
    channels: output logic<24> [8],
    /// データ有効信号
    valid: output logic,
    /// 同期ロック状態
    locked: output bbool,
) {
    // 内部信号
    var adat_edge  : logic    ;
    var synced     : logic    ;
    var edge_time  : logic<12>;
    var sync_detect: logic    ;
    var frame_time : logic<12>;

    var bits      : logic<5> ;
    var bit_count : logic<3> ;
    var bits_valid: logic    ;
    var pcm_data  : logic<24>;
    var channel   : logic<3> ;
    var data_valid: logic    ;

    // 非同期ADAT入力の同期化
    inst u_sync: $std::synchronizer_basic (
        i_clk: clk   ,
        i_rst: rst   ,
        i_d  : adat  ,
        o_d  : synced,
    );

    // エッジ検出
    inst u_edge_detector: $std::edge_detector (
        i_clk    : clk      ,
        i_rst    : rst      ,
        i_clear  : 0        ,
        i_data   : synced   ,
        o_edge   : adat_edge,
        o_posedge: _        ,
        o_negedge: _        ,
    );

    // タイミング追跡モジュール
    inst u_timing_tracker: TimingTracker (
        clk        : clk        ,
        rst        : rst        ,
        edge_pulse : adat_edge  ,
        edge_time  : edge_time  ,
        sync_detect: sync_detect,
        frame_time : frame_time ,
    );

    // ビットデコーダ入力を1サイクル遅延
    var edge_delay: logic;
    inst u_delay_edge: $std::delay (
        i_clk: clk       ,
        i_rst: rst       ,
        i_d  : adat_edge ,
        o_d  : edge_delay,
    );

    // ビットデコーダモジュール
    inst u_bit_decoder: BitDecoder (
        clk       : clk        ,
        rst       : rst        ,
        edge_pulse: edge_delay ,
        edge_time : edge_time  ,
        frame_time: frame_time ,
        sync_mask : sync_detect,
        bits      : bits       ,
        bit_count : bit_count  ,
        valid     : bits_valid ,
    );

    // UserBits出力信号
    var user_bits: logic<4>;

    // フレームパーサモジュール
    inst u_frame_parser: FrameParser (
        clk       : clk        ,
        rst       : rst        ,
        bits      : bits       ,
        bit_count : bit_count  ,
        valid     : bits_valid ,
        sync      : sync_detect,
        user_bits : user_bits  ,
        data      : pcm_data   ,
        channel   : channel    ,
        data_valid: data_valid ,
    );

    // 出力インターフェースモジュール
    inst u_output_interface: OutputInterface (
        clk        : clk        ,
        rst        : rst        ,
        frame_time : frame_time ,
        data       : pcm_data   ,
        channel    : channel    ,
        data_valid : data_valid ,
        sync       : sync_detect,
        user_bits  : user_bits  ,
        smux_active: smux_active,
        frame_clk  : frame_clk  ,
        channels   : channels   ,
        valid      : valid      ,
        locked     : locked     ,
    );
}

#[test(test_adat_loopback)]
module test_adat_loopback {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var frame_clk_tx  : logic        ;
    var channels_tx   : logic<24> [8];
    var smux_active_tx: bbool        ;
    var adat_loopback : logic        ;
    var frame_done_tx : logic        ;

    var frame_clk_rx  : logic        ;
    var smux_active_rx: bbool        ;
    var channels_rx   : logic<24> [8];
    var valid_rx      : logic        ;
    var locked_rx     : bbool        ;

    var sent_count      : logic<4>;
    var valid_count     : logic<4>;
    var done_count      : logic<4>;
    var frame_valid_seen: logic   ;
    var frame_done_seen : logic   ;
    var locked_seen     : bbool   ;
    var complete        : logic   ;

    inst tx: AdatTx #(
        CLK_FREQ   : 50_000_000      ,
        ADAT_FAMILY: AdatFamily::F48K,
    ) (
        clk        : clk           ,
        rst        : rst           ,
        frame_clk  : frame_clk_tx  ,
        channels   : channels_tx   ,
        smux_active: smux_active_tx,
        adat       : adat_loopback ,
        frame_done : frame_done_tx ,
    );

    inst rx: AdatRx (
        clk        : clk           ,
        rst        : rst           ,
        adat       : adat_loopback ,
        frame_clk  : frame_clk_rx  ,
        smux_active: smux_active_rx,
        channels   : channels_rx   ,
        valid      : valid_rx      ,
        locked     : locked_rx     ,
    );

    // TX完了イベントで次フレームを開始し、RXの完了フレーム数を記録する。
    always_ff (clk, rst) {
        if_reset {
            frame_clk_tx     = 1'b0;
            smux_active_tx   = 1'b0;
            channels_tx[0]   = 24'h123456;
            channels_tx[1]   = 24'h234567;
            channels_tx[2]   = 24'h345678;
            channels_tx[3]   = 24'h456789;
            channels_tx[4]   = 24'h56789A;
            channels_tx[5]   = 24'h6789AB;
            channels_tx[6]   = 24'h789ABC;
            channels_tx[7]   = 24'h89ABCD;
            sent_count       = 4'd0;
            valid_count      = 4'd0;
            done_count       = 4'd0;
            frame_valid_seen = 1'b0;
            frame_done_seen  = 1'b0;
            locked_seen      = 1'b0;
            complete         = 1'b0;
        } else {
            frame_clk_tx = 1'b0;

            // 最初のフレームを開始し、以降はframe_doneを待って開始する。
            if sent_count == 4'd0 {
                frame_clk_tx = 1'b1;
                sent_count   = 4'd1;
            } else if frame_valid_seen && frame_done_seen && sent_count <: 4'd11 {
                frame_clk_tx     = 1'b1;
                sent_count       = sent_count + 4'd1;
                frame_valid_seen = 1'b0;
                frame_done_seen  = 1'b0;
            }

            if valid_rx && valid_count <: 4'd15 {
                valid_count      = valid_count + 4'd1;
                frame_valid_seen = 1'b1;
            }
            if frame_done_tx && done_count <: 4'd15 {
                done_count      = done_count + 4'd1;
                frame_done_seen = 1'b1;
            }
            if locked_rx {
                locked_seen = 1'b1;
            }
            if done_count == 4'd11 {
                complete = 1'b1;
            }
        }
    }

    initial {
        rst.assert();
        // 11フレームが完了するまでの上限。送信開始自体はframe_done駆動。
        clk.next(16_000);

        $assert(complete == 1'b1, "ADAT loopback did not complete");
        $assert(valid_count == 4'd11, "ADAT loopback valid count mismatch");
        $assert(locked_seen == 1'b1, "ADAT loopback should lock");
        $assert(smux_active_rx == 1'b0, "ADAT loopback S/MUX flag mismatch");
        $assert(channels_rx[0] == 24'h123456, "ADAT loopback CH0 mismatch");
        $assert(channels_rx[7] == 24'h89ABCD, "ADAT loopback CH7 mismatch");
        $finish();
    }
}
