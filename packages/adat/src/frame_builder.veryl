/// ADAT TXフレームビルダー
///
/// 8ch 24bit PCMとUser bitsから256bit ADATフレームを構築する。
/// フレーム構造:
///   - SYNC: 10個の0 + separator (1)  [255:246] => 0000000000, [245] => 1
///   - User: 4bit + separator (1)     [244:241] => user_bits, [240] => 1
///   - CH0-7: 各30bit (6 nibbles)    [239:0]    => encode_24bit(ch0..7)
///
/// 各5bit nibbleは [4bit data][1bit separator=1] で構成される。
module FrameBuilder (
    /// システムクロック
    clk: input clock,
    rst: input reset,
    /// 8チャンネルPCM入力
    channels: input logic<24> [8],
    /// User nibble入力
    user_bits: input logic<4>,
    /// フレーム構築トリガ
    build: input logic,
    /// 構築済みADATフレーム
    frame: output logic<256>,
    /// フレーム有効パルス
    ready: output logic,
) {
    var frame_reg      : logic<256>    ;
    var r_ready        : logic         ;
    var build_frame    : logic<256>    ;
    var channel_encoded: logic<30>  [8];

    assign frame = frame_reg;
    assign ready = r_ready;

    for i in 0..8 :g_encode {
        assign channel_encoded[i] = {
            channels[i][23:20], 1'b1, channels[i][19:16], 1'b1, channels[i][15:12], 1'b1, channels[i][11:8], 1'b1,
            channels[i][7:4], 1'b1, channels[i][3:0], 1'b1
        };
    }

    always_comb {
        build_frame = {
            10'b0000000000, 1'b1, user_bits, 1'b1, channel_encoded[0], channel_encoded[1], channel_encoded[2],
            channel_encoded[3], channel_encoded[4], channel_encoded[5], channel_encoded[6], channel_encoded[7],
        };
    }

    always_ff {
        if_reset {
            frame_reg = 256'd0;
            r_ready   = 1'b0;
        } else if build {
            frame_reg = build_frame;
            r_ready   = 1'b1;
        } else {
            r_ready = 1'b0;
        }
    }
}

#[test(test_adat_frame_builder)]
module test_adat_frame_builder {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var channels : logic<24>  [8];
    var user_bits: logic<4>      ;
    var build    : logic         ;
    var frame    : logic<256>    ;
    var ready    : logic         ;

    inst dut: FrameBuilder ( clk, rst, channels, user_bits, build, frame, ready );

    initial {
        channels[0] = 24'h123456;
        channels[1] = 24'h789ABC;
        channels[2] = 24'hDEF012;
        channels[3] = 24'h345678;
        channels[4] = 24'h9ABCDE;
        channels[5] = 24'hF01234;
        channels[6] = 24'h567890;
        channels[7] = 24'hABCDEF;
        user_bits   = 4'hA;
        build       = 1'b0;
        rst.assert();

        build = 1'b1;
        clk.next(1);
        build = 1'b0;

        $assert(ready == 1'b1, "frame builder should pulse ready");
        $assert(frame[255:246] == 10'b0000000000, "SYNC zero field mismatch");
        $assert(frame[245] == 1'b1, "SYNC separator mismatch");
        $assert(frame[244:241] == 4'hA, "user field mismatch");
        $assert(frame[240] == 1'b1, "user separator mismatch");
        $assert(
            frame[239:210] == {4'h1, 1'b1, 4'h2, 1'b1, 4'h3, 1'b1, 4'h4, 1'b1, 4'h5, 1'b1, 4'h6, 1'b1},
            "CH0 frame encoding mismatch",
        );
        $assert(
            frame[209:180] == {4'h7, 1'b1, 4'h8, 1'b1, 4'h9, 1'b1, 4'hA, 1'b1, 4'hB, 1'b1, 4'hC, 1'b1},
            "CH1 frame encoding mismatch",
        );
        $assert(
            frame[179:150] == {4'hD, 1'b1, 4'hE, 1'b1, 4'hF, 1'b1, 4'h0, 1'b1, 4'h1, 1'b1, 4'h2, 1'b1},
            "CH2 frame encoding mismatch",
        );
        $assert(
            frame[149:120] == {4'h3, 1'b1, 4'h4, 1'b1, 4'h5, 1'b1, 4'h6, 1'b1, 4'h7, 1'b1, 4'h8, 1'b1},
            "CH3 frame encoding mismatch",
        );
        $assert(
            frame[119:90] == {4'h9, 1'b1, 4'hA, 1'b1, 4'hB, 1'b1, 4'hC, 1'b1, 4'hD, 1'b1, 4'hE, 1'b1},
            "CH4 frame encoding mismatch",
        );
        $assert(
            frame[89:60] == {4'hF, 1'b1, 4'h0, 1'b1, 4'h1, 1'b1, 4'h2, 1'b1, 4'h3, 1'b1, 4'h4, 1'b1},
            "CH5 frame encoding mismatch",
        );
        $assert(
            frame[59:30] == {4'h5, 1'b1, 4'h6, 1'b1, 4'h7, 1'b1, 4'h8, 1'b1, 4'h9, 1'b1, 4'h0, 1'b1},
            "CH6 frame encoding mismatch",
        );
        $assert(
            frame[29:0] == {4'hA, 1'b1, 4'hB, 1'b1, 4'hC, 1'b1, 4'hD, 1'b1, 4'hE, 1'b1, 4'hF, 1'b1},
            "CH7 frame encoding mismatch",
        );

        clk.next(1);
        $assert(ready == 1'b0, "ready should be a one-cycle pulse");
        $finish();
    }
}
