/// signed固定小数点formatの契約
///
/// `WIDTH`は符号ビットを含む総ビット幅、`FRACTION_BITS`はbinary pointの右側に置く小数ビット数である。したがって、左側のビット数は`WIDTH - FRACTION_BITS`となる。
///
/// `Raw`はformatに対応するsignedな2の補数ビット表現であり、実数値は`Raw / 2^FRACTION_BITS`として解釈する。`Raw`自体にはformatのscale情報は埋め込まれないため、異なるformat間の変換には`convert`を使う。
///
/// 実装は`WIDTH > 0`かつ`FRACTION_BITS < WIDTH`を満たす必要がある。
///
/// # Examples
///
/// ```veryl
/// let one: Q8_24::Raw = Q8_24::ONE;
/// // `one`の実数値は1.0、ビット表現は0x0100_0000
/// ```
pub proto package SignedFixedPointFormat {
    /// 符号ビットを含む総ビット幅
    ///
    /// `Raw`は` signed logic<WIDTH> `として表現され、signed値の範囲は`[-2^(WIDTH - 1), 2^(WIDTH - 1) - 1]`となる
    const WIDTH: u32;
    /// binary pointの右側にある小数ビット数
    ///
    /// raw値をこのビット数だけ右シフトした位置が整数部に相当する。例えばQ8.24では`WIDTH = 32`、`FRACTION_BITS = 24`である
    const FRACTION_BITS: u32;
    /// このformatのsigned固定小数点ビット表現
    ///
    /// これはformatを表すタグ付きnewtypeではなく、実際のRTLに接続できるsigned bit vectorの別名である。`Q1_31::Raw`と`Q8_24::Raw`のようにformatが異なっても、幅とsignednessが同じならビットレベルでは同じ型になる
    type Raw = signed logic<WIDTH>;

    /// 数値0を表すraw値。常に`'0`である
    const ZERO: Raw;
    /// 表現可能な最小値。raw値では`-2^(WIDTH - 1)`に相当
    const MIN: Raw;
    /// 表現可能な最大値。raw値では`2^(WIDTH - 1) - 1`に相当
    const MAX: Raw;
}

/// 固定小数点演算で共有する丸め・overflow policy
///
/// policyは関数のgeneric parameterとして指定するため、ハードウェア上の実行時selectorは生成されない。丸めは小数ビットを削減する右シフト時に、overflow処理は出力幅を狭める処理時に適用される
pub package Types {
    /// 小数ビット削減時に、どの整数raw値を選ぶかを指定
    ///
    /// `SHIFT`ビット右シフトする場合、丸め対象の実数値は概念上`value / 2^SHIFT`である。`SHIFT == 0`の場合はすべてのmodeで入力を保持する。
    enum RoundingMode {
        /// 切り下げ。負数を含めて負の無限大方向へ丸める
        ///
        /// 例: `1.5 -> 1`、`-1.5 -> -2`
        TOWARD_NEGATIVE,
        /// 切り捨て。ゼロ方向へ丸め、絶対値を増やさない
        ///
        /// 例: `1.5 -> 1`、`-1.5 -> -1`
        TOWARD_ZERO,
        /// 切り上げ。正の無限大方向へ丸める
        ///
        /// 例: `1.5 -> 2`、`-1.5 -> -1`
        TOWARD_POSITIVE,
        /// 最近傍値へ丸め、ちょうど中間の場合は正方向へ丸める
        ///
        /// 例: `1.5 -> 2`、`-1.5 -> -1`
        NEAREST_TIES_TOWARD_POSITIVE,
        /// 最近傍値へ丸め、ちょうど中間の場合は絶対値が大きくなる方向へ丸める
        ///
        /// 例: `1.5 -> 2`、`-1.5 -> -2`
        NEAREST_TIES_AWAY_FROM_ZERO,
        /// 最近傍値への丸め。ちょうど中間の場合は結果の最下位ビットを偶数化
        ///
        /// 例: `2.5 -> 2`、`3.5 -> 4`。負数でも結果の整数raw値を偶数化
        NEAREST_TIES_TO_EVEN,
    }

    /// 出力幅を超えた値の処理方法
    ///
    /// 処理順は小数位置調整、`RoundingMode`による丸め、`OverflowMode`による範囲処理の順。`WRAP`はビット保持、`SATURATE`は数値保持
    enum OverflowMode {
        /// 出力幅の下位ビット保持
        ///
        /// signed 2の補数値としては`2^OUT_WIDTH`を法としたwrapになるため、大きな正数が負数として見えることがある
        WRAP,
        /// 出力formatの`MIN`/`MAX`への制限
        ///
        /// signed出力の範囲は`[-2^(OUT_WIDTH - 1), 2^(OUT_WIDTH - 1) - 1]`であり、範囲外の値をwrapさせず最小値または最大値に置き換える
        SATURATE,
    }
}

/// WIDTHと小数ビット数によるsigned固定小数点formatの定義
///
/// 固定のQ形式presetを増やす代わりに、任意の幅と小数ビット数をformatとして直接使用できる
///
/// # Type Parameters
///
/// - `W`: `WIDTH`として使う総ビット幅
/// - `F`: `FRACTION_BITS`として使う小数ビット数
///
/// # Examples
///
/// ```veryl
/// var input: SignedFixedPointFormatOf::<16, 8>::Raw;
/// input = 16'sd384; // 1.5
/// ```
pub package SignedFixedPointFormatOf::<W: u32, F: u32> for SignedFixedPointFormat {
    const WIDTH        : u32                 = W;
    const FRACTION_BITS: u32                 = F;
    type Raw           = signed logic<WIDTH>;

    const ZERO: Raw = '0;
    const MIN : Raw = {1'b1, 1'b0 repeat WIDTH - 1};
    const MAX : Raw = {1'b0, 1'b1 repeat WIDTH - 1};
}

/// Q2.16形式。27x18乗算器の係数用途
///
/// raw値`x`の実数値は`x / 2^16`である
pub package Q2_16 for SignedFixedPointFormat {
    const WIDTH        : u32                 = 18;
    const FRACTION_BITS: u32                 = 16;
    type Raw           = signed logic<WIDTH>;

    const MAX    : Raw = 18'sb01_11111111_11111111;
    const MIN    : Raw = 18'sb10_00000000_00000000;
    const ONE    : Raw = 18'sb01_00000000_00000000;
    const NEG_ONE: Raw = 18'sb11_00000000_00000000;
    const ZERO   : Raw = 18'sd0;
}

/// Q1.31形式 (-1.0以上、+1.0未満)。デルタシグマ変調器などの用途
///
/// `Q1_31::ONE`は定義されない。+1.0は表現範囲外のため、必要時は`Q1_31::MAX`を利用
pub package Q1_31 for SignedFixedPointFormat {
    const WIDTH        : u32                 = 32;
    const FRACTION_BITS: u32                 = 31;
    type Raw           = signed logic<WIDTH>;

    const MAX : Raw = 32'sh7FFF_FFFF;
    const MIN : Raw = 32'sh8000_0000;
    const ZERO: Raw = 32'sd0;
}

/// Q8.24形式。波形オシレーターの出力などの用途
///
/// raw値`x`の実数値は`x / 2^24`である
pub package Q8_24 for SignedFixedPointFormat {
    const WIDTH        : u32                 = 32;
    const FRACTION_BITS: u32                 = 24;
    type Raw           = signed logic<WIDTH>;

    const MAX    : Raw = 32'sh7FFF_FFFF;
    const MIN    : Raw = 32'sh8000_0000;
    const ONE    : Raw = 32'sh0100_0000;
    const NEG_ONE: Raw = 32'shFF00_0000;
    const ZERO   : Raw = 32'sd0;
}

/// Q8.19形式。36x27乗算器の係数用途
///
/// raw値`x`の実数値は`x / 2^19`である
pub package Q8_19 for SignedFixedPointFormat {
    const WIDTH        : u32                 = 27;
    const FRACTION_BITS: u32                 = 19;
    type Raw           = signed logic<WIDTH>;

    const MAX    : Raw = 27'sb01111111_111_11111111_11111111;
    const MIN    : Raw = 27'sb10000000_000_00000000_00000000;
    const ONE    : Raw = 27'sb00000001_000_00000000_00000000;
    const NEG_ONE: Raw = 27'sb11111111_000_00000000_00000000;
    const ZERO   : Raw = 27'sd0;
}

/// Q3.24形式。36x27乗算器の係数用途
///
/// raw値`x`の実数値は`x / 2^24`である
pub package Q3_24 for SignedFixedPointFormat {
    const WIDTH        : u32                 = 27;
    const FRACTION_BITS: u32                 = 24;
    type Raw           = signed logic<WIDTH>;

    const MAX    : Raw = 27'sb011_11111111_11111111_11111111;
    const MIN    : Raw = 27'sb100_00000000_00000000_00000000;
    const ONE    : Raw = 27'sb001_00000000_00000000_00000000;
    const NEG_ONE: Raw = 27'sb111_00000000_00000000_00000000;
    const ZERO   : Raw = 27'sd0;
}

/// signed固定小数点値を小数ビット数と出力幅ごと変換するproject-scope function
///
/// VerylのSystemVerilog出力制約により、module parameterをgeneric actual argumentへ渡せるのはcomponent namespace外のfunctionに限られるためである
///
/// 処理順は「小数位置調整 → 丸め → overflow処理」の順。小数ビットを増やす場合は左シフト、減らす場合は`MODE`で丸める右シフト。`OVERFLOW == WRAP`では出力幅の下位ビット保持、`SATURATE`ではsigned出力範囲への制限
///
/// # Arguments
///
/// - `value`: 入力formatのsigned raw値
/// - `IN_WIDTH`: 入力の総ビット幅
/// - `IN_FRAC`: 入力の小数ビット数
/// - `OUT_WIDTH`: 出力の総ビット幅
/// - `OUT_FRAC`: 出力の小数ビット数
/// - `MODE`: 小数ビット削減時の丸め方
/// - `OVERFLOW`: 整数部削減時のoverflow処理
///
/// # Returns
///
/// 指定した出力formatのsigned raw値
///
/// # Examples
///
/// ```veryl
/// let result: signed logic<8> = resize::<
///     12,
///     4,
///     8,
///     2,
///     Types::RoundingMode::NEAREST_TIES_TO_EVEN,
///     Types::OverflowMode::SATURATE,
/// >(12'sd24); // 1.5を8-bit Q6.2へ変換し、result == 6
/// ```
pub function resize::<
    IN_WIDTH : u32                ,
    IN_FRAC  : u32                ,
    OUT_WIDTH: u32                ,
    OUT_FRAC : u32                ,
    MODE     : Types::RoundingMode,
    OVERFLOW : Types::OverflowMode,
> (
    value: input signed logic<IN_WIDTH>,
) -> signed logic<OUT_WIDTH> {
    const LEFT_SHIFT : u32 = if IN_FRAC >= OUT_FRAC ? 0 : OUT_FRAC - IN_FRAC;
    const RIGHT_SHIFT: u32 = if OUT_FRAC >= IN_FRAC ? 0 : IN_FRAC - OUT_FRAC;
    const BASE_WIDTH : u32 = IN_WIDTH + LEFT_SHIFT + OUT_WIDTH + 2;
    const WORK_WIDTH : u32 = if BASE_WIDTH >= RIGHT_SHIFT + 2 ? BASE_WIDTH : RIGHT_SHIFT + 2;

    let value_ext          : signed logic<WORK_WIDTH> = $signed({value[msb] repeat WORK_WIDTH - IN_WIDTH, value});
    let half_value         : signed logic<WORK_WIDTH> = if RIGHT_SHIFT == 0 ?
        '0
    :
        $signed({1'b0 repeat WORK_WIDTH - 1, 1'b1} << (RIGHT_SHIFT - 1))
    ;
    let magnitude          : signed logic<WORK_WIDTH> = if value_ext[msb] == 1'b0 ? value_ext : -value_ext;
    let truncated_magnitude: signed logic<WORK_WIDTH> = if RIGHT_SHIFT == 0 ? magnitude : magnitude >>> RIGHT_SHIFT;
    let remainder          : signed logic<WORK_WIDTH> = if RIGHT_SHIFT == 0 ?
        '0
    :
        magnitude - (truncated_magnitude <<< RIGHT_SHIFT)
    ;
    var rounded_magnitude  : signed logic<WORK_WIDTH>;
    var aligned            : signed logic<WORK_WIDTH>;

    rounded_magnitude = truncated_magnitude;

    if RIGHT_SHIFT == 0 {
        aligned = value_ext <<< LEFT_SHIFT;
    } else if MODE == Types::RoundingMode::TOWARD_NEGATIVE {
        aligned = value_ext >>> RIGHT_SHIFT;
    } else if MODE == Types::RoundingMode::TOWARD_ZERO {
        if value_ext[msb] == 1'b0 {
            aligned = truncated_magnitude;
        } else {
            aligned = -truncated_magnitude;
        }
    } else if MODE == Types::RoundingMode::TOWARD_POSITIVE {
        if value_ext[msb] == 1'b0 {
            if remainder != '0 {
                aligned = truncated_magnitude + 1'b1;
            } else {
                aligned = truncated_magnitude;
            }
        } else {
            aligned = -truncated_magnitude;
        }
    } else if MODE == Types::RoundingMode::NEAREST_TIES_TOWARD_POSITIVE {
        aligned = (value_ext + half_value) >>> RIGHT_SHIFT;
    } else if MODE == Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO && value_ext[msb] == 1'b0 {
        aligned = (value_ext + half_value) >>> RIGHT_SHIFT;
    } else if MODE == Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO {
        aligned = -((-value_ext + half_value) >>> RIGHT_SHIFT);
    } else if MODE == Types::RoundingMode::NEAREST_TIES_TO_EVEN {
        if remainder >: half_value || (remainder == half_value && truncated_magnitude[0] == 1'b1) {
            rounded_magnitude = truncated_magnitude + 1'b1;
        }
        if value_ext[msb] == 1'b0 {
            aligned = rounded_magnitude;
        } else {
            aligned = -rounded_magnitude;
        }
    } else {
        aligned = value_ext >>> RIGHT_SHIFT;
    }

    const BODY_WIDTH  : u32 = OUT_WIDTH - 1;
    const EXTEND_WIDTH: u32 = WORK_WIDTH - OUT_WIDTH;

    let max_value: signed logic<WORK_WIDTH> = {1'b0 repeat EXTEND_WIDTH, 1'b0, 1'b1 repeat BODY_WIDTH};
    let min_value: signed logic<WORK_WIDTH> = {1'b1 repeat EXTEND_WIDTH, 1'b1, 1'b0 repeat BODY_WIDTH};
    var result   : signed logic<OUT_WIDTH> ;

    result = $signed(aligned[OUT_WIDTH - 1:0]);
    if OVERFLOW == Types::OverflowMode::SATURATE {
        if aligned >: max_value {
            result = $signed(max_value[OUT_WIDTH - 1:0]);
        } else if aligned <: min_value {
            result = $signed(min_value[OUT_WIDTH - 1:0]);
        }
    }

    return result;
}

/// signed値の算術右シフトと指定modeによる丸め
///
/// `SHIFT == 0`では入力をそのまま返す。`SHIFT > 0`では小数ビットを`SHIFT`個削減し、結果は入力と同じ幅で返す。丸めによる幅超過はこの関数では飽和せず、出力幅の下位ビットが残る
///
/// # Arguments
///
/// - `value`: 算術右シフトするsigned raw値
/// - `WIDTH`: `value`と戻り値のビット幅
/// - `SHIFT`: 右シフトするビット数
/// - `MODE`: 適用する`RoundingMode`
///
/// # Returns
///
/// 丸め後のsigned raw値。小数点位置は`SHIFT`ビット右へ移動したものとして解釈
///
/// # Examples
///
/// ```veryl
/// let result: signed logic<8> = round_shift::<
///     8,
///     2,
///     Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
/// >(7'sd7); // 7 / 4 = 1.75 -> 2
/// ```
pub function round_shift::<WIDTH: u32, SHIFT: u32, MODE: Types::RoundingMode> (
    value: input signed logic<WIDTH>,
) -> signed logic<WIDTH> {
    return resize::<WIDTH, SHIFT, WIDTH, 0, MODE, Types::OverflowMode::WRAP>(value);
}

/// signed値の指定幅への飽和
///
/// 出力範囲は`[-2^(OUT_WIDTH-1), 2^(OUT_WIDTH-1)-1]`とする。入力が範囲内の場合は数値を保持し、範囲外の場合は最小値または最大値を返す
///
/// # Arguments
///
/// - `value`: 飽和対象のsigned値
/// - `IN_WIDTH`: `value`のビット幅
/// - `OUT_WIDTH`: 戻り値のビット幅
///
/// # Returns
///
/// `OUT_WIDTH`で表現可能な範囲に制限されたsigned値
///
/// # Examples
///
/// ```veryl
/// let result: signed logic<8> = saturate::<12, 8>(12'sd200);
/// // 200は8-bit signedの最大値127を超えるため、127
/// ```
pub function saturate::<IN_WIDTH: u32, OUT_WIDTH: u32> (
    value: input signed logic<IN_WIDTH>,
) -> signed logic<OUT_WIDTH> {
    return resize::<IN_WIDTH, 0, OUT_WIDTH, 0, Types::RoundingMode::TOWARD_NEGATIVE, Types::OverflowMode::SATURATE>(
        value,
    );
}

/// signed整数同士の入力幅の合計幅による乗算
///
/// 結果の幅は`A_WIDTH + B_WIDTH`。固定小数点値として解釈する場合、結果の小数ビット数は入力の小数ビット数の合計になる。丸めや出力幅の制限は行わないため、必要に応じて`resize`を続けて呼び出す
///
/// # Arguments
///
/// - `a`: 第一入力のsigned raw値
/// - `b`: 第二入力のsigned raw値
/// - `A_WIDTH`: `a`のビット幅
/// - `B_WIDTH`: `b`のビット幅
///
/// # Returns
///
/// `A_WIDTH + B_WIDTH`ビットのsigned積
///
/// # Examples
///
/// ```veryl
/// let product: signed logic<16> = multiply::<8, 8>(8'sd32, 8'sd16);
/// // product == 512。Q4.4同士なら実数値は2.0 * 1.0 = 2.0
/// ```
pub function multiply::<A_WIDTH: u32, B_WIDTH: u32> (
    a: input signed logic<A_WIDTH>,
    b: input signed logic<B_WIDTH>,
) -> signed logic<A_WIDTH + B_WIDTH> {
    const PRODUCT_WIDTH: u32 = A_WIDTH + B_WIDTH;

    let a_ext: signed logic<PRODUCT_WIDTH> = $signed({a[msb] repeat B_WIDTH, a});
    let b_ext: signed logic<PRODUCT_WIDTH> = $signed({b[msb] repeat A_WIDTH, b});

    return a_ext * b_ext;
}

/// signed乗算結果の指定formatへの変換
///
/// 積の小数ビット数は`A_FRAC + B_FRAC`として扱い、`resize`と同じ順序で小数位置調整、丸め、overflow処理を行う
///
/// # Arguments
///
/// - `a`: 第一入力のsigned raw値
/// - `b`: 第二入力のsigned raw値
/// - `A_WIDTH`/`B_WIDTH`: 入力の総ビット幅
/// - `A_FRAC`/`B_FRAC`: 入力の小数ビット数
/// - `OUT_WIDTH`: 出力の総ビット幅
/// - `OUT_FRAC`: 出力の小数ビット数
/// - `MODE`: 小数ビット削減時の丸め方
/// - `OVERFLOW`: 出力幅超過時の処理
///
/// # Returns
///
/// 指定した出力formatのsigned raw値
///
/// # Examples
///
/// ```veryl
/// let product: signed logic<8> = multiply_resize::<
///     8,
///     4,
///     8,
///     4,
///     8,
///     4,
///     Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
///     Types::OverflowMode::SATURATE,
/// >(8'sd32, 8'sd16); // Q4.4の2.0 * 1.0 -> 2.0、result == 8'sd32
/// ```
pub function multiply_resize::<
    A_WIDTH  : u32                ,
    A_FRAC   : u32                ,
    B_WIDTH  : u32                ,
    B_FRAC   : u32                ,
    OUT_WIDTH: u32                ,
    OUT_FRAC : u32                ,
    MODE     : Types::RoundingMode,
    OVERFLOW : Types::OverflowMode,
> (
    a: input signed logic<A_WIDTH>,
    b: input signed logic<B_WIDTH>,
) -> signed logic<OUT_WIDTH> {
    const PRODUCT_WIDTH: u32 = A_WIDTH + B_WIDTH;
    const PRODUCT_FRAC : u32 = A_FRAC + B_FRAC;

    let product: signed logic<PRODUCT_WIDTH> = multiply::<A_WIDTH, B_WIDTH>(a, b);

    return resize::<PRODUCT_WIDTH, PRODUCT_FRAC, OUT_WIDTH, OUT_FRAC, MODE, OVERFLOW>(product);
}

/// 小数位置調整、丸め、指定overflow処理の順によるformat変換
///
/// 入力と出力のformatが同じ場合は、`MODE`が`TOWARD_ZERO`などであっても値は変化しない。出力formatの整数部が狭くなる場合、`SATURATE`を指定するとwrapを防いで`OUT_FORMAT::MIN`/`MAX`へ制限できる
///
/// # Arguments
///
/// - `value`: `IN_FORMAT`のsigned raw値
/// - `IN_FORMAT`: 入力の幅と小数ビット位置
/// - `OUT_FORMAT`: 出力の幅と小数ビット位置
/// - `MODE`: 小数ビット削減時の丸め方
/// - `OVERFLOW`: 出力幅超過時の処理
///
/// # Returns
///
/// `OUT_FORMAT`へ変換されたsigned raw値
///
/// # Examples
///
/// ```veryl
/// let input: Q1_31::Raw = 32'sh6000_0000; // 0.75
/// let output: Q8_24::Raw = convert::<
///     Q1_31,
///     Q8_24,
///     Types::RoundingMode::NEAREST_TIES_TO_EVEN,
///     Types::OverflowMode::SATURATE,
/// >(input);
/// ```
pub function convert::<
    IN_FORMAT : SignedFixedPointFormat,
    OUT_FORMAT: SignedFixedPointFormat,
    MODE      : Types::RoundingMode   ,
    OVERFLOW  : Types::OverflowMode   ,
> (
    value: input IN_FORMAT::Raw,
) -> OUT_FORMAT::Raw {
    return resize::<
        IN_FORMAT::WIDTH         ,
        IN_FORMAT::FRACTION_BITS ,
        OUT_FORMAT::WIDTH        ,
        OUT_FORMAT::FRACTION_BITS,
        MODE                     ,
        OVERFLOW                 ,
    >(value);
}

/// 丸め付き右シフトの動作を検証
#[test(test_fixed_point_round_shift)]
module test_fixed_point_round_shift {
    inst clk: $tb::clock_gen;

    var test_input     : signed logic<8>;
    var toward_negative: signed logic<8>;
    var toward_zero    : signed logic<8>;
    var toward_positive: signed logic<8>;
    var ties_positive  : signed logic<8>;
    var ties_away      : signed logic<8>;
    var ties_even      : signed logic<8>;
    var shift_zero     : signed logic<8>;

    always_comb {
        toward_negative = round_shift::<8, 1, Types::RoundingMode::TOWARD_NEGATIVE>(test_input);
        toward_zero     = round_shift::<8, 1, Types::RoundingMode::TOWARD_ZERO>(test_input);
        toward_positive = round_shift::<8, 1, Types::RoundingMode::TOWARD_POSITIVE>(test_input);
        ties_positive   = round_shift::<8, 1, Types::RoundingMode::NEAREST_TIES_TOWARD_POSITIVE>(test_input);
        ties_away       = round_shift::<8, 1, Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO>(test_input);
        ties_even       = round_shift::<8, 1, Types::RoundingMode::NEAREST_TIES_TO_EVEN>(test_input);
        shift_zero      = round_shift::<8, 0, Types::RoundingMode::NEAREST_TIES_TO_EVEN>(test_input);
    }

    initial {
        test_input = 7;
        clk.next();
        $assert(toward_negative == 8'sd3, "positive toward-negative mismatch");
        $assert(toward_zero == 8'sd3, "positive toward-zero mismatch");
        $assert(toward_positive == 8'sd4, "positive toward-positive mismatch");
        $assert(ties_positive == 8'sd4, "positive half-up mismatch");
        $assert(ties_away == 8'sd4, "positive half-away mismatch");
        $assert(ties_even == 8'sd4, "positive nearest-even mismatch");

        test_input = -7;
        clk.next();
        $assert(toward_negative == -8'sd4, "negative toward-negative mismatch");
        $assert(toward_zero == -8'sd3, "negative toward-zero mismatch");
        $assert(toward_positive == -8'sd3, "negative toward-positive mismatch");
        $assert(ties_positive == -8'sd3, "negative half-up mismatch");
        $assert(ties_away == -8'sd4, "negative half-away mismatch");
        $assert(ties_even == -8'sd4, "negative nearest-even mismatch");

        test_input = 5;
        clk.next();
        $assert(toward_negative == 8'sd2, "positive non-tie toward-negative mismatch");
        $assert(toward_zero == 8'sd2, "positive non-tie toward-zero mismatch");
        $assert(toward_positive == 8'sd3, "positive non-tie toward-positive mismatch");
        $assert(ties_positive == 8'sd3, "positive non-tie nearest mismatch");
        $assert(ties_away == 8'sd3, "positive non-tie half-away mismatch");
        $assert(ties_even == 8'sd2, "positive nearest-even mismatch");

        test_input = -5;
        clk.next();
        $assert(toward_negative == -8'sd3, "negative non-tie toward-negative mismatch");
        $assert(toward_zero == -8'sd2, "negative non-tie toward-zero mismatch");
        $assert(toward_positive == -8'sd2, "negative non-tie toward-positive mismatch");
        $assert(ties_positive == -8'sd2, "negative non-tie nearest mismatch");
        $assert(ties_away == -8'sd3, "negative non-tie half-away mismatch");
        $assert(ties_even == -8'sd2, "negative nearest-even mismatch");

        test_input = 2;
        clk.next();
        $assert(
            round_shift::<8, 2, Types::RoundingMode::NEAREST_TIES_TO_EVEN>(test_input) == 8'sd0,
            "positive even tie mismatch",
        );
        $assert(
            round_shift::<8, 2, Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO>(test_input) == 8'sd1,
            "positive away tie mismatch",
        );

        test_input = -2;
        clk.next();
        $assert(
            round_shift::<8, 2, Types::RoundingMode::NEAREST_TIES_TO_EVEN>(test_input) == -8'sd0,
            "negative even tie mismatch",
        );
        $assert(
            round_shift::<8, 2, Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO>(test_input) == -8'sd1,
            "negative away tie mismatch",
        );

        test_input = -128;
        clk.next();
        $assert(ties_away == -8'sd64, "signed minimum rounding mismatch");

        test_input = -7;
        clk.next();
        $assert(shift_zero == -8'sd7, "zero shift mismatch");

        $finish();
    }
}

/// signed saturationの動作を検証
#[test(test_fixed_point_saturation)]
module test_fixed_point_saturation {
    inst clk: $tb::clock_gen;

    var test_input     : signed logic<8> ;
    var saturated_small: signed logic<4> ;
    var widened        : signed logic<10>;

    always_comb {
        saturated_small = saturate::<8, 4>(test_input);
        widened         = saturate::<8, 10>(test_input);
    }

    initial {
        test_input = 127;
        clk.next();
        $assert(saturated_small == 4'sd7, "positive saturation mismatch");
        $assert(widened == 10'sd127, "positive widening mismatch");

        test_input = 8;
        clk.next();
        $assert(saturated_small == 4'sd7, "positive boundary saturation mismatch");

        test_input = 7;
        clk.next();
        $assert(saturated_small == 4'sd7, "positive exact maximum mismatch");

        test_input = -9;
        clk.next();
        $assert(saturated_small == -4'sd8, "negative saturation mismatch");

        test_input = -2;
        clk.next();
        $assert(saturated_small == -4'sd2, "negative in-range mismatch");
        $assert(widened == -10'sd2, "negative widening mismatch");

        test_input = -8;
        clk.next();
        $assert(saturated_small == -4'sd8, "negative exact minimum mismatch");

        test_input = -128;
        clk.next();
        $assert(saturated_small == -4'sd8, "negative minimum saturation mismatch");

        $finish();
    }
}

/// signed resizeとmultiply helperの動作を検証
#[test(test_fixed_point_resize_and_mul)]
module test_fixed_point_resize_and_mul {
    inst clk: $tb::clock_gen;

    var resize_input   : signed logic<8> ;
    var resize_down    : signed logic<8> ;
    var resize_up      : signed logic<10>;
    var resize_sat_in  : signed logic<12>;
    var resize_sat     : signed logic<8> ;
    var resize_wrap    : signed logic<8> ;
    var resize_ext     : signed logic<10>;
    var resize_direct  : signed logic<10>;
    var a              : signed logic<8> ;
    var b              : signed logic<8> ;
    var product        : signed logic<16>;
    var product_resized: signed logic<8> ;

    always_comb {
        resize_down     = resize::<
            8                                               ,
            4                                               ,
            8                                               ,
            2                                               ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(resize_input);
        resize_up       = resize::<
            8                                               ,
            2                                               ,
            10                                              ,
            4                                               ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(resize_input);
        resize_sat      = resize::<
            12                                              ,
            4                                               ,
            8                                               ,
            2                                               ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(resize_sat_in);
        resize_wrap     = resize::<
            12                                              ,
            4                                               ,
            8                                               ,
            2                                               ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::WRAP                       ,
        >(resize_sat_in);
        resize_ext      = $signed({resize_input[msb] repeat 2, resize_input});
        resize_direct   = round_shift::<10, 2, Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO>(resize_ext);
        product         = multiply::<8, 8>(a, b);
        product_resized = multiply_resize::<
            8                                               ,
            2                                               ,
            8                                               ,
            2                                               ,
            8                                               ,
            2                                               ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(a, b);
    }

    initial {
        resize_input  = 6;
        resize_sat_in = 0;
        a             = 0;
        b             = 0;
        clk.next();
        $assert(resize_down == 8'sd2, "fractional reduction rounding mismatch");
        $assert(resize_up == 10'sd24, "fractional expansion mismatch");

        resize_input = -6;
        clk.next();
        $assert(resize_ext == -10'sd6, "resize sign extension mismatch");
        $assert(resize_direct == -10'sd2, "direct resize rounding mismatch");
        $assert(resize_down == -8'sd2, "negative fractional reduction rounding mismatch");
        $assert(resize_up == -10'sd24, "negative fractional expansion mismatch");

        resize_sat_in = 2047;
        clk.next();
        $assert(resize_sat == 8'sd127, "resize positive saturation mismatch");
        $assert(resize_wrap == 8'sd0, "resize wrap mismatch");

        resize_sat_in = -2048;
        clk.next();
        $assert(resize_sat == -8'sd128, "resize negative saturation mismatch");
        $assert(resize_wrap == 8'sd0, "resize negative wrap mismatch");

        a = 6;
        b = 2;
        clk.next();
        $assert(product == 16'sd12, "positive product mismatch");
        $assert(product_resized == 8'sd3, "positive product resize mismatch");

        a = -6;
        b = 2;
        clk.next();
        $assert(product == -16'sd12, "negative product mismatch");
        $assert(product_resized == -8'sd3, "negative product resize mismatch");

        a = -6;
        b = -2;
        clk.next();
        $assert(product == 16'sd12, "negative times negative product mismatch");
        $assert(product_resized == 8'sd3, "negative times negative resize mismatch");

        $finish();
    }
}

/// signed generic APIの幅変換、丸め境界、非対称乗算を検証
#[test(test_fixed_point_generic_api)]
module test_fixed_point_generic_api {
    inst clk: $tb::clock_gen;

    var test_input  : signed logic<8> ;
    var half_up     : signed logic<8> ;
    var half_away   : signed logic<8> ;
    var truncation  : signed logic<8> ;
    var nearest_even: signed logic<8> ;
    var expanded    : signed logic<12>;
    var sat_input   : signed logic<12>;
    var sat_output  : signed logic<6> ;
    var wrap_output : signed logic<6> ;
    var wide_input  : signed logic<40>;
    var wide_rounded: signed logic<40>;
    var signed_a    : signed logic<4> ;
    var signed_b    : signed logic<6> ;
    var product     : signed logic<10>;
    var resized     : signed logic<8> ;
    var even_resized: signed logic<8> ;

    always_comb {
        half_up      = resize::<
            8                                                ,
            3                                                ,
            8                                                ,
            1                                                ,
            Types::RoundingMode::NEAREST_TIES_TOWARD_POSITIVE,
            Types::OverflowMode::SATURATE                    ,
        >(test_input);
        half_away    = resize::<
            8                                               ,
            3                                               ,
            8                                               ,
            1                                               ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(test_input);
        truncation   = resize::<8, 3, 8, 1, Types::RoundingMode::TOWARD_NEGATIVE, Types::OverflowMode::SATURATE>(
            test_input,
        );
        nearest_even = resize::<8, 3, 8, 1, Types::RoundingMode::NEAREST_TIES_TO_EVEN, Types::OverflowMode::SATURATE>(
            test_input,
        );
        expanded     = resize::<8, 3, 12, 3, Types::RoundingMode::TOWARD_ZERO, Types::OverflowMode::SATURATE>(
            test_input,
        );
        sat_output   = resize::<
            12                                              ,
            4                                               ,
            6                                               ,
            4                                               ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(sat_input);
        wrap_output  = resize::<
            12                                              ,
            4                                               ,
            6                                               ,
            4                                               ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::WRAP                       ,
        >(sat_input);
        wide_rounded = round_shift::<40, 33, Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO>(wide_input);
        product      = multiply::<4, 6>(signed_a, signed_b);
        resized      = multiply_resize::<
            4                                               ,
            2                                               ,
            6                                               ,
            3                                               ,
            8                                               ,
            2                                               ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(signed_a, signed_b);
        even_resized = multiply_resize::<
            4                                        ,
            2                                        ,
            6                                        ,
            2                                        ,
            8                                        ,
            0                                        ,
            Types::RoundingMode::NEAREST_TIES_TO_EVEN,
            Types::OverflowMode::SATURATE            ,
        >(signed_a, signed_b);
    }

    initial {
        test_input = 6;
        sat_input  = 2047;
        signed_a   = -3;
        signed_b   = 5;
        wide_input = 40'sd1 <<< 32;
        clk.next();
        $display("generic sat=%d wrap=%d", sat_output, wrap_output);
        $assert(truncation == 8'sd1, "resize truncation mismatch");
        $assert(half_up == 8'sd2, "resize half-up tie mismatch");
        $assert(half_away == 8'sd2, "resize half-away tie mismatch");
        $assert(nearest_even == 8'sd2, "resize nearest-even tie mismatch");
        $assert(expanded == 12'sd6, "integer expansion mismatch");
        $assert(sat_output == 6'sd31, "resize upper saturation mismatch");
        $assert(wrap_output == -6'sd1, "resize upper wrap mismatch");
        $assert(product == -10'sd15, "asymmetric signed product mismatch");
        $assert(resized == -8'sd2, "signed multiply-resize mismatch");
        $assert(even_resized == -8'sd1, "signed nearest-even multiply-resize mismatch");
        $assert(wide_rounded == 40'sd1, "widened shift positive tie mismatch");

        test_input = -6;
        sat_input  = -2048;
        wide_input = -(40'sd1 <<< 32);
        clk.next();
        $assert(truncation == -8'sd2, "negative resize truncation mismatch");
        $assert(half_up == -8'sd1, "negative resize half-up tie mismatch");
        $assert(half_away == -8'sd2, "negative resize half-away tie mismatch");
        $assert(nearest_even == -8'sd2, "negative resize nearest-even tie mismatch");
        $assert(expanded == -12'sd6, "negative expansion mismatch");
        $assert(sat_output == -6'sd32, "resize lower saturation mismatch");
        $assert(wrap_output == 6'sd0, "resize lower wrap mismatch");
        $assert(wide_rounded == -40'sd1, "widened shift negative tie mismatch");

        test_input = 3;
        clk.next();
        $assert(half_up == 8'sd1, "positive resize half tie mismatch");
        $assert(half_away == 8'sd1, "positive resize half-away mismatch");

        $finish();
    }
}

/// formatを使った変換APIを検証
#[test(test_fixed_point_convert)]
module test_fixed_point_convert {
    inst clk: $tb::clock_gen;

    var q1_input      : Q1_31::Raw                           ;
    var q8_output     : Q8_24::Raw                           ;
    var generic_input : SignedFixedPointFormatOf::<8, 4>::Raw;
    var generic_output: SignedFixedPointFormatOf::<8, 2>::Raw;

    always_comb {
        q8_output      = convert::<
            Q1_31                                           ,
            Q8_24                                           ,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(q1_input);
        generic_output = convert::<
            SignedFixedPointFormatOf::<8, 4>,
            SignedFixedPointFormatOf::<8, 2>,
            Types::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
            Types::OverflowMode::SATURATE                   ,
        >(generic_input);
    }

    initial {
        q1_input      = 32'sh4000_0000;
        generic_input = 10;
        clk.next();
        $assert(q8_output == 32'sh0080_0000, "typed format conversion mismatch");
        $assert(generic_output == 8'sd3, "generic format conversion mismatch");

        q1_input      = -32'sh4000_0000;
        generic_input = -10;
        clk.next();
        $assert(q8_output == -32'sh0080_0000, "typed negative conversion mismatch");
        $assert(generic_output == -8'sd3, "generic negative conversion mismatch");

        $finish();
    }
}

/// 名前付きQ形式presetによるformat定数とRaw型の提供を検証
#[test(test_fixed_point_presets)]
module test_fixed_point_presets {
    var q1_31: Q1_31::Raw;
    var q2_16: Q2_16::Raw;
    var q8_24: Q8_24::Raw;
    var q8_19: Q8_19::Raw;
    var q3_24: Q3_24::Raw;

    initial {
        q1_31 = Q1_31::MIN;
        q2_16 = Q2_16::ONE;
        q8_24 = Q8_24::NEG_ONE;
        q8_19 = Q8_19::ONE;
        q3_24 = Q3_24::NEG_ONE;

        $assert(Q1_31::WIDTH == 32 && Q1_31::FRACTION_BITS == 31, "Q1.31 format mismatch");
        $assert(q1_31 == Q1_31::MIN, "Q1.31 preset constant mismatch");
        $assert(Q2_16::WIDTH == 18 && Q2_16::FRACTION_BITS == 16, "Q2.16 format mismatch");
        $assert(q2_16 == 18'sh01_0000, "Q2.16 preset constant mismatch");
        $assert(Q8_24::WIDTH == 32 && Q8_24::FRACTION_BITS == 24, "Q8.24 format mismatch");
        $assert(q8_24 == Q8_24::NEG_ONE, "Q8.24 preset constant mismatch");
        $assert(Q8_19::WIDTH == 27 && Q8_19::FRACTION_BITS == 19, "Q8.19 format mismatch");
        $assert(q8_19 == Q8_19::ONE, "Q8.19 preset constant mismatch");
        $assert(Q3_24::WIDTH == 27 && Q3_24::FRACTION_BITS == 24, "Q3.24 format mismatch");
        $assert(q3_24 == Q3_24::NEG_ONE, "Q3.24 preset constant mismatch");
        $assert(Q1_31::MAX == 32'sh7FFF_FFFF, "Q1.31 maximum mismatch");
        $assert(Q8_24::MIN == 32'sh8000_0000, "Q8.24 minimum mismatch");

        $finish();
    }
}
