/// 入力サンプル列を線形補間して、分数比のoutput tickへ変換するASRC
///
/// 入力は`input_valid && input_ready`で受け付け、内部のVeryl STD FIFOへ一時保持する。`ratio`は「output 1回あたりに進む入力サンプル数」をQ(整数3bit).PHASE_WIDTHで表す。
/// 例えば96kHz入力から48kHzを作る場合は`2 << PHASE_WIDTH`、96kHz入力から44.1kHzを作る場合は`96_000 / 44_100 << PHASE_WIDTH`相当を設定する。
/// 起動時はFIFOから2サンプル窓を作るまで`output_ready`がLowになる。
/// `output_tick && output_ready`で出力し、位相進行が入力境界を越えた場合は必要数だけFIFOから窓を補充する。補充中の`output_tick`は受理されない。
///
/// ```wavedrom
/// {
///   signal: [
///     { name: 'input_valid',  wave: '01110.........' },
///     { name: 'input_ready',  wave: '1.............' },
///     { name: 'input_sample', wave: 'x345..........', data: ['S0', 'S1', 'S2'] },
///     { name: 'window',       wave: 'x..6..........', data: ['S0,S1'] },
///     { name: 'output_ready', wave: '0...1..0.1....' },
///     { name: 'output_tick',  wave: '0....10.......' },
///     { name: 'output_valid', wave: '0....10.......' },
///     { name: 'output_sample', wave: 'x....7........', data: ['lerp(S0,S1)'] },
///     { name: 'refill',       wave: '0......1.0....' }
///   ]
/// }
/// ```
pub module LinearAsrc #(
    param SAMPLE_WIDTH: u32 = 32, /// 入出力サンプルの符号付きビット幅
    param PHASE_WIDTH : u32 = 32, /// `ratio`の小数部ビット幅
    param INPUT_DEPTH : u32 = 8 , /// 入力FIFOの深さ
) (
    clk          : input  clock                        , /// システムクロック
    rst          : input  reset                        , /// リセット
    input_valid  : input  logic                        , /// 入力サンプル有効
    input_ready  : output logic                        , /// 入力受理可能
    input_sample : input  signed logic<SAMPLE_WIDTH>   , /// 入力サンプル
    output_tick  : input  logic                        , /// 出力生成要求
    output_ready : output logic                        , /// 出力窓が準備済み
    output_valid : output logic                        , /// 出力サンプル有効
    output_sample: output signed logic<SAMPLE_WIDTH>   , /// 補間後の出力サンプル
    ratio        : input  logic       <PHASE_WIDTH + 2>, /// 出力1回あたりの入力進行量
) {
    const LEVEL_WIDTH: u32 = $clog2(INPUT_DEPTH + 1);

    var fifo_empty      : logic                     ;
    var fifo_almost_full: logic                     ;
    var fifo_full       : logic                     ;
    var fifo_level      : logic       <LEVEL_WIDTH> ;
    var fifo_q          : signed logic<SAMPLE_WIDTH>;
    var fifo_push       : logic                     ;
    var fifo_pop        : logic                     ;
    var sample0         : signed logic<SAMPLE_WIDTH>;
    var sample1         : signed logic<SAMPLE_WIDTH>;
    var window_count    : logic       <2>           ;
    var refill_count    : logic       <3>           ;
    var phase           : logic       <PHASE_WIDTH> ;
    var interpolated    : signed logic<SAMPLE_WIDTH>;

    inst input_fifo: $std::fifo #(
        WIDTH: SAMPLE_WIDTH              ,
        TYPE : signed logic<SAMPLE_WIDTH>,
        DEPTH: INPUT_DEPTH               ,
    ) (
        i_clk        : clk             ,
        i_rst        : rst             ,
        i_clear      : 1'b0            ,
        i_push       : fifo_push       ,
        i_data       : input_sample    ,
        i_pop        : fifo_pop        ,
        o_empty      : fifo_empty      ,
        o_almost_full: fifo_almost_full,
        o_full       : fifo_full       ,
        o_word_count : fifo_level      ,
        o_data       : fifo_q          ,
    );

    inst linear_interpolator: interpolation::LinearInterpolator #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
    ) (
        sample0: sample0     ,
        sample1: sample1     ,
        phase  : phase       ,
        sample : interpolated,
    );

    always_comb {
        input_ready  = !fifo_full;
        fifo_push    = input_valid && input_ready;
        output_ready = window_count == 2'd2 && refill_count == 3'd0;
        fifo_pop     = !fifo_empty && ((window_count <: 2'd2) || (refill_count != 3'd0));
    }

    always_ff {
        if_reset {
            sample0       = 0;
            sample1       = 0;
            window_count  = 0;
            refill_count  = 0;
            phase         = 0;
            output_valid  = 0;
            output_sample = 0;
        } else {
            output_valid = 0;

            if fifo_pop {
                if window_count == 2'd0 {
                    sample0      = fifo_q;
                    window_count = 2'd1;
                } else if window_count == 2'd1 {
                    sample1      = fifo_q;
                    window_count = 2'd2;
                } else if refill_count >: 3'd3 {
                    refill_count -= 1;
                } else if refill_count == 3'd2 {
                    sample0      = fifo_q;
                    refill_count = 3'd1;
                } else {
                    sample1      = fifo_q;
                    refill_count = 3'd0;
                }
            }

            if output_tick && output_ready {
                let phase_sum    : logic<PHASE_WIDTH + 3> = {3'b0, phase} + {1'b0, ratio};
                let advance      : logic<3>               = phase_sum[PHASE_WIDTH + 2:PHASE_WIDTH];
                output_sample = interpolated;
                output_valid  = 1;
                phase         = phase_sum[PHASE_WIDTH - 1:0];

                if advance == 3'd1 {
                    sample0      = sample1;
                    refill_count = 3'd1;
                } else if advance != 3'd0 {
                    refill_count = advance;
                }
            }
        }
    }
}

/// FIFOから入力窓を補充しながら、50MHzの全クロックで線形補間値を出力するASRC
///
/// `phase`と`advance`は`nco::FractionalPhaseAccumulator`から受け取る。
/// `phase`が現在の入力サンプルから次の入力サンプルへ進む割合を表し、`advance`が次のクロックで窓を1サンプル進めることを表す。
/// 起動時に2サンプルの補間窓と、`STARTUP_LEVEL`以上の未消費FIFOが揃うまでは`output_active`をfalseにして0を出力する。burst入力ではこの値を大きくして、出力開始前にFIFOへ余裕を持たせる。
/// 動作開始後は、入力不足を`underflow`へstickyに記録しながら出力を止めない。
///
/// ```wavedrom
/// {
///   signal: [
///     { name: 'input_valid',   wave: '0111110........' },
///     { name: 'input_ready',   wave: '1..............' },
///     { name: 'input_level',   wave: '23456........0.', data: ['0', '1', '2', 'startup', 'buffered', 'empty'] },
///     { name: 'window primed', wave: '0....1.........' },
///     { name: 'output_active', wave: '0....1.........' },
///     { name: 'phase',         wave: 'x....345.......', data: ['P0', 'P1', 'P2'] },
///     { name: 'advance',       wave: '0......10..10..' },
///     { name: 'underflow',     wave: '0..........1...' }
///   ],
///   head: { text: 'Startup, continuous output, and sticky underflow' }
/// }
/// ```
pub module ContinuousLinearAsrc #(
    param SAMPLE_WIDTH : u32 = 32, /// 入出力サンプルの符号付きビット幅
    param PHASE_WIDTH  : u32 = 32, /// 位相入力のビット幅
    param INPUT_DEPTH  : u32 = 8 , /// 入力FIFOの深さ
    param STARTUP_LEVEL: u32 = 1 , /// 出力開始に必要な未消費FIFOワード数
) (
    clk          : input  clock                                , /// システムクロック
    rst          : input  reset                                , /// リセット
    input_valid  : input  bbool                                , /// 入力サンプル有効
    input_ready  : output bbool                                , /// 入力受理可能
    input_sample : input  signed logic<SAMPLE_WIDTH>           , /// 入力サンプル
    input_level  : output logic       <$clog2(INPUT_DEPTH + 1)>, /// 入力FIFOのワード数
    phase        : input  logic       <PHASE_WIDTH>            , /// 補間位相
    advance      : input  bbool                                , /// 次の入力サンプルへ窓を進める要求
    output_active: output bbool                                , /// 連続出力が有効
    output_sample: output signed logic<SAMPLE_WIDTH>           , /// 補間後の出力サンプル
    underflow    : output bbool                                , /// 入力不足のstickyフラグ
) {
    const LEVEL_WIDTH: u32 = $clog2(INPUT_DEPTH + 1);

    var fifo_empty      : logic                     ;
    var fifo_almost_full: logic                     ;
    var fifo_full       : logic                     ;
    var fifo_level      : logic       <LEVEL_WIDTH> ;
    var fifo_q          : signed logic<SAMPLE_WIDTH>;
    var fifo_push       : logic                     ;
    var fifo_pop        : logic                     ;
    var sample0         : signed logic<SAMPLE_WIDTH>;
    var sample1         : signed logic<SAMPLE_WIDTH>;
    var window_count    : logic       <2>           ;
    var primed          : bbool                     ;
    var interpolated    : signed logic<SAMPLE_WIDTH>;

    inst input_fifo: $std::fifo #(
        WIDTH: SAMPLE_WIDTH              ,
        TYPE : signed logic<SAMPLE_WIDTH>,
        DEPTH: INPUT_DEPTH               ,
    ) (
        i_clk        : clk             ,
        i_rst        : rst             ,
        i_clear      : 1'b0            ,
        i_push       : fifo_push       ,
        i_data       : input_sample    ,
        i_pop        : fifo_pop        ,
        o_empty      : fifo_empty      ,
        o_almost_full: fifo_almost_full,
        o_full       : fifo_full       ,
        o_word_count : fifo_level      ,
        o_data       : fifo_q          ,
    );

    inst linear_interpolator: interpolation::LinearInterpolator #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
    ) (
        sample0: sample0     ,
        sample1: sample1     ,
        phase  : phase       ,
        sample : interpolated,
    );

    always_comb {
        input_ready   = false;
        output_active = false;
        output_sample = 0;
        input_level   = fifo_level;

        if !fifo_full {
            input_ready = true;
        }
        if primed {
            output_active = true;
            output_sample = interpolated;
        }

        fifo_push = input_valid && input_ready;
        fifo_pop  = !fifo_empty && (window_count <: 2'd2 || (primed && advance));
    }

    always_ff {
        if_reset {
            sample0      = 0;
            sample1      = 0;
            window_count = 0;
            primed       = false;
            underflow    = false;
        } else {
            if fifo_pop {
                if window_count == 2'd0 {
                    sample0      = fifo_q;
                    window_count = 2'd1;
                } else if window_count == 2'd1 {
                    sample1      = fifo_q;
                    window_count = 2'd2;
                } else {
                    sample0 = sample1;
                    sample1 = fifo_q;
                }
            }

            if !primed && window_count == 2'd2 && fifo_level >= STARTUP_LEVEL {
                primed = true;
            }
            if primed && advance && fifo_empty {
                underflow = true;
            }
        }
    }
}

/// 線形補間と分数比sample列変換を検証
#[test(test_linear_asrc)]
module test_linear_asrc {
    const SAMPLE_WIDTH: u32 = 16;
    const PHASE_WIDTH : u32 = 4;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var sample0      : signed logic<SAMPLE_WIDTH>   ;
    var sample1      : signed logic<SAMPLE_WIDTH>   ;
    var phase        : logic       <PHASE_WIDTH>    ;
    var interpolated : signed logic<SAMPLE_WIDTH>   ;
    var input_valid  : logic                        ;
    var input_ready  : logic                        ;
    var input_sample : signed logic<SAMPLE_WIDTH>   ;
    var output_tick  : logic                        ;
    var output_ready : logic                        ;
    var output_valid : logic                        ;
    var output_sample: signed logic<SAMPLE_WIDTH>   ;
    var ratio        : logic       <PHASE_WIDTH + 2>;

    inst linear_interpolator: interpolation::LinearInterpolator #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
    ) (
        sample0              ,
        sample1              ,
        phase                ,
        sample : interpolated,
    );

    inst asrc: LinearAsrc #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
        INPUT_DEPTH : 4           ,
    ) (
        clk            ,
        rst            ,
        input_valid    ,
        input_ready    ,
        input_sample   ,
        output_tick    ,
        output_ready   ,
        output_valid   ,
        output_sample  ,
        ratio          ,
    );

    initial {
        sample0      = 16'sd1000;
        sample1      = 16'sd3000;
        phase        = 4'd0;
        input_valid  = 0;
        input_sample = 0;
        output_tick  = 0;
        ratio        = 0;
        clk.next    (1);
        $assert     (interpolated == 16'sd1000, "linear interpolation phase zero mismatch");
        phase        = 4'd8;
        clk.next    (1);
        $assert     (interpolated == 16'sd2000, "linear interpolation midpoint mismatch");

        input_sample = 16'sd100;
        input_valid  = 1;
        ratio        = 6'd24;
        rst.assert  ();
        clk.next    (1);
        input_sample = 16'sd200;
        clk.next    (1);
        input_sample = 16'sd300;
        clk.next    (1);
        input_valid  = 0;
        clk.next    (3);
        $assert     (output_ready, "ASRC must become ready after two input samples");

        output_tick = 1;
        clk.next   (1);
        output_tick = 0;
        $assert    (output_valid && output_sample == 16'sd100, "ASRC first sample mismatch");
        clk.next   (1);
        $assert    (output_ready, "ASRC must refill one sample after a 1.5x advance");

        output_tick = 1;
        clk.next   (1);
        output_tick = 0;
        $assert    (output_valid && output_sample == 16'sd250, "ASRC interpolated sample mismatch");
        $finish    ();
    }
}

/// 連続出力ASRCと分数位相アキュムレータの最小統合を検証
#[test(test_continuous_linear_asrc)]
module test_continuous_linear_asrc {
    const SAMPLE_WIDTH: u32 = 16;
    const PHASE_WIDTH : u32 = 4;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var input_valid  : bbool           ;
    var input_ready  : bbool           ;
    var input_sample : signed logic<16>;
    var input_level  : logic       <4> ;
    var phase        : logic       <4> ;
    var advance      : bbool           ;
    var output_active: bbool           ;
    var output_sample: signed logic<16>;
    var underflow    : bbool           ;
    var phase_enable : bbool           ;
    var phase_inc    : logic       <4> ;

    inst phase_accumulator: nco::FractionalPhaseAccumulator #(
        WIDTH: PHASE_WIDTH,
    ) (
        clk                          ,
        rst                          ,
        enable         : phase_enable,
        phase_increment: phase_inc   ,
        phase                        ,
        advance                      ,
    );

    inst asrc: ContinuousLinearAsrc #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
        INPUT_DEPTH : 8           ,
    ) (
        clk            ,
        rst            ,
        input_valid    ,
        input_ready    ,
        input_sample   ,
        input_level    ,
        phase          ,
        advance        ,
        output_active  ,
        output_sample  ,
        underflow      ,
    );

    initial {
        input_valid  = false;
        input_sample = 0;
        phase_enable = true;
        phase_inc    = 4'd4;
        rst.assert  ();

        // 0, 100, 200, 300を連続投入し、窓を初期化する
        input_valid  = true;
        input_sample = 16'sd0;
        clk.next    (1);
        input_sample = 16'sd100;
        clk.next    (1);
        input_sample = 16'sd200;
        clk.next    (1);
        input_sample = 16'sd300;
        clk.next    (1);
        input_valid  = false;

        $assert(output_active, "continuous ASRC must become active after priming");
        $assert(output_sample == 16'sd0, "continuous ASRC must hold the initial window while priming");
        $assert(!underflow, "continuous ASRC must not underflow with buffered input");
        $assert(input_level == 4'd2, "priming sample and unused burst sample must remain in the FIFO");

        clk.next(1);
        $assert (output_sample == 16'sd25, "continuous ASRC quarter phase mismatch");
        clk.next(1);
        $assert (output_sample == 16'sd50, "continuous ASRC midpoint phase mismatch");
        clk.next(1);
        $assert (output_sample == 16'sd75, "continuous ASRC three-quarter phase mismatch");
        clk.next(1);
        $assert (output_sample == 16'sd100, "continuous ASRC second window mismatch");
        $assert (!underflow, "continuous ASRC must keep the buffered stream running");
        $finish ();
    }
}
