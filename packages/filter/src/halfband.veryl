/// 2倍補間用の固定係数halfband FIR。
///
/// `COEFFICIENT_SET`は1段目（103tap）または2段目（39tap）を選ぶ。
/// 係数はQ2.(COEFFICIENT_WIDTH - 2)、入力と出力はQ1.(SAMPLE_WIDTH - 1)
/// とする。halfbandの対称性を使い、非ゼロ係数の対称tapを1回の積和へ
/// まとめる。もう一方のpolyphaseは中心係数が1なので、遅延入力をそのまま出力する。
pub module HalfbandInterpolator2x #(
    param SAMPLE_WIDTH     : u32 = 32                                  ,
    param COEFFICIENT_WIDTH: u32 = 18                                  ,
    param ACCUMULATOR_WIDTH: u32 = SAMPLE_WIDTH + COEFFICIENT_WIDTH + 8,
    param COEFFICIENT_SET  : u32 = 1                                   ,
) (
    clk          : input  clock                     ,
    rst          : input  reset                     ,
    input_valid  : input  bbool                     ,
    input_ready  : output bbool                     ,
    input_sample : input  signed logic<SAMPLE_WIDTH>,
    output_valid : output bbool                     ,
    output_ready : input  bbool                     ,
    output_sample: output signed logic<SAMPLE_WIDTH>,
) {
    const PAIR_COUNT    : u32 = if COEFFICIENT_SET == 1 ? 26 : 10;
    const HISTORY_LENGTH: u32 = PAIR_COUNT * 2;
    const DELAY         : u32 = if COEFFICIENT_SET == 1 ? 25 : 9;
    const INDEX_WIDTH   : u32 = $clog2(PAIR_COUNT);
    const PRODUCT_WIDTH : u32 = SAMPLE_WIDTH + 1 + COEFFICIENT_WIDTH;
    const INPUT_FRAC    : u32 = SAMPLE_WIDTH + COEFFICIENT_WIDTH - 3;
    const OUTPUT_FRAC   : u32 = SAMPLE_WIDTH - 1;

    const STATE_IDLE       : logic<2> = 2'd0;
    const STATE_MAC        : logic<2> = 2'd1;
    const STATE_OUTPUT_EVEN: logic<2> = 2'd2;
    const STATE_OUTPUT_ODD : logic<2> = 2'd3;

    var state           : logic       <2>                                 ;
    var pair_index      : logic       <INDEX_WIDTH>                       ;
    var history         : signed logic<SAMPLE_WIDTH>      [HISTORY_LENGTH];
    var history_next    : signed logic<SAMPLE_WIDTH>      [HISTORY_LENGTH];
    var accumulator     : signed logic<ACCUMULATOR_WIDTH>                 ;
    var even_sample     : signed logic<SAMPLE_WIDTH>                      ;
    var pair_sum        : signed logic<SAMPLE_WIDTH + 1>                  ;
    var product         : signed logic<PRODUCT_WIDTH>                     ;
    var product_ext     : signed logic<ACCUMULATOR_WIDTH>                 ;
    var next_accumulator: signed logic<ACCUMULATOR_WIDTH>                 ;

    function coefficient (
        index: input logic<INDEX_WIDTH>,
    ) -> signed logic<COEFFICIENT_WIDTH> {
        if COEFFICIENT_SET == 1 {
            return case index {
                0      : -18'sd2,
                1      : 18'sd6,
                2      : -18'sd12,
                3      : 18'sd22,
                4      : -18'sd36,
                5      : 18'sd55,
                6      : -18'sd82,
                7      : 18'sd118,
                8      : -18'sd165,
                9      : 18'sd225,
                10     : -18'sd301,
                11     : 18'sd395,
                12     : -18'sd511,
                13     : 18'sd653,
                14     : -18'sd827,
                15     : 18'sd1038,
                16     : -18'sd1296,
                17     : 18'sd1614,
                18     : -18'sd2011,
                19     : 18'sd2519,
                20     : -18'sd3191,
                21     : 18'sd4132,
                22     : -18'sd5560,
                23     : 18'sd8054,
                24     : -18'sd13732,
                25     : 18'sd41663,
                default: 18'sd0,
            };
        } else {
            return case index {
                0      : -18'sd6,
                1      : 18'sd49,
                2      : -18'sd173,
                3      : 18'sd451,
                4      : -18'sd988,
                5      : 18'sd1939,
                6      : -18'sd3561,
                7      : 18'sd6444,
                8      : -18'sd12684,
                9      : 18'sd41298,
                default: 18'sd0,
            };
        }
    }

    always_comb {
        input_ready   = false;
        output_valid  = false;
        output_sample = 0;

        if state == STATE_IDLE {
            input_ready = true;
        }
        if state == STATE_OUTPUT_EVEN || state == STATE_OUTPUT_ODD {
            output_valid = true;
        }
        if state == STATE_OUTPUT_EVEN {
            output_sample = even_sample;
        } else if state == STATE_OUTPUT_ODD {
            output_sample = history[DELAY];
        }

        for i in 0..HISTORY_LENGTH {
            history_next[i] = history[i];
        }
        if input_valid && input_ready {
            history_next[0] = input_sample;
            for i in 1..HISTORY_LENGTH {
                history_next[i] = history[i - 1];
            }
        }

        let left            : signed logic<SAMPLE_WIDTH + 1> = $signed({history[pair_index][msb], history[pair_index]});
        let right           : signed logic<SAMPLE_WIDTH + 1> = $signed(
            {history[HISTORY_LENGTH - 1 - pair_index][msb], history[HISTORY_LENGTH - 1 - pair_index],},
        );
        pair_sum         = left + right;
        product          = pair_sum * coefficient(pair_index);
        product_ext      = product as ACCUMULATOR_WIDTH;
        next_accumulator = accumulator + product_ext;
    }

    always_ff {
        if_reset {
            state       = STATE_IDLE;
            pair_index  = 0;
            accumulator = 0;
            even_sample = 0;
            for i in 0..HISTORY_LENGTH {
                history[i] = 0;
            }
        } else {
            if state == STATE_IDLE {
                if input_valid && input_ready {
                    for i in 0..HISTORY_LENGTH {
                        history[i] = history_next[i];
                    }
                    pair_index  = 0;
                    accumulator = 0;
                    state       = STATE_MAC;
                }
            } else if state == STATE_MAC {
                if pair_index == PAIR_COUNT - 1 {
                    even_sample = fixedpoint::resize::<
                        ACCUMULATOR_WIDTH                                                ,
                        INPUT_FRAC                                                       ,
                        SAMPLE_WIDTH                                                     ,
                        OUTPUT_FRAC                                                      ,
                        fixedpoint::FixedPoint::RoundingMode::NEAREST_TIES_AWAY_FROM_ZERO,
                        fixedpoint::FixedPoint::OverflowMode::SATURATE                   ,
                    >(next_accumulator);
                    accumulator = next_accumulator;
                    state       = STATE_OUTPUT_EVEN;
                } else {
                    accumulator =  next_accumulator;
                    pair_index  += 1;
                }
            } else if state == STATE_OUTPUT_EVEN {
                if output_ready {
                    state = STATE_OUTPUT_ODD;
                }
            } else if state == STATE_OUTPUT_ODD {
                if output_ready {
                    state = STATE_IDLE;
                }
            }
        }
    }
}

/// 2倍補間器のburst、出力保持、入力受理を検証する。
#[test(test_halfband_interpolator2x_stream)]
module test_halfband_interpolator2x_stream {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var input_valid  : bbool           ;
    var input_ready  : bbool           ;
    var input_sample : signed logic<16>;
    var output_valid : bbool           ;
    var output_ready : bbool           ;
    var output_sample: signed logic<16>;

    inst dut: HalfbandInterpolator2x #(
        SAMPLE_WIDTH   : 16,
        COEFFICIENT_SET: 2 ,
    ) (
        clk            ,
        rst            ,
        input_valid    ,
        input_ready    ,
        input_sample   ,
        output_valid   ,
        output_ready   ,
        output_sample  ,
    );

    initial {
        input_valid  = false;
        input_sample = 16'sd1000;
        output_ready = false;
        rst.assert();

        $assert(input_ready, "halfband must accept input while idle");
        input_valid = true;
        clk.next(1);
        input_valid = false;

        // 10個の対称係数を1クロックずつ積算する。
        clk.next(10);
        $assert(output_valid, "halfband must emit the first output");
        $assert(output_sample == 16'sd0, "zero-padded history must produce a zero even output");
        let held_sample: signed logic<16> = output_sample;
        clk.next(2);
        $assert(output_valid && output_sample == held_sample, "output must hold while stalled");

        output_ready = true;
        clk.next(1);
        $assert(output_valid, "halfband must emit the second output consecutively");
        $assert(output_sample == 16'sd0, "zero-padded history must produce a zero odd output");
        clk.next(1);
        $assert(!output_valid && input_ready, "halfband must return idle after the burst");

        // 窓が入力値で満たされた後は、2つのpolyphase出力ともDCゲイン1になる。
        for sample_index in 0..19 {
            input_valid  = true;
            input_sample = 16'sd1000;
            clk.next(1);
            input_valid = false;
            clk.next(10);
            $assert(output_valid, "halfband must emit each DC burst");
            if sample_index == 18 {
                $assert(output_sample == 16'sd1000, "DC input must preserve the even output");
            }
            clk.next(1);
            $assert(output_valid, "halfband must emit the odd phase");
            if sample_index == 18 {
                $assert(output_sample == 16'sd1000, "DC input must preserve the odd output");
            }
            clk.next(1);
        }
        $finish();
    }
}
