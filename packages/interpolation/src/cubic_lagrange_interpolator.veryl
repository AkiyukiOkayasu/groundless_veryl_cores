/// 4点3次Lagrange補間器。
///
/// `sample_m1`、`sample0`、`sample1`、`sample2`の4点を3次Horner形式で
/// 評価する。係数はQ2.16へ量子化し、組み合わせlatencyは0です。
pub module CubicLagrangeInterpolator #(
    param SAMPLE_WIDTH : u32                             = 32                                                   ,
    param PHASE_WIDTH  : u32                             = 32                                                   ,
    param ROUNDING_MODE: fixedpoint::Types::RoundingMode = fixedpoint::Types::RoundingMode::NEAREST_TIES_TO_EVEN,
    param OVERFLOW_MODE: fixedpoint::Types::OverflowMode = fixedpoint::Types::OverflowMode::SATURATE            ,
    const NUM_WIDTH    : u32                             = SAMPLE_WIDTH + 2 + 18 + PHASE_WIDTH * 3 + 3          ,
    const OUTPUT_SHIFT : u32                             = 16 + PHASE_WIDTH * 3                                 ,
) (
    sample_m1: input  signed logic<SAMPLE_WIDTH>,
    sample0  : input  signed logic<SAMPLE_WIDTH>,
    sample1  : input  signed logic<SAMPLE_WIDTH>,
    sample2  : input  signed logic<SAMPLE_WIDTH>,
    phase    : input  logic       <PHASE_WIDTH> ,
    sample   : output signed logic<SAMPLE_WIDTH>,
) {
    const COEFF_WIDTH   : u32 = 18;
    const COEFF_FRACTION: u32 = 16;
    const SAMPLE_EXT    : u32 = SAMPLE_WIDTH + 2;
    const PRODUCT_WIDTH : u32 = SAMPLE_EXT + COEFF_WIDTH;
    const H2_WIDTH      : u32 = PRODUCT_WIDTH + PHASE_WIDTH + 1;
    const H1_WIDTH      : u32 = PRODUCT_WIDTH + PHASE_WIDTH * 2 + 2;
    always_comb {
        let sample_m1_ext: signed logic<PRODUCT_WIDTH>   = sample_m1;
        let sample0_ext  : signed logic<PRODUCT_WIDTH>   = sample0;
        let sample1_ext  : signed logic<PRODUCT_WIDTH>   = sample1;
        let sample2_ext  : signed logic<PRODUCT_WIDTH>   = sample2;
        let mu           : signed logic<PHASE_WIDTH + 1> = $signed({1'b0, phase});

        // c1 = -sample_m1/3 - sample0/2 + sample1 - sample2/6
        let c1_raw: signed logic<PRODUCT_WIDTH> = sample_m1_ext * -18'sd21845 + sample0_ext * -18'sd32768 + sample1_ext
            * 18'sd65536 + sample2_ext * -18'sd10923;
        // c2 = sample_m1/2 - sample0 + sample1/2
        let c2_raw: signed logic<PRODUCT_WIDTH> = sample_m1_ext * 18'sd32768 + sample0_ext * -18'sd65536 + sample1_ext
            * 18'sd32768;
        // c3 = -sample_m1/6 + sample0/2 - sample1/2 + sample2/6
        let c3_raw: signed logic<PRODUCT_WIDTH> = sample_m1_ext * -18'sd10923 + sample0_ext * 18'sd32768 + sample1_ext
            * -18'sd32768 + sample2_ext * 18'sd10923;

        let c2_wide     : signed logic<H2_WIDTH>  = c2_raw;
        let c3_mu       : signed logic<H2_WIDTH>  = c3_raw * mu;
        let h2          : signed logic<H2_WIDTH>  = (c2_wide <<< PHASE_WIDTH) + c3_mu;
        let c1_wide     : signed logic<H1_WIDTH>  = c1_raw;
        let h2_mu       : signed logic<H1_WIDTH>  = h2 * mu;
        let h1          : signed logic<H1_WIDTH>  = (c1_wide <<< (PHASE_WIDTH * 2)) + h2_mu;
        let h1_mu       : signed logic<NUM_WIDTH> = h1 * mu;
        let sample0_wide: signed logic<NUM_WIDTH> = sample0;
        let c0          : signed logic<NUM_WIDTH> = sample0_wide <<< (COEFF_FRACTION + PHASE_WIDTH * 3);
        let numerator   : signed logic<NUM_WIDTH> = c0 + h1_mu;
        sample       = fixedpoint::resize::<NUM_WIDTH, OUTPUT_SHIFT, SAMPLE_WIDTH, 0, ROUNDING_MODE, OVERFLOW_MODE>(
            numerator,
        );
    }
}

/// 3次Lagrange補間の定数列、ramp、端点を検証
#[test(test_cubic_lagrange_interpolator)]
module test_cubic_lagrange_interpolator {
    var sample_m1: signed logic<16>;
    var sample0  : signed logic<16>;
    var sample1  : signed logic<16>;
    var sample2  : signed logic<16>;
    var phase    : logic       <4> ;
    var sample   : signed logic<16>;

    inst dut: CubicLagrangeInterpolator #(
        SAMPLE_WIDTH: 16,
        PHASE_WIDTH : 4 ,
    ) (
        sample_m1  ,
        sample0    ,
        sample1    ,
        sample2    ,
        phase      ,
        sample     ,
    );

    initial {
        sample_m1 = 16'sd100;
        sample0   = 16'sd100;
        sample1   = 16'sd100;
        sample2   = 16'sd100;
        phase     = 4'd8;
        $assert(sample == 16'sd100, "cubic constant mismatch");
        sample_m1 = 16'sd0;
        sample0   = 16'sd100;
        sample1   = 16'sd200;
        sample2   = 16'sd300;
        phase     = 4'd0;
        $assert(sample == 16'sd100, "cubic phase zero mismatch");
        phase = 4'd8;
        $assert(sample == 16'sd150, "cubic midpoint mismatch");
        $finish();
    }
}

/// 4点窓のovershootに対するsaturationとwrapを検証
#[test(test_cubic_lagrange_interpolator_overflow)]
module test_cubic_lagrange_interpolator_overflow {
    inst clk: $tb::clock_gen;

    var sample_m1: signed logic<4>;
    var sample0  : signed logic<4>;
    var sample1  : signed logic<4>;
    var sample2  : signed logic<4>;
    var phase    : logic       <3>;
    var saturated: signed logic<4>;
    var wrapped  : signed logic<4>;

    inst dut_saturated: CubicLagrangeInterpolator #(
        SAMPLE_WIDTH : 4                                        ,
        PHASE_WIDTH  : 3                                        ,
        OVERFLOW_MODE: fixedpoint::Types::OverflowMode::SATURATE,
    ) (
        sample_m1           ,
        sample0             ,
        sample1             ,
        sample2             ,
        phase               ,
        sample   : saturated,
    );
    inst dut_wrapped: CubicLagrangeInterpolator #(
        SAMPLE_WIDTH : 4                                    ,
        PHASE_WIDTH  : 3                                    ,
        OVERFLOW_MODE: fixedpoint::Types::OverflowMode::WRAP,
    ) (
        sample_m1         ,
        sample0           ,
        sample1           ,
        sample2           ,
        phase             ,
        sample   : wrapped,
    );

    initial {
        sample_m1 = -8;
        sample0   = 4;
        sample1   = 7;
        sample2   = -8;
        phase     = 3'd5;
        clk.next();
        $assert(saturated == 4'sd7, "positive cubic saturation mismatch");
        $assert(wrapped == -4'sd8, "positive cubic wrap mismatch");

        sample_m1 = -8;
        sample0   = -8;
        sample1   = -8;
        sample2   = 0;
        phase     = 3'd4;
        clk.next();
        $assert(saturated == -4'sd8, "negative cubic saturation mismatch");
        $assert(wrapped == 4'sd7, "negative cubic wrap mismatch");
        $finish();
    }
}
