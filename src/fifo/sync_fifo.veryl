/// Veryl STD FIFOをプロジェクト共通のbare portへ包む。
///
/// `level`はSTD FIFOの`o_word_count`をそのまま公開する。IEC60958の
/// subframe queueだけでなく、ASRCのsample queueにも利用できる。
pub module SyncFifo #(
    param WIDTH: u32  = 8           ,
    param TYPE : type = logic<WIDTH>,
    param DEPTH: u32  = 8           ,
) (
    clk        : input  clock                   ,
    rst        : input  reset                   ,
    clear      : input  logic                   ,
    push       : input  logic                   ,
    data       : input  TYPE                    ,
    pop        : input  logic                   ,
    empty      : output logic                   ,
    almost_full: output logic                   ,
    full       : output logic                   ,
    level      : output logic<$clog2(DEPTH + 1)>,
    q          : output TYPE                    ,
) {
    inst fifo: $std::fifo #(
        WIDTH: WIDTH,
        TYPE : TYPE ,
        DEPTH: DEPTH,
    ) (
        i_clk        : clk        ,
        i_rst        : rst        ,
        i_clear      : clear      ,
        o_empty      : empty      ,
        o_almost_full: almost_full,
        o_full       : full       ,
        o_word_count : level      ,
        i_push       : push       ,
        i_data       : data       ,
        i_pop        : pop        ,
        o_data       : q          ,
    );
}

/// STD FIFOのlevel、full、emptyとpush/pop動作を検証する。
#[test(test_sync_fifo)]
module test_sync_fifo {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var clear      : logic   ;
    var push       : logic   ;
    var data       : logic<8>;
    var pop        : logic   ;
    var empty      : logic   ;
    var almost_full: logic   ;
    var full       : logic   ;
    var level      : logic<3>;
    var q          : logic<8>;

    inst dut: SyncFifo #(
        WIDTH: 8,
        DEPTH: 4,
    ) (
        clk        : clk        ,
        rst        : rst        ,
        clear      : clear      ,
        push       : push       ,
        data       : data       ,
        pop        : pop        ,
        empty      : empty      ,
        almost_full: almost_full,
        full       : full       ,
        level      : level      ,
        q          : q          ,
    );

    initial {
        clear = 0;
        push  = 0;
        data  = 0;
        pop   = 0;
        rst.assert();
        $assert(empty && level == 3'd0, "FIFO must start empty");

        data = 8'h12;
        push = 1;
        clk.next(1);
        push = 0;
        $assert(!empty && level == 3'd1 && q == 8'h12, "FIFO first push mismatch");

        data = 8'h34;
        push = 1;
        clk.next(1);
        push = 0;
        $assert(level == 3'd2 && q == 8'h12, "FIFO second push mismatch");

        pop = 1;
        clk.next(1);
        pop = 0;
        $assert(level == 3'd1 && q == 8'h34, "FIFO pop/level mismatch");
        clear = 1;
        clk.next(1);
        clear = 0;
        $assert(empty && level == 3'd0, "FIFO clear mismatch");
        $finish();
    }
}
