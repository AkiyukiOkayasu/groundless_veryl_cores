/// Veryl STD async FIFOをbare portへ包む。
///
/// source/destinationのresetとclockは別domainで扱う。CDC本体とreset同期は
/// Veryl STDへ委譲し、このラッパーではプロジェクト共通の信号名だけを定義する。
pub module AsyncFifo::<S: $std::synchronizer> #(
    param WIDTH             : u32   = 8           ,
    param TYPE              : type  = logic<WIDTH>,
    param STAGES            : u32   = 2           ,
    param DEPTH             : u32   = 8           ,
    param THRESHOLD         : u32   = DEPTH       ,
    param USE_OUT_DATA_RESET: bbool = true        ,
    param INITIAL_OUT_DATA  : TYPE  = 0 as TYPE   ,
    param MERGE_RESET       : bbool = false       ,
    param RESET_SYNC_STAGES : u32   = 2           ,
) (
    source_clk        : input  's clock,
    source_rst        : input  's reset,
    source_push       : input  's logic,
    source_data       : input  's TYPE ,
    source_almost_full: output 's logic,
    source_full       : output 's logic,
    dest_clk          : input  'd clock,
    dest_rst          : input  'd reset,
    dest_pop          : input  'd logic,
    dest_data         : output 'd TYPE ,
    dest_empty        : output 'd logic,
) {
    inst fifo: $std::async_fifo::<S> #(
        WIDTH             : WIDTH             ,
        TYPE              : TYPE              ,
        STAGES            : STAGES            ,
        DEPTH             : DEPTH             ,
        THRESHOLD         : THRESHOLD         ,
        USE_OUT_DATA_RESET: USE_OUT_DATA_RESET,
        INITIAL_OUT_DATA  : INITIAL_OUT_DATA  ,
        MERGE_RESET       : MERGE_RESET       ,
        RESET_SYNC_STAGES : RESET_SYNC_STAGES ,
    ) (
        is_clk        : source_clk        ,
        is_rst        : source_rst        ,
        os_almost_full: source_almost_full,
        os_full       : source_full       ,
        is_push       : source_push       ,
        is_data       : source_data       ,
        id_clk        : dest_clk          ,
        id_rst        : dest_rst          ,
        od_empty      : dest_empty        ,
        id_pop        : dest_pop          ,
        od_data       : dest_data         ,
    );
}

/// 非同期FIFOの書き込み、CDC、読み出しを検証するVeryl Native test。
#[test(test_async_fifo)]
module test_async_fifo {
    inst source_clk: $tb::clock_gen;
    inst dest_clk  : $tb::clock_gen;
    inst source_rst: $tb::reset_gen (
        clk: source_clk,
    );
    inst dest_rst: $tb::reset_gen (
        clk: dest_clk,
    );

    var source_push       : logic   ;
    var source_data       : logic<8>;
    var source_almost_full: logic   ;
    var source_full       : logic   ;
    var dest_pop          : logic   ;
    var dest_data         : logic<8>;
    var dest_empty        : logic   ;

    inst dut: AsyncFifo::<$std::synchronizer_basic> #(
        WIDTH: 8,
        DEPTH: 4,
    ) (
        source_clk        : source_clk        ,
        source_rst        : source_rst        ,
        source_push       : source_push       ,
        source_data       : source_data       ,
        source_almost_full: source_almost_full,
        source_full       : source_full       ,
        dest_clk          : dest_clk          ,
        dest_rst          : dest_rst          ,
        dest_pop          : dest_pop          ,
        dest_data         : dest_data         ,
        dest_empty        : dest_empty        ,
    );

    initial {
        source_push = 0;
        source_data = 8'h00;
        dest_pop    = 0;
        source_rst.assert();
        dest_rst.assert();
        source_clk.next(4);
        dest_clk.next(4);

        source_data = 8'h5a;
        source_push = 1;
        source_clk.next(4);
        source_push = 0;
        dest_clk.next(32);
        $assert(!dest_empty, "async FIFO must expose pushed data");

        dest_pop = 1;
        dest_clk.next(4);
        dest_pop = 0;
        $assert(dest_data == 8'h5a, "async FIFO data mismatch");
        dest_clk.next(2);
        $assert(dest_empty, "async FIFO must become empty after pop");
        $finish();
    }
}
