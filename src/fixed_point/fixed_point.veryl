/// 固定小数点型と定数や変換関数
pub package FixedPoint {
    /// 固定小数点値を右シフトするときの丸めモード。
    enum RoundingMode {
        /// 小数部を破棄する。signedでは負方向への算術右シフトとなる。
        ROUND_TRUNCATION,
        /// tieを正方向へ丸める。
        ROUND_HALF_UP,
        /// tieを絶対値が大きくなる方向へ丸める。
        ROUND_HALF_AWAY_FROM_ZERO,
    }

    //----------------------------------------------------------------
    // Q2.16形式 (+/-2.0 表示範囲)
    //----------------------------------------------------------------
    /// Q2.16形式 (+/-2.0 表示範囲)
    /// 27X18の乗算器の係数に使用
    type q2_16 = signed logic<18>; // 2ビット整数部 + 16ビット小数部
    /// Q2.16形式の正の最大値
    const Q2_16_POS_MAX: q2_16 = 18'sb01_11111111_11111111;
    /// Q2.16形式の負の最大値
    const Q2_16_NEG_MAX: q2_16 = 18'sb10_00000000_00000000;
    /// Q2.16形式の+1.0の定数
    const Q2_16_POS_ONE: q2_16 = 18'sb01_00000000_00000000;
    /// Q2.16形式の-1.0の定数
    const Q2_16_NEG_ONE: q2_16 = 18'sb11_00000000_00000000;
    /// Q2.16形式のゼロ
    const Q2_16_ZERO: q2_16 = 18'sd0;

    //----------------------------------------------------------------
    // Q1.31形式 (+/-1.0 表示範囲)
    //----------------------------------------------------------------
    /// Q1.31形式 (+/-1.0 表示範囲)
    /// デルタシグマ変調の入力などに使用
    /// Note: Q1.31形式は1.0は表現できず、最大値は+1.0-1LSBとなることに注意
    type q1_31 = signed logic<32>; // 1ビット整数部 + 31ビット小数部

    /// Q1.31形式の正の最大値 +1.0-1LSB
    const Q1_31_POS_MAX: q1_31 = 32'sh7FFF_FFFF;
    /// Q1.31形式の負の最大値 -1.0
    const Q1_31_NEG_MAX: q1_31 = 32'sh8000_0000;
    /// Q1.31形式のゼロ
    const Q1_31_ZERO: q1_31 = 32'sd0;

    /// f64からQ1.31形式へ変換
    function to_q1_31 (
        val: input f64,
    ) -> q1_31 {
        // 範囲チェック (-1.0 <= val < 1.0)
        if val <: -1.0 | val >= 1.0 {
            $error("to_q1_31: Value out of range. Must be -1.0 <= val < 1.0");
        }
        const scale  : f64 = 2147483648.0; // 2^31
        let   scaled : f64 = val * scale;
        let   rounded: i32 = scaled as i32;
        return rounded as q1_31;
    }

    //----------------------------------------------------------------
    // Q8.24形式 (+/-128.0 表示範囲)
    //----------------------------------------------------------------
    /// Q8.24形式 (+/-128.0 表示範囲)
    /// 波形オシレーターの出力などに使用
    type q8_24 = signed logic<32>; // 8ビット整数部 + 24ビット小数部

    /// Q8.24形式の正の最大値 +128.0-1LSB
    const Q8_24_POS_MAX: q8_24 = 32'sh7FFF_FFFF;
    /// Q8.24形式の負の最大値 -128.0
    const Q8_24_NEG_MAX: q8_24 = 32'sh8000_0000;
    /// Q8.24形式の+1.0の定数
    const Q8_24_POS_ONE: q8_24 = 32'sh0100_0000;
    /// Q8.24形式の-1.0の定数
    const Q8_24_NEG_ONE: q8_24 = 32'shFF00_0000;
    /// Q8.24形式のゼロ
    const Q8_24_ZERO: q8_24 = 32'sd0;

    /// f64からQ8.24形式へ変換
    /// f64の定数をQ8.24形式に変換する際に使用するもの
    function to_q8_24 (
        val: input f64,
    ) -> q8_24 {
        // 範囲チェック
        if val <: -128.0 | val >= 128.0 {
            $error("to_q8_24: Value out of range. Must be -128.0 <= val < 128.0");
        }
        const scale  : f64 = 16777216.0; // 2^24
        let   scaled : f64 = val * scale;
        let   rounded: i32 = scaled as i32; //四捨五入される
        return rounded as q8_24;
    }


    //----------------------------------------------------------------
    // Q8.19形式 (+/-128.0 表示範囲)
    //----------------------------------------------------------------
    /// Q8.19形式 (+/-128.0 表示範囲)
    /// DSPブロックの乗算器が36x27bitなので、係数用に作成した型
    /// FMインデックス係数などに使用
    type q8_19 = signed logic<27>; // 8ビット整数部 + 19ビット小数部
    /// Q8.19形式の正の最大値 +128.0-1LSB
    const Q8_19_POS_MAX: q8_19 = 27'sb01111111_111_11111111_11111111;
    /// Q8.19形式の負の最大値 -128.0
    const Q8_19_NEG_MAX: q8_19 = 27'sb10000000_000_00000000_00000000;
    /// Q8.19形式の+1.0の定数
    const Q8_19_POS_ONE: q8_19 = 27'sb00000001_000_00000000_00000000;
    /// Q8.19形式の-1.0の定数
    const Q8_19_NEG_ONE: q8_19 = 27'sb11111111_000_00000000_00000000;
    /// Q8.19形式のゼロ
    const Q8_19_ZERO: q8_19 = 27'sd0;

    /// f64からQ8.19形式へ変換
    function to_q8_19 (
        val: input f64,
    ) -> q8_19 {
        // 範囲チェック (-128.0 <= val < 128.0)
        if val <: -128.0 | val >= 128.0 {
            $error("to_q8_19: Value out of range. Must be -128.0 <= val < 128.0");
        }
        const scale  : f64 = 524288.0; // 2^19
        let   scaled : f64 = val * scale;
        let   rounded: i32 = scaled as i32;
        // 32bitから27bitへのキャスト。範囲チェック済みなので上位ビット切り捨てで問題ない
        return rounded as q8_19;
    }

    //----------------------------------------------------------------
    // Q3.24形式 (+/-4.0 表示範囲)
    //----------------------------------------------------------------
    /// Q3.24形式 (+/-4.0 表示範囲)
    /// DSPブロックの乗算器が36x27bitなので、係数用に作成した型
    /// ゲイン係数やエンベロープ係数などに使用
    type q3_24 = signed logic<27>; // 3ビット整数部 + 24ビット小数部
    /// Q3.24形式の正の最大値 +4.0-1LSB
    const Q3_24_POS_MAX: q3_24 = 27'sb011_11111111_11111111_11111111;
    /// Q3.24形式の負の最大値 -4.0
    const Q3_24_NEG_MAX: q3_24 = 27'sb100_00000000_00000000_00000000;
    /// Q3.24形式の+1.0の定数
    const Q3_24_POS_ONE: q3_24 = 27'sb001_00000000_00000000_00000000;
    /// Q3.24形式の-1.0の定数
    const Q3_24_NEG_ONE: q3_24 = 27'sb111_00000000_00000000_00000000;
    /// Q3.24形式のゼロ
    const Q3_24_ZERO: q3_24 = 27'sd0;

    /// f64からQ3.24形式へ変換
    function to_q3_24 (
        val: input f64,
    ) -> q3_24 {
        // 範囲チェック (-4.0 <= val < 4.0)
        if val <: -4.0 | val >= 4.0 {
            $error("to_q3_24: Value out of range. Must be -4.0 <= val < 4.0");
        }
        const scale  : f64 = 16777216.0; // 2^24
        let   scaled : f64 = val * scale;
        let   rounded: i32 = scaled as i32;
        // 32bitから27bitへのキャスト。範囲チェック済みなので上位ビット切り捨てで問題ない
        return rounded as q3_24;
    }

    /// Q8.24形式→Q1.31形式へ変換（7bit左シフト+下位7ビットゼロ埋め）
    /// Q8.24の+/-1.0範囲を超える入力はクリップする
    /// Note: 下位7ビットが0埋めされているだけなので、本当はサミングなどで+/-128の範囲に増やしてから読み替えだけした方がいい。
    function to_q1_31_from_q8_24_zero_pad (
        v: input q8_24,
    ) -> q1_31 {
        if v >= Q8_24_POS_ONE {
            return 32'h7FFF_FFFF;
        } else if v <= Q8_24_NEG_ONE {
            return 32'h8000_0000;
        }
        return v <<< 7;
    }

    /// Q1.31形式→Q8.24形式へ変換（7bit右シフト）
    /// Q1.31の+/-1.0範囲をQ8.24の+/-1.0範囲に変換
    function to_q8_24_from_q1_31 (
        v: input q1_31,
    ) -> q8_24 {
        return v >>> 7;
    }
}

/// signed値を算術右シフトし、指定モードで丸める。
/// MODEにはFixedPoint::RoundingMode::ROUND_*を指定する。
/// ROUND_TRUNCATIONは算術右シフト、ROUND_HALF_UPはtieを正方向、
/// ROUND_HALF_AWAY_FROM_ZEROはtieを絶対値が大きくなる方向へ丸める。
/// SHIFT == 0では入力をそのまま返す。
pub function round_shift_signed::<WIDTH: u32, SHIFT: u32, MODE: FixedPoint::RoundingMode> (
    value: input signed logic<WIDTH>,
) -> signed logic<WIDTH> {
    // SHIFTが入力幅を超えてもhalf値を保持できるよう、作業幅をシフト量からも導出する。
    const WORK_WIDTH: u32 = if WIDTH + 2 >= SHIFT + 2 ? WIDTH + 2 : SHIFT + 2;

    let value_ext : signed logic<WORK_WIDTH> = $signed({value[msb] repeat WORK_WIDTH - WIDTH, value});
    let half_value: signed logic<WORK_WIDTH> = if SHIFT == 0 ?
        '0
    :
        $signed({1'b0 repeat WORK_WIDTH - 1, 1'b1} << (SHIFT - 1))
    ;
    var result    : signed logic<WORK_WIDTH>;

    if SHIFT == 0 {
        result = value_ext;
    } else if MODE == FixedPoint::RoundingMode::ROUND_TRUNCATION {
        result = value_ext >>> SHIFT;
    } else if MODE == FixedPoint::RoundingMode::ROUND_HALF_UP {
        result = (value_ext + half_value) >>> SHIFT;
    } else if value_ext[msb] == 1'b0 {
        result = (value_ext + half_value) >>> SHIFT;
    } else {
        result = -((-value_ext + half_value) >>> SHIFT);
    }

    return $signed(result[WIDTH - 1:0]);
}

/// unsigned値を右シフトし、指定モードで丸める。
/// unsignedではROUND_HALF_UPとROUND_HALF_AWAY_FROM_ZEROの結果は同じになる。
pub function round_shift_unsigned::<WIDTH: u32, SHIFT: u32, MODE: FixedPoint::RoundingMode> (
    value: input logic<WIDTH>,
) -> logic<WIDTH> {
    const WORK_WIDTH: u32 = if WIDTH + 1 >= SHIFT + 2 ? WIDTH + 1 : SHIFT + 2;

    let value_ext : logic<WORK_WIDTH> = {1'b0 repeat WORK_WIDTH - WIDTH, value};
    let half_value: logic<WORK_WIDTH> = if SHIFT == 0 ? '0 : {1'b0 repeat WORK_WIDTH - 1, 1'b1} << (SHIFT - 1);
    var result    : logic<WORK_WIDTH>;

    if SHIFT == 0 {
        result = value_ext;
    } else if MODE == FixedPoint::RoundingMode::ROUND_TRUNCATION {
        result = value_ext >> SHIFT;
    } else {
        result = (value_ext + half_value) >> SHIFT;
    }

    return result[WIDTH - 1:0];
}

/// signed値を指定幅へ飽和させる。
/// 出力範囲は[-2^(OUT_WIDTH-1), 2^(OUT_WIDTH-1)-1]とする。
pub function saturate_signed::<IN_WIDTH: u32, OUT_WIDTH: u32> (
    value: input signed logic<IN_WIDTH>,
) -> signed logic<OUT_WIDTH> {
    const WORK_WIDTH  : u32 = if IN_WIDTH >= OUT_WIDTH ? IN_WIDTH + 1 : OUT_WIDTH + 1;
    const BODY_WIDTH  : u32 = OUT_WIDTH - 1;
    const EXTEND_WIDTH: u32 = WORK_WIDTH - OUT_WIDTH;

    let value_ext: signed logic<WORK_WIDTH> = $signed({value[msb] repeat WORK_WIDTH - IN_WIDTH, value});
    let max_value: signed logic<WORK_WIDTH> = {1'b0 repeat EXTEND_WIDTH, 1'b0, 1'b1 repeat BODY_WIDTH};
    let min_value: signed logic<WORK_WIDTH> = {1'b1 repeat EXTEND_WIDTH, 1'b1, 1'b0 repeat BODY_WIDTH};

    if value_ext >: max_value {
        return $signed(max_value[OUT_WIDTH - 1:0]);
    } else if value_ext <: min_value {
        return $signed(min_value[OUT_WIDTH - 1:0]);
    } else {
        return $signed(value_ext[OUT_WIDTH - 1:0]);
    }
}

/// unsigned値を指定幅へ飽和させる。
/// 出力範囲は[0, 2^OUT_WIDTH-1]とする。
pub function saturate_unsigned::<IN_WIDTH: u32, OUT_WIDTH: u32> (
    value: input logic<IN_WIDTH>,
) -> logic<OUT_WIDTH> {
    const WORK_WIDTH  : u32 = if IN_WIDTH >= OUT_WIDTH ? IN_WIDTH + 1 : OUT_WIDTH + 1;
    const EXTEND_WIDTH: u32 = WORK_WIDTH - OUT_WIDTH;

    let value_ext: logic<WORK_WIDTH> = {1'b0 repeat WORK_WIDTH - IN_WIDTH, value};
    let max_value: logic<WORK_WIDTH> = {1'b0 repeat EXTEND_WIDTH, 1'b1 repeat OUT_WIDTH};

    if value_ext >: max_value {
        return max_value[OUT_WIDTH - 1:0];
    } else {
        return value_ext[OUT_WIDTH - 1:0];
    }
}

/// signed値を任意の上下限へ制限する。
/// lower <= upperの範囲で使用する。
pub function clamp_signed::<WIDTH: u32> (
    value: input signed logic<WIDTH>,
    lower: input signed logic<WIDTH>,
    upper: input signed logic<WIDTH>,
) -> signed logic<WIDTH> {
    if value <: lower {
        return lower;
    } else if value >: upper {
        return upper;
    } else {
        return value;
    }
}

/// unsigned値を任意の上下限へ制限する。
/// lower <= upperの範囲で使用する。
pub function clamp_unsigned::<WIDTH: u32> (
    value: input logic<WIDTH>,
    lower: input logic<WIDTH>,
    upper: input logic<WIDTH>,
) -> logic<WIDTH> {
    if value <: lower {
        return lower;
    } else if value >: upper {
        return upper;
    } else {
        return value;
    }
}

/// signed固定小数点値を小数ビット数と出力幅ごと変換する。
/// MODEにはFixedPoint::RoundingMode::ROUND_*を指定する。
/// 処理順は小数位置調整、丸め、飽和とする。
/// IN_WIDTH/OUT_WIDTHは総ビット幅、IN_FRAC/OUT_FRACは小数ビット数を表す。
pub function fixed_resize_signed::<
    IN_WIDTH : u32                     ,
    IN_FRAC  : u32                     ,
    OUT_WIDTH: u32                     ,
    OUT_FRAC : u32                     ,
    MODE     : FixedPoint::RoundingMode,
> (
    value: input signed logic<IN_WIDTH>,
) -> signed logic<OUT_WIDTH> {
    const LEFT_SHIFT : u32 = if IN_FRAC >= OUT_FRAC ? 0 : OUT_FRAC - IN_FRAC;
    const RIGHT_SHIFT: u32 = if OUT_FRAC >= IN_FRAC ? 0 : IN_FRAC - OUT_FRAC;
    const BASE_WIDTH : u32 = if IN_WIDTH + LEFT_SHIFT >= OUT_WIDTH ? IN_WIDTH + LEFT_SHIFT + 2 : OUT_WIDTH + 2;
    const WORK_WIDTH : u32 = if BASE_WIDTH >= RIGHT_SHIFT + 2 ? BASE_WIDTH : RIGHT_SHIFT + 2;

    let value_ext : signed logic<WORK_WIDTH> = $signed({value[msb] repeat WORK_WIDTH - IN_WIDTH, value});
    let half_value: signed logic<WORK_WIDTH> = if RIGHT_SHIFT == 0 ?
        '0
    :
        $signed({1'b0 repeat WORK_WIDTH - 1, 1'b1} << (RIGHT_SHIFT - 1))
    ;
    var aligned   : signed logic<WORK_WIDTH>;

    if RIGHT_SHIFT == 0 {
        aligned = value_ext <<< LEFT_SHIFT;
    } else if MODE == FixedPoint::RoundingMode::ROUND_TRUNCATION {
        aligned = value_ext >>> RIGHT_SHIFT;
    } else if MODE == FixedPoint::RoundingMode::ROUND_HALF_UP {
        aligned = (value_ext + half_value) >>> RIGHT_SHIFT;
    } else if value_ext[msb] == 1'b0 {
        aligned = (value_ext + half_value) >>> RIGHT_SHIFT;
    } else {
        aligned = -((-value_ext + half_value) >>> RIGHT_SHIFT);
    }

    const BODY_WIDTH  : u32 = OUT_WIDTH - 1;
    const EXTEND_WIDTH: u32 = WORK_WIDTH - OUT_WIDTH;

    let max_value: signed logic<WORK_WIDTH> = {1'b0 repeat EXTEND_WIDTH, 1'b0, 1'b1 repeat BODY_WIDTH};
    let min_value: signed logic<WORK_WIDTH> = {1'b1 repeat EXTEND_WIDTH, 1'b1, 1'b0 repeat BODY_WIDTH};

    if aligned >: max_value {
        return $signed(max_value[OUT_WIDTH - 1:0]);
    } else if aligned <: min_value {
        return $signed(min_value[OUT_WIDTH - 1:0]);
    } else {
        return $signed(aligned[OUT_WIDTH - 1:0]);
    }
}

/// unsigned固定小数点値を小数ビット数と出力幅ごと変換する。
/// 処理順は小数位置調整、丸め、飽和の順とする。
/// IN_WIDTH/OUT_WIDTHは総ビット幅、IN_FRAC/OUT_FRACは小数ビット数を表す。
pub function fixed_resize_unsigned::<
    IN_WIDTH : u32                     ,
    IN_FRAC  : u32                     ,
    OUT_WIDTH: u32                     ,
    OUT_FRAC : u32                     ,
    MODE     : FixedPoint::RoundingMode,
> (
    value: input logic<IN_WIDTH>,
) -> logic<OUT_WIDTH> {
    const LEFT_SHIFT : u32 = if IN_FRAC >= OUT_FRAC ? 0 : OUT_FRAC - IN_FRAC;
    const RIGHT_SHIFT: u32 = if OUT_FRAC >= IN_FRAC ? 0 : IN_FRAC - OUT_FRAC;
    const BASE_WIDTH : u32 = if IN_WIDTH + LEFT_SHIFT >= OUT_WIDTH ? IN_WIDTH + LEFT_SHIFT + 1 : OUT_WIDTH + 1;
    const WORK_WIDTH : u32 = if BASE_WIDTH >= RIGHT_SHIFT + 2 ? BASE_WIDTH : RIGHT_SHIFT + 2;

    let value_ext : logic<WORK_WIDTH> = {1'b0 repeat WORK_WIDTH - IN_WIDTH, value};
    let half_value: logic<WORK_WIDTH> = if RIGHT_SHIFT == 0 ?
        '0
    :
        {1'b0 repeat WORK_WIDTH - 1, 1'b1} << (RIGHT_SHIFT - 1)
    ;
    var aligned   : logic<WORK_WIDTH>;

    if RIGHT_SHIFT == 0 {
        aligned = value_ext << LEFT_SHIFT;
    } else if MODE == FixedPoint::RoundingMode::ROUND_TRUNCATION {
        aligned = value_ext >> RIGHT_SHIFT;
    } else {
        aligned = (value_ext + half_value) >> RIGHT_SHIFT;
    }

    const EXTEND_WIDTH: u32               = WORK_WIDTH - OUT_WIDTH;
    let   max_value   : logic<WORK_WIDTH> = {1'b0 repeat EXTEND_WIDTH, 1'b1 repeat OUT_WIDTH};

    if aligned >: max_value {
        return max_value[OUT_WIDTH - 1:0];
    } else {
        return aligned[OUT_WIDTH - 1:0];
    }
}

/// signed整数同士を、入力幅の合計幅で乗算する。
/// 結果の幅はA_WIDTH+B_WIDTH、小数ビット数は入力の小数ビット数の合計とする。
/// 出力変換時は、この積をfixed_resize_signedへ渡して小数位置を調整する。
/// 入力幅は1以上、符号付き入力として解釈する。
pub function fixed_mul::<A_WIDTH: u32, B_WIDTH: u32> (
    a: input signed logic<A_WIDTH>,
    b: input signed logic<B_WIDTH>,
) -> signed logic<A_WIDTH + B_WIDTH> {
    const PRODUCT_WIDTH: u32 = A_WIDTH + B_WIDTH;

    let a_ext: signed logic<PRODUCT_WIDTH> = $signed({a[msb] repeat B_WIDTH, a});
    let b_ext: signed logic<PRODUCT_WIDTH> = $signed({b[msb] repeat A_WIDTH, b});

    return a_ext * b_ext;
}

/// unsigned整数同士を、入力幅の合計幅で乗算する。
/// 結果の幅はA_WIDTH+B_WIDTH、小数ビット数は入力の小数ビット数の合計とする。
pub function fixed_mul_unsigned::<A_WIDTH: u32, B_WIDTH: u32> (
    a: input logic<A_WIDTH>,
    b: input logic<B_WIDTH>,
) -> logic<A_WIDTH + B_WIDTH> {
    const PRODUCT_WIDTH: u32 = A_WIDTH + B_WIDTH;

    let a_ext: logic<PRODUCT_WIDTH> = {1'b0 repeat B_WIDTH, a};
    let b_ext: logic<PRODUCT_WIDTH> = {1'b0 repeat A_WIDTH, b};

    return a_ext * b_ext;
}

/// signed乗算結果を指定フォーマットへ変換する。
/// 積の小数ビット数はA_FRAC+B_FRACとして扱う。
pub function fixed_mul_resize_signed::<
    A_WIDTH  : u32                     ,
    A_FRAC   : u32                     ,
    B_WIDTH  : u32                     ,
    B_FRAC   : u32                     ,
    OUT_WIDTH: u32                     ,
    OUT_FRAC : u32                     ,
    MODE     : FixedPoint::RoundingMode,
> (
    a: input signed logic<A_WIDTH>,
    b: input signed logic<B_WIDTH>,
) -> signed logic<OUT_WIDTH> {
    const PRODUCT_WIDTH: u32 = A_WIDTH + B_WIDTH;
    const PRODUCT_FRAC : u32 = A_FRAC + B_FRAC;

    let product: signed logic<PRODUCT_WIDTH> = fixed_mul::<A_WIDTH, B_WIDTH>(a, b);

    return fixed_resize_signed::<PRODUCT_WIDTH, PRODUCT_FRAC, OUT_WIDTH, OUT_FRAC, MODE>(product);
}

/// unsigned乗算結果を指定フォーマットへ変換する。
/// 積の小数ビット数はA_FRAC+B_FRACとして扱う。
pub function fixed_mul_resize_unsigned::<
    A_WIDTH  : u32                     ,
    A_FRAC   : u32                     ,
    B_WIDTH  : u32                     ,
    B_FRAC   : u32                     ,
    OUT_WIDTH: u32                     ,
    OUT_FRAC : u32                     ,
    MODE     : FixedPoint::RoundingMode,
> (
    a: input logic<A_WIDTH>,
    b: input logic<B_WIDTH>,
) -> logic<OUT_WIDTH> {
    const PRODUCT_WIDTH: u32 = A_WIDTH + B_WIDTH;
    const PRODUCT_FRAC : u32 = A_FRAC + B_FRAC;

    let product: logic<PRODUCT_WIDTH> = fixed_mul_unsigned::<A_WIDTH, B_WIDTH>(a, b);

    return fixed_resize_unsigned::<PRODUCT_WIDTH, PRODUCT_FRAC, OUT_WIDTH, OUT_FRAC, MODE>(product);
}

/// 丸め付き右シフトの動作を検証する。
#[test(test_fixed_point_round_shift)]
module test_fixed_point_round_shift {
    inst clk: $tb::clock_gen;

    var signed_input    : signed logic<8>;
    var signed_trunc    : signed logic<8>;
    var signed_halfup   : signed logic<8>;
    var signed_zero     : signed logic<8>;
    var signed_away     : signed logic<8>;
    var signed_trunc2   : signed logic<8>;
    var signed_halfup2  : signed logic<8>;
    var signed_away2    : signed logic<8>;
    var unsigned_input  : logic       <8>;
    var unsigned_trunc  : logic       <8>;
    var unsigned_halfup : logic       <8>;
    var unsigned_away   : logic       <8>;
    var unsigned_zero   : logic       <8>;
    var unsigned_trunc2 : logic       <8>;
    var unsigned_halfup2: logic       <8>;

    always_comb {
        signed_trunc     = round_shift_signed::<8, 1, FixedPoint::RoundingMode::ROUND_TRUNCATION>(signed_input);
        signed_halfup    = round_shift_signed::<8, 1, FixedPoint::RoundingMode::ROUND_HALF_UP>(signed_input);
        signed_zero      = round_shift_signed::<8, 0, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            signed_input,
        );
        signed_away      = round_shift_signed::<8, 1, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            signed_input,
        );
        signed_trunc2    = round_shift_signed::<8, 2, FixedPoint::RoundingMode::ROUND_TRUNCATION>(signed_input);
        signed_halfup2   = round_shift_signed::<8, 2, FixedPoint::RoundingMode::ROUND_HALF_UP>(signed_input);
        signed_away2     = round_shift_signed::<8, 2, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            signed_input,
        );
        unsigned_trunc   = round_shift_unsigned::<8, 1, FixedPoint::RoundingMode::ROUND_TRUNCATION>(unsigned_input);
        unsigned_halfup  = round_shift_unsigned::<8, 1, FixedPoint::RoundingMode::ROUND_HALF_UP>(unsigned_input);
        unsigned_away    = round_shift_unsigned::<8, 1, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            unsigned_input,
        );
        unsigned_zero    = round_shift_unsigned::<8, 0, FixedPoint::RoundingMode::ROUND_HALF_UP>(unsigned_input);
        unsigned_trunc2  = round_shift_unsigned::<8, 2, FixedPoint::RoundingMode::ROUND_TRUNCATION>(unsigned_input);
        unsigned_halfup2 = round_shift_unsigned::<8, 2, FixedPoint::RoundingMode::ROUND_HALF_UP>(unsigned_input);
    }

    initial {
        signed_input   = 7;
        unsigned_input = 7;
        clk.next();
        $assert(signed_trunc == 8'sd3, "signed truncation mismatch for positive value");
        $assert(signed_halfup == 8'sd4, "signed half up mismatch for positive value");
        $assert(signed_away == 8'sd4, "signed half away mismatch for positive value");
        $assert(unsigned_trunc == 8'd3, "unsigned truncation mismatch");
        $assert(unsigned_halfup == 8'd4, "unsigned half up mismatch");
        $assert(unsigned_away == 8'd4, "unsigned half away mismatch");
        $assert(signed_trunc2 == 8'sd1, "signed shift-2 truncation mismatch");
        $assert(signed_halfup2 == 8'sd2, "signed shift-2 half up mismatch");
        $assert(signed_away2 == 8'sd2, "signed shift-2 half away mismatch");
        $assert(unsigned_trunc2 == 8'd1, "unsigned shift-2 truncation mismatch");
        $assert(unsigned_halfup2 == 8'd2, "unsigned shift-2 half up mismatch");

        signed_input   = -7;
        unsigned_input = 2;
        clk.next();
        $assert(signed_trunc == -8'sd4, "signed truncation mismatch for negative value");
        $assert(signed_halfup == -8'sd3, "signed half up mismatch for negative value");
        $assert(signed_away == -8'sd4, "signed half away mismatch for negative value");
        $assert(signed_trunc2 == -8'sd2, "signed negative shift-2 truncation mismatch");
        $assert(signed_halfup2 == -8'sd2, "signed negative shift-2 half up mismatch");
        $assert(signed_away2 == -8'sd2, "signed negative shift-2 half away mismatch");
        $assert(unsigned_trunc == 8'd1, "unsigned truncation mismatch for exact value");
        $assert(unsigned_halfup == 8'd1, "unsigned half up mismatch for exact value");

        signed_input   = -1;
        unsigned_input = 1;
        clk.next();
        $assert(signed_away == -8'sd1, "signed half away must round -0.5 away from zero");
        $assert(unsigned_halfup == 8'd1, "unsigned half up must round 0.5 upward");

        signed_input = 127;
        clk.next();
        $assert(signed_away == 8'sd64, "positive rounding carry mismatch");

        signed_input = -128;
        clk.next();
        $assert(signed_away == -8'sd64, "signed minimum rounding mismatch");

        signed_input   = -7;
        unsigned_input = 7;
        clk.next();
        $assert(signed_input == -8'sd7, "shift zero signed input setup mismatch");
        $assert(unsigned_input == 8'd7, "shift zero unsigned input setup mismatch");
        $assert(signed_zero == -8'sd7, "signed shift zero mismatch");
        $assert(unsigned_zero == 8'd7, "unsigned shift zero mismatch");

        $finish();
    }
}

/// signed/unsigned saturationの動作を検証する。
#[test(test_fixed_point_saturation)]
module test_fixed_point_saturation {
    inst clk: $tb::clock_gen;

    var signed_input  : signed logic<8> ;
    var signed_small  : signed logic<4> ;
    var signed_wide   : signed logic<10>;
    var unsigned_input: logic       <8> ;
    var unsigned_small: logic       <4> ;
    var unsigned_wide : logic       <10>;

    always_comb {
        signed_small   = saturate_signed::<8, 4>(signed_input);
        signed_wide    = saturate_signed::<8, 10>(signed_input);
        unsigned_small = saturate_unsigned::<8, 4>(unsigned_input);
        unsigned_wide  = saturate_unsigned::<8, 10>(unsigned_input);
    }

    initial {
        signed_input   = 127;
        unsigned_input = 255;
        clk.next();
        $assert(signed_small == 4'sd7, "signed positive saturation mismatch");
        $assert(signed_wide == 10'sd127, "signed widening mismatch");
        $assert(unsigned_small == 4'd15, "unsigned saturation mismatch");
        $assert(unsigned_wide == 10'd255, "unsigned widening mismatch");

        signed_input   = 8;
        unsigned_input = 16;
        clk.next();
        $assert(signed_small == 4'sd7, "signed upper boundary saturation mismatch");
        $assert(unsigned_small == 4'd15, "unsigned upper boundary saturation mismatch");

        signed_input   = 7;
        unsigned_input = 15;
        clk.next();
        $assert(signed_small == 4'sd7, "signed exact maximum saturation mismatch");
        $assert(unsigned_small == 4'd15, "unsigned exact maximum saturation mismatch");

        signed_input   = -9;
        unsigned_input = 14;
        clk.next();
        $assert(signed_small == -4'sd8, "signed negative saturation mismatch");
        $assert(unsigned_small == 4'd14, "unsigned in-range value mismatch");

        signed_input   = -2;
        unsigned_input = 5;
        clk.next();
        $assert(signed_small == -4'sd2, "signed negative in-range saturation mismatch");
        $assert(signed_wide == -10'sd2, "signed negative widening mismatch");
        $assert(unsigned_small == 4'd5, "unsigned in-range saturation mismatch");

        signed_input   = -8;
        unsigned_input = 0;
        clk.next();
        $assert(signed_small == -4'sd8, "signed exact minimum saturation mismatch");
        $assert(unsigned_small == 4'd0, "unsigned exact zero saturation mismatch");

        signed_input   = -128;
        unsigned_input = 0;
        clk.next();
        $assert(signed_small == -4'sd8, "signed minimum saturation mismatch");
        $assert(unsigned_small == 4'd0, "unsigned zero saturation mismatch");

        $finish();
    }
}

/// signed/unsigned clampの動作を検証する。
#[test(test_fixed_point_clamp)]
module test_fixed_point_clamp {
    inst clk: $tb::clock_gen;

    var signed_value    : signed logic<8>;
    var signed_clamped  : signed logic<8>;
    var unsigned_value  : logic       <8>;
    var unsigned_clamped: logic       <8>;

    always_comb {
        signed_clamped   = clamp_signed::<8>(signed_value, -8'sd3, 8'sd5);
        unsigned_clamped = clamp_unsigned::<8>(unsigned_value, 8'd3, 8'd10);
    }

    initial {
        signed_value   = -10;
        unsigned_value = 0;
        clk.next();
        $assert(signed_clamped == -8'sd3, "signed lower clamp mismatch");
        $assert(unsigned_clamped == 8'd3, "unsigned lower clamp mismatch");

        signed_value   = 2;
        unsigned_value = 7;
        clk.next();
        $assert(signed_clamped == 8'sd2, "signed in-range clamp mismatch");
        $assert(unsigned_clamped == 8'd7, "unsigned in-range clamp mismatch");

        signed_value   = 10;
        unsigned_value = 20;
        clk.next();
        $assert(signed_clamped == 8'sd5, "signed upper clamp mismatch");
        $assert(unsigned_clamped == 8'd10, "unsigned upper clamp mismatch");

        signed_value   = -3;
        unsigned_value = 3;
        clk.next();
        $assert(signed_clamped == -8'sd3, "signed exact lower clamp mismatch");
        $assert(unsigned_clamped == 8'd3, "unsigned exact lower clamp mismatch");

        signed_value   = 5;
        unsigned_value = 10;
        clk.next();
        $assert(signed_clamped == 8'sd5, "signed exact upper clamp mismatch");
        $assert(unsigned_clamped == 8'd10, "unsigned exact upper clamp mismatch");

        $finish();
    }
}

/// fixed resizeとmultiply helperの動作を検証する。
#[test(test_fixed_point_resize_and_mul)]
module test_fixed_point_resize_and_mul {
    inst clk: $tb::clock_gen;

    var resize_input   : signed logic<8> ;
    var resize_down    : signed logic<8> ;
    var resize_up      : signed logic<10>;
    var resize_sat_in  : signed logic<12>;
    var resize_sat     : signed logic<8> ;
    var resize_ext     : signed logic<10>;
    var resize_direct  : signed logic<10>;
    var a              : signed logic<8> ;
    var b              : signed logic<8> ;
    var product        : signed logic<16>;
    var product_resized: signed logic<8> ;

    always_comb {
        resize_down     = fixed_resize_signed::<8, 4, 8, 2, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            resize_input,
        );
        resize_up       = fixed_resize_signed::<8, 2, 10, 4, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            resize_input,
        );
        resize_sat      = fixed_resize_signed::<12, 4, 8, 2, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            resize_sat_in,
        );
        resize_ext      = $signed({resize_input[msb] repeat 2, resize_input});
        resize_direct   = round_shift_signed::<10, 2, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(resize_ext);
        product         = fixed_mul::<8, 8>(a, b);
        product_resized = fixed_resize_signed::<16, 4, 8, 2, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            product,
        );
    }

    initial {
        resize_input  = 6;
        resize_sat_in = 0;
        a             = 0;
        b             = 0;
        clk.next();
        $assert(resize_down == 8'sd2, "fractional reduction rounding mismatch");
        $assert(resize_up == 10'sd24, "fractional expansion mismatch");

        resize_input = -6;
        clk.next();
        $assert(resize_ext == -10'sd6, "resize sign extension mismatch");
        $assert(resize_direct == -10'sd2, "direct resize rounding mismatch");
        $assert(resize_down == -8'sd2, "negative fractional reduction rounding mismatch");
        $assert(resize_up == -10'sd24, "negative fractional expansion mismatch");

        resize_sat_in = 2047;
        clk.next();
        $assert(resize_sat == 8'sd127, "resize positive saturation mismatch");

        resize_sat_in = -2048;
        clk.next();
        $assert(resize_sat == -8'sd128, "resize negative saturation mismatch");

        a = 6;
        b = 2;
        clk.next();
        $assert(product == 16'sd12, "positive product mismatch");
        $assert(product_resized == 8'sd3, "positive product resize mismatch");

        a = -6;
        b = 2;
        clk.next();
        $assert(product == -16'sd12, "negative product mismatch");
        $assert(product_resized == -8'sd3, "negative product resize mismatch");

        a = -6;
        b = -2;
        clk.next();
        $assert(product == 16'sd12, "negative times negative product mismatch");
        $assert(product_resized == 8'sd3, "negative times negative resize mismatch");

        $finish();
    }
}

/// 固定小数点APIの幅変換、丸め境界、unsigned、非対称乗算を検証する。
#[test(test_fixed_point_generic_api)]
module test_fixed_point_generic_api {
    inst clk: $tb::clock_gen;

    var signed_input       : signed logic<8> ;
    var signed_halfup      : signed logic<8> ;
    var signed_away        : signed logic<8> ;
    var signed_trunc       : signed logic<8> ;
    var signed_expanded    : signed logic<12>;
    var signed_sat_input   : signed logic<12>;
    var signed_sat_output  : signed logic<6> ;
    var wide_input         : signed logic<40>;
    var wide_rounded       : signed logic<40>;
    var unsigned_input     : logic       <8> ;
    var unsigned_halfup    : logic       <4> ;
    var unsigned_away      : logic       <4> ;
    var unsigned_expanded  : logic       <10>;
    var unsigned_sat_input : logic       <12>;
    var unsigned_sat_output: logic       <8> ;
    var signed_a           : signed logic<4> ;
    var signed_b           : signed logic<6> ;
    var signed_product     : signed logic<10>;
    var signed_resized     : signed logic<8> ;
    var unsigned_a         : logic       <4> ;
    var unsigned_b         : logic       <4> ;
    var unsigned_product   : logic       <8> ;
    var unsigned_resized   : logic       <4> ;

    always_comb {
        signed_halfup     = fixed_resize_signed::<8, 3, 8, 1, FixedPoint::RoundingMode::ROUND_HALF_UP>(signed_input);
        signed_away       = fixed_resize_signed::<8, 3, 8, 1, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            signed_input,
        );
        signed_trunc      = fixed_resize_signed::<8, 3, 8, 1, FixedPoint::RoundingMode::ROUND_TRUNCATION>(signed_input);
        signed_expanded   = fixed_resize_signed::<8, 3, 12, 3, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            signed_input,
        );
        signed_sat_output = fixed_resize_signed::<12, 4, 6, 4, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            signed_sat_input,
        );
        wide_rounded      = round_shift_signed::<40, 33, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            wide_input,
        );

        unsigned_halfup     = fixed_resize_unsigned::<8, 3, 4, 1, FixedPoint::RoundingMode::ROUND_HALF_UP>(
            unsigned_input,
        );
        unsigned_away       = fixed_resize_unsigned::<8, 3, 4, 1, FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO>(
            unsigned_input,
        );
        unsigned_expanded   = fixed_resize_unsigned::<8, 2, 10, 4, FixedPoint::RoundingMode::ROUND_HALF_UP>(
            unsigned_input,
        );
        unsigned_sat_output = fixed_resize_unsigned::<12, 4, 8, 2, FixedPoint::RoundingMode::ROUND_HALF_UP>(
            unsigned_sat_input,
        );

        signed_product   = fixed_mul::<4, 6>(signed_a, signed_b);
        signed_resized   = fixed_mul_resize_signed::<
            4                                                  ,
            2                                                  ,
            6                                                  ,
            3                                                  ,
            8                                                  ,
            2                                                  ,
            FixedPoint::RoundingMode::ROUND_HALF_AWAY_FROM_ZERO,
        >(signed_a, signed_b);
        unsigned_product = fixed_mul_unsigned::<4, 4>(unsigned_a, unsigned_b);
        unsigned_resized = fixed_mul_resize_unsigned::<4, 2, 4, 2, 4, 2, FixedPoint::RoundingMode::ROUND_HALF_UP>(
            unsigned_a,
            unsigned_b,
        );
    }

    initial {
        signed_input       = 6;
        signed_sat_input   = 2047;
        unsigned_input     = 6;
        unsigned_sat_input = 4095;
        signed_a           = -3;
        signed_b           = 5;
        unsigned_a         = 15;
        unsigned_b         = 3;
        wide_input         = 40'sd1 <<< 32;
        clk.next();
        $assert(signed_trunc == 8'sd1, "signed resize truncation mismatch");
        $assert(signed_halfup == 8'sd2, "signed resize half up tie mismatch");
        $assert(signed_away == 8'sd2, "signed resize half away tie mismatch");
        $assert(signed_expanded == 12'sd6, "signed integer expansion mismatch");
        $assert(signed_sat_output == 6'sd31, "signed resize upper saturation mismatch");
        $assert(unsigned_halfup == 4'd2, "unsigned resize half up mismatch");
        $assert(unsigned_away == 4'd2, "unsigned resize half away mismatch");
        $assert(unsigned_expanded == 10'd24, "unsigned fractional expansion mismatch");
        $assert(unsigned_sat_output == 8'd255, "unsigned resize saturation mismatch");
        $assert(signed_product == -10'sd15, "asymmetric signed product mismatch");
        $assert(signed_resized == -8'sd2, "signed multiply-resize mismatch");
        $assert(unsigned_product == 8'd45, "unsigned product mismatch");
        $assert(unsigned_resized == 4'd11, "unsigned multiply-resize mismatch");
        $assert(wide_rounded == 40'sd1, "wide shift positive tie mismatch");

        signed_input       = -6;
        signed_sat_input   = -2048;
        unsigned_input     = 2;
        unsigned_sat_input = 0;
        wide_input         = -(40'sd1 <<< 32);
        clk.next();
        $assert(signed_trunc == -8'sd2, "signed resize negative truncation mismatch");
        $assert(signed_halfup == -8'sd1, "signed resize negative half up tie mismatch");
        $assert(signed_away == -8'sd2, "signed resize negative half away tie mismatch");
        $assert(signed_expanded == -12'sd6, "signed negative expansion mismatch");
        $assert(signed_sat_output == -6'sd32, "signed resize lower saturation mismatch");
        $assert(unsigned_halfup == 4'd1, "unsigned resize exact zero-side mismatch");
        $assert(unsigned_away == 4'd1, "unsigned resize zero-side mismatch");
        $assert(unsigned_expanded == 10'd8, "unsigned fractional expansion second case mismatch");
        $assert(unsigned_sat_output == 8'd0, "unsigned zero resize mismatch");
        $assert(wide_rounded == -40'sd1, "wide shift negative tie mismatch");

        unsigned_input = 3;
        clk.next();
        $assert(unsigned_halfup == 4'd1, "unsigned resize half tie mismatch");
        $assert(unsigned_away == 4'd1, "unsigned resize half away mismatch");

        $finish();
    }
}
