/// 固定小数点型と定数や変換関数
pub package FixedPoint {
    /// 丸めモード値。0: truncation、1: round half up、2: round half away from zero。
    const ROUND_TRUNCATION         : u32 = 0;
    const ROUND_HALF_UP            : u32 = 1;
    const ROUND_HALF_AWAY_FROM_ZERO: u32 = 2;

    //----------------------------------------------------------------
    // Q2.16形式 (+/-2.0 表示範囲)
    //----------------------------------------------------------------
    /// Q2.16形式 (+/-2.0 表示範囲)
    /// 27X18の乗算器の係数に使用
    type q2_16 = signed logic<18>; // 2ビット整数部 + 16ビット小数部
    /// Q2.16形式の正の最大値
    const Q2_16_POS_MAX: q2_16 = 18'sb01_11111111_11111111;
    /// Q2.16形式の負の最大値
    const Q2_16_NEG_MAX: q2_16 = 18'sb10_00000000_00000000;
    /// Q2.16形式の+1.0の定数
    const Q2_16_POS_ONE: q2_16 = 18'sb01_00000000_00000000;
    /// Q2.16形式の-1.0の定数
    const Q2_16_NEG_ONE: q2_16 = 18'sb11_00000000_00000000;
    /// Q2.16形式のゼロ
    const Q2_16_ZERO: q2_16 = 18'sd0;

    //----------------------------------------------------------------
    // Q1.31形式 (+/-1.0 表示範囲)
    //----------------------------------------------------------------
    /// Q1.31形式 (+/-1.0 表示範囲)
    /// デルタシグマ変調の入力などに使用
    /// Note: Q1.31形式は1.0は表現できず、最大値は+1.0-1LSBとなることに注意
    type q1_31 = signed logic<32>; // 1ビット整数部 + 31ビット小数部

    /// Q1.31形式の正の最大値 +1.0-1LSB
    const Q1_31_POS_MAX: q1_31 = 32'sh7FFF_FFFF;
    /// Q1.31形式の負の最大値 -1.0
    const Q1_31_NEG_MAX: q1_31 = 32'sh8000_0000;
    /// Q1.31形式のゼロ
    const Q1_31_ZERO: q1_31 = 32'sd0;

    /// f64からQ1.31形式へ変換
    function to_q1_31 (
        val: input f64,
    ) -> q1_31 {
        // 範囲チェック (-1.0 <= val < 1.0)
        if val <: -1.0 | val >= 1.0 {
            $error("to_q1_31: Value out of range. Must be -1.0 <= val < 1.0");
        }
        const scale  : f64 = 2147483648.0; // 2^31
        let   scaled : f64 = val * scale;
        let   rounded: i32 = scaled as i32;
        return rounded as q1_31;
    }

    //----------------------------------------------------------------
    // Q8.24形式 (+/-128.0 表示範囲)
    //----------------------------------------------------------------
    /// Q8.24形式 (+/-128.0 表示範囲)
    /// 波形オシレーターの出力などに使用
    type q8_24 = signed logic<32>; // 8ビット整数部 + 24ビット小数部

    /// Q8.24形式の正の最大値 +128.0-1LSB
    const Q8_24_POS_MAX: q8_24 = 32'sh7FFF_FFFF;
    /// Q8.24形式の負の最大値 -128.0
    const Q8_24_NEG_MAX: q8_24 = 32'sh8000_0000;
    /// Q8.24形式の+1.0の定数
    const Q8_24_POS_ONE: q8_24 = 32'sh0100_0000;
    /// Q8.24形式の-1.0の定数
    const Q8_24_NEG_ONE: q8_24 = 32'shFF00_0000;
    /// Q8.24形式のゼロ
    const Q8_24_ZERO: q8_24 = 32'sd0;

    /// f64からQ8.24形式へ変換
    /// f64の定数をQ8.24形式に変換する際に使用するもの
    function to_q8_24 (
        val: input f64,
    ) -> q8_24 {
        // 範囲チェック
        if val <: -128.0 | val >= 128.0 {
            $error("to_q8_24: Value out of range. Must be -128.0 <= val < 128.0");
        }
        const scale  : f64 = 16777216.0; // 2^24
        let   scaled : f64 = val * scale;
        let   rounded: i32 = scaled as i32; //四捨五入される
        return rounded as q8_24;
    }


    //----------------------------------------------------------------
    // Q8.19形式 (+/-128.0 表示範囲)
    //----------------------------------------------------------------
    /// Q8.19形式 (+/-128.0 表示範囲)
    /// DSPブロックの乗算器が36x27bitなので、係数用に作成した型
    /// FMインデックス係数などに使用
    type q8_19 = signed logic<27>; // 8ビット整数部 + 19ビット小数部
    /// Q8.19形式の正の最大値 +128.0-1LSB
    const Q8_19_POS_MAX: q8_19 = 27'sb01111111_111_11111111_11111111;
    /// Q8.19形式の負の最大値 -128.0
    const Q8_19_NEG_MAX: q8_19 = 27'sb10000000_000_00000000_00000000;
    /// Q8.19形式の+1.0の定数
    const Q8_19_POS_ONE: q8_19 = 27'sb00000001_000_00000000_00000000;
    /// Q8.19形式の-1.0の定数
    const Q8_19_NEG_ONE: q8_19 = 27'sb11111111_000_00000000_00000000;
    /// Q8.19形式のゼロ
    const Q8_19_ZERO: q8_19 = 27'sd0;

    /// f64からQ8.19形式へ変換
    function to_q8_19 (
        val: input f64,
    ) -> q8_19 {
        // 範囲チェック (-128.0 <= val < 128.0)
        if val <: -128.0 | val >= 128.0 {
            $error("to_q8_19: Value out of range. Must be -128.0 <= val < 128.0");
        }
        const scale  : f64 = 524288.0; // 2^19
        let   scaled : f64 = val * scale;
        let   rounded: i32 = scaled as i32;
        // 32bitから27bitへのキャスト。範囲チェック済みなので上位ビット切り捨てで問題ない
        return rounded as q8_19;
    }

    //----------------------------------------------------------------
    // Q3.24形式 (+/-4.0 表示範囲)
    //----------------------------------------------------------------
    /// Q3.24形式 (+/-4.0 表示範囲)
    /// DSPブロックの乗算器が36x27bitなので、係数用に作成した型
    /// ゲイン係数やエンベロープ係数などに使用
    type q3_24 = signed logic<27>; // 3ビット整数部 + 24ビット小数部
    /// Q3.24形式の正の最大値 +4.0-1LSB
    const Q3_24_POS_MAX: q3_24 = 27'sb011_11111111_11111111_11111111;
    /// Q3.24形式の負の最大値 -4.0
    const Q3_24_NEG_MAX: q3_24 = 27'sb100_00000000_00000000_00000000;
    /// Q3.24形式の+1.0の定数
    const Q3_24_POS_ONE: q3_24 = 27'sb001_00000000_00000000_00000000;
    /// Q3.24形式の-1.0の定数
    const Q3_24_NEG_ONE: q3_24 = 27'sb111_00000000_00000000_00000000;
    /// Q3.24形式のゼロ
    const Q3_24_ZERO: q3_24 = 27'sd0;

    /// f64からQ3.24形式へ変換
    function to_q3_24 (
        val: input f64,
    ) -> q3_24 {
        // 範囲チェック (-4.0 <= val < 4.0)
        if val <: -4.0 | val >= 4.0 {
            $error("to_q3_24: Value out of range. Must be -4.0 <= val < 4.0");
        }
        const scale  : f64 = 16777216.0; // 2^24
        let   scaled : f64 = val * scale;
        let   rounded: i32 = scaled as i32;
        // 32bitから27bitへのキャスト。範囲チェック済みなので上位ビット切り捨てで問題ない
        return rounded as q3_24;
    }

    /// Q8.24形式→Q1.31形式へ変換（7bit左シフト+下位7ビットゼロ埋め）
    /// Q8.24の+/-1.0範囲を超える入力はクリップする
    /// Note: 下位7ビットが0埋めされているだけなので、本当はサミングなどで+/-128の範囲に増やしてから読み替えだけした方がいい。
    function to_q1_31_from_q8_24_zero_pad (
        v: input q8_24,
    ) -> q1_31 {
        if v >= Q8_24_POS_ONE {
            return 32'h7FFF_FFFF;
        } else if v <= Q8_24_NEG_ONE {
            return 32'h8000_0000;
        }
        return v <<< 7;
    }

    /// Q1.31形式→Q8.24形式へ変換（7bit右シフト）
    /// Q1.31の+/-1.0範囲をQ8.24の+/-1.0範囲に変換
    function to_q8_24_from_q1_31 (
        v: input q1_31,
    ) -> q8_24 {
        return v >>> 7;
    }
}

/// signed値を算術右シフトし、指定モードで丸める。
/// MODEにはFixedPoint::ROUND_*を指定する。
pub function round_shift_signed::<WIDTH: u32, SHIFT: u32, MODE: u32> (
    value: input signed logic<WIDTH>,
) -> signed logic<WIDTH> {
    const HALF: u32 = if SHIFT == 0 ? 0 : 1 << (SHIFT - 1);

    let value_ext : signed logic<WIDTH + 1> = $signed({value[msb], value});
    let half_value: signed logic<WIDTH + 1> = HALF;
    var result    : signed logic<WIDTH + 1>;

    if SHIFT == 0 {
        result = value_ext;
    } else if MODE == 0 {
        result = value_ext >>> SHIFT;
    } else if MODE == 1 {
        result = (value_ext + half_value) >>> SHIFT;
    } else if value_ext[msb] == 1'b0 {
        result = (value_ext + half_value) >>> SHIFT;
    } else {
        result = -((-value_ext + half_value) >>> SHIFT);
    }

    return $signed(result[WIDTH - 1:0]);
}

/// unsigned値を右シフトし、指定モードで丸める。
pub function round_shift_unsigned::<WIDTH: u32, SHIFT: u32, MODE: u32> (
    value: input logic<WIDTH>,
) -> logic<WIDTH> {
    const HALF: u32 = if SHIFT == 0 ? 0 : 1 << (SHIFT - 1);

    let value_ext: logic<WIDTH + 1> = {1'b0, value};
    var result   : logic<WIDTH + 1>;

    if SHIFT == 0 {
        result = value_ext;
    } else if MODE == 0 {
        result = value_ext >> SHIFT;
    } else {
        result = (value_ext + HALF) >> SHIFT;
    }

    return result[WIDTH - 1:0];
}

/// signed値を指定幅へ飽和させる。
pub function saturate_signed::<IN_WIDTH: u32, OUT_WIDTH: u32> (
    value: input signed logic<IN_WIDTH>,
) -> signed logic<OUT_WIDTH> {
    const WORK_WIDTH  : u32 = if IN_WIDTH >= OUT_WIDTH ? IN_WIDTH + 1 : OUT_WIDTH + 1;
    const BODY_WIDTH  : u32 = OUT_WIDTH - 1;
    const EXTEND_WIDTH: u32 = WORK_WIDTH - OUT_WIDTH;

    let value_ext: signed logic<WORK_WIDTH> = $signed({value[msb] repeat WORK_WIDTH - IN_WIDTH, value});
    let max_value: signed logic<WORK_WIDTH> = {1'b0 repeat EXTEND_WIDTH, 1'b0, 1'b1 repeat BODY_WIDTH};
    let min_value: signed logic<WORK_WIDTH> = {1'b1 repeat EXTEND_WIDTH, 1'b1, 1'b0 repeat BODY_WIDTH};

    if value_ext >: max_value {
        return $signed(max_value[OUT_WIDTH - 1:0]);
    } else if value_ext <: min_value {
        return $signed(min_value[OUT_WIDTH - 1:0]);
    } else {
        return $signed(value_ext[OUT_WIDTH - 1:0]);
    }
}

/// unsigned値を指定幅へ飽和させる。
pub function saturate_unsigned::<IN_WIDTH: u32, OUT_WIDTH: u32> (
    value: input logic<IN_WIDTH>,
) -> logic<OUT_WIDTH> {
    const WORK_WIDTH  : u32 = if IN_WIDTH >= OUT_WIDTH ? IN_WIDTH + 1 : OUT_WIDTH + 1;
    const EXTEND_WIDTH: u32 = WORK_WIDTH - OUT_WIDTH;

    let value_ext: logic<WORK_WIDTH> = {1'b0 repeat WORK_WIDTH - IN_WIDTH, value};
    let max_value: logic<WORK_WIDTH> = {1'b0 repeat EXTEND_WIDTH, 1'b1 repeat OUT_WIDTH};

    if value_ext >: max_value {
        return max_value[OUT_WIDTH - 1:0];
    } else {
        return value_ext[OUT_WIDTH - 1:0];
    }
}

/// signed値を任意の上下限へ制限する。
pub function clamp_signed::<WIDTH: u32> (
    value: input signed logic<WIDTH>,
    lower: input signed logic<WIDTH>,
    upper: input signed logic<WIDTH>,
) -> signed logic<WIDTH> {
    if value <: lower {
        return lower;
    } else if value >: upper {
        return upper;
    } else {
        return value;
    }
}

/// unsigned値を任意の上下限へ制限する。
pub function clamp_unsigned::<WIDTH: u32> (
    value: input logic<WIDTH>,
    lower: input logic<WIDTH>,
    upper: input logic<WIDTH>,
) -> logic<WIDTH> {
    if value <: lower {
        return lower;
    } else if value >: upper {
        return upper;
    } else {
        return value;
    }
}

/// signed固定小数点値を小数ビット数と出力幅ごと変換する。
/// MODEにはFixedPoint::ROUND_*を指定する。
pub function fixed_resize_signed::<IN_WIDTH: u32, IN_FRAC: u32, OUT_WIDTH: u32, OUT_FRAC: u32, MODE: u32> (
    value: input signed logic<IN_WIDTH>,
) -> signed logic<OUT_WIDTH> {
    const LEFT_SHIFT  : u32 = if IN_FRAC >= OUT_FRAC ? 0 : OUT_FRAC - IN_FRAC;
    const RIGHT_SHIFT : u32 = if OUT_FRAC >= IN_FRAC ? 0 : IN_FRAC - OUT_FRAC;
    const WORK_WIDTH  : u32 = if IN_WIDTH + LEFT_SHIFT >= OUT_WIDTH ? IN_WIDTH + LEFT_SHIFT + 2 : OUT_WIDTH + 2;
    const HALF        : u32 = if RIGHT_SHIFT == 0 ? 0 : 1 << (RIGHT_SHIFT - 1);
    const BODY_WIDTH  : u32 = OUT_WIDTH - 1;
    const EXTEND_WIDTH: u32 = WORK_WIDTH - OUT_WIDTH;

    let value_ext : signed logic<WORK_WIDTH> = $signed({value[msb] repeat WORK_WIDTH - IN_WIDTH, value});
    let half_value: signed logic<WORK_WIDTH> = HALF;
    var aligned   : signed logic<WORK_WIDTH>;

    if RIGHT_SHIFT != 0 {
        if MODE == 0 {
            aligned = value_ext >>> RIGHT_SHIFT;
        } else if MODE == 1 {
            aligned = (value_ext + half_value) >>> RIGHT_SHIFT;
        } else if value_ext[msb] == 1'b0 {
            aligned = (value_ext + half_value) >>> RIGHT_SHIFT;
        } else {
            aligned = -((-value_ext + half_value) >>> RIGHT_SHIFT);
        }
    } else {
        aligned = value_ext <<< LEFT_SHIFT;
    }

    let max_value: signed logic<WORK_WIDTH> = {1'b0 repeat EXTEND_WIDTH, 1'b0, 1'b1 repeat BODY_WIDTH};
    let min_value: signed logic<WORK_WIDTH> = {1'b1 repeat EXTEND_WIDTH, 1'b1, 1'b0 repeat BODY_WIDTH};

    if aligned[msb] == 1'b1 {
        if aligned <: min_value {
            return $signed(min_value[OUT_WIDTH - 1:0]);
        } else {
            return $signed(aligned[OUT_WIDTH - 1:0]);
        }
    } else if aligned >: max_value {
        return $signed(max_value[OUT_WIDTH - 1:0]);
    } else {
        return $signed(aligned[OUT_WIDTH - 1:0]);
    }
}

/// signed整数同士を、入力幅の合計幅で乗算する。
/// 結果の幅はA_WIDTH+B_WIDTH、小数ビット数は入力の小数ビット数の合計とする。
/// 出力変換時は、この積をfixed_resize_signedへ渡して小数位置を調整する。
pub function fixed_mul::<A_WIDTH: u32, B_WIDTH: u32> (
    a: input signed logic<A_WIDTH>,
    b: input signed logic<B_WIDTH>,
) -> signed logic<A_WIDTH + B_WIDTH> {
    const PRODUCT_WIDTH: u32 = A_WIDTH + B_WIDTH;

    let a_ext: signed logic<PRODUCT_WIDTH> = $signed({a[msb] repeat B_WIDTH, a});
    let b_ext: signed logic<PRODUCT_WIDTH> = $signed({b[msb] repeat A_WIDTH, b});

    return a_ext * b_ext;
}
