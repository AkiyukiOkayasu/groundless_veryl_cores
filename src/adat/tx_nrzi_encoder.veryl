/// TX NRZIエンコーダ
///
/// シリアル入力ビットをNRZI信号へ変換する。
/// - `serial_bit = 1` のとき出力レベルを反転
/// - `serial_bit = 0` のとき出力レベルを維持
module TxNrziEncoder (
    /// システムクロック
    clk: input clock,
    rst: input reset,
    /// シリアル入力ビット
    serial_bit: input logic,
    /// 入力ビット有効
    valid: input logic,
    /// NRZI出力
    nrzi: output logic,
) {
    var nrzi_level: logic;

    assign nrzi = nrzi_level;

    always_ff {
        if_reset {
            nrzi_level = 1'b0;
        } else if valid {
            if serial_bit {
                nrzi_level = ~nrzi_level;
            }
        }
    }
}
