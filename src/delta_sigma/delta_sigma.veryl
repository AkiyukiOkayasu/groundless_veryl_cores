/// PCMを1bit PDMへ変換するデルタシグマ変調器。
/// 入力はFixedPoint::q1_31（-1.0以上、+1.0未満）とする。

/// 1次デルタシグマ変調器。
///
/// キャリー・アキュムレータ形式で実装し、入力のDC値に比例した
/// PDM密度を得る。`pdm`は`clk`ごとに1bit更新される。
pub module DeltaSigma1st (
    clk  : input  clock            ,
    rst  : input  reset            ,
    audio: input  FixedPoint::q1_31,
    pdm  : output logic            ,
) {
    var accumulator: logic<33>;

    always_ff {
        if_reset {
            accumulator = 0;
            pdm         = 1'b0;
        } else {
            let audio_unsigned: logic<32> = {~audio[31], audio[30:0]};
            accumulator    = (accumulator[31:0] as 33) + (audio_unsigned as 33);
            pdm            = accumulator[32];
        }
    }
}

/// 2次デルタシグマ変調器。
///
/// 2段の積分器を持つ簡易構成で、1次変調器より高い帯域外ノイズ
/// シェーピングを得る。内部演算は余裕を持たせた40bit signedとする。
pub module DeltaSigma2nd (
    clk  : input  clock            ,
    rst  : input  reset            ,
    audio: input  FixedPoint::q1_31,
    pdm  : output logic            ,
) {
    var integrator_1: signed logic<40>;
    var integrator_2: signed logic<40>;

    // PDM帰還値: FEEDBACK_POS = 2^30 - 1、FEEDBACK_NEG = -2^30。
    const FEEDBACK_POS: signed logic<40> = 1073741823;
    const FEEDBACK_NEG: signed logic<40> = -1073741824;

    always_ff {
        if_reset {
            integrator_1 = 0;
            integrator_2 = 0;
            pdm          = 1'b0;
        } else {
            let audio_scaled     : FixedPoint::q1_31     = audio >>> 2;
            let input_ext        : signed logic     <40> = audio_scaled as 40;
            let feedback         : signed logic     <40> = if pdm ? FEEDBACK_POS : FEEDBACK_NEG;
            let integrator_1_next: signed logic     <40> = integrator_1 + (input_ext - feedback);
            let integrator_2_next: signed logic     <40> = integrator_2 + (integrator_1_next - feedback);

            integrator_1 = integrator_1_next;
            integrator_2 = integrator_2_next;
            pdm          = ~integrator_2_next[39];
        }
    }
}

/// デルタシグマ変調器のPDM密度を検証するVeryl Native test。
#[test(test_delta_sigma_1st_density)]
module test_delta_sigma_1st_density {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var zero_audio    : FixedPoint::q1_31   ;
    var positive_audio: FixedPoint::q1_31   ;
    var negative_audio: FixedPoint::q1_31   ;
    var zero_pdm      : logic               ;
    var positive_pdm  : logic               ;
    var negative_pdm  : logic               ;
    var zero_ones     : logic            <8>;
    var positive_ones : logic            <8>;
    var negative_ones : logic            <8>;

    inst zero: DeltaSigma1st (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : zero_pdm  ,
    );
    inst positive: DeltaSigma1st (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma1st (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            zero_ones     = 0;
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if zero_pdm {
                zero_ones = zero_ones + 1;
            }
            if positive_pdm {
                positive_ones = positive_ones + 1;
            }
            if negative_pdm {
                negative_ones = negative_ones + 1;
            }
        }
    }

    initial {
        zero_audio     = 0;
        positive_audio = FixedPoint::Q1_31_POS_MAX;
        negative_audio = FixedPoint::Q1_31_NEG_MAX;
        rst.assert();
        clk.next(64);

        $assert(zero_ones >: 8'd24 && zero_ones <: 8'd40, "1st order zero density mismatch");
        $assert(positive_ones >: 8'd56, "1st order positive density is too low");
        $assert(negative_ones <: 8'd8, "1st order negative density is too high");
        $finish();
    }
}

#[test(test_delta_sigma_2nd_density)]
module test_delta_sigma_2nd_density {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var zero_audio    : FixedPoint::q1_31   ;
    var positive_audio: FixedPoint::q1_31   ;
    var negative_audio: FixedPoint::q1_31   ;
    var zero_pdm      : logic               ;
    var positive_pdm  : logic               ;
    var negative_pdm  : logic               ;
    var zero_ones     : logic            <8>;
    var positive_ones : logic            <8>;
    var negative_ones : logic            <8>;

    inst zero: DeltaSigma2nd (
        clk  : clk       ,
        rst  : rst       ,
        audio: zero_audio,
        pdm  : zero_pdm  ,
    );
    inst positive: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: positive_audio,
        pdm  : positive_pdm  ,
    );
    inst negative: DeltaSigma2nd (
        clk  : clk           ,
        rst  : rst           ,
        audio: negative_audio,
        pdm  : negative_pdm  ,
    );

    always_ff (clk, rst) {
        if_reset {
            zero_ones     = 0;
            positive_ones = 0;
            negative_ones = 0;
        } else {
            if zero_pdm {
                zero_ones = zero_ones + 1;
            }
            if positive_pdm {
                positive_ones = positive_ones + 1;
            }
            if negative_pdm {
                negative_ones = negative_ones + 1;
            }
        }
    }

    initial {
        zero_audio     = 0;
        positive_audio = FixedPoint::Q1_31_POS_MAX;
        negative_audio = FixedPoint::Q1_31_NEG_MAX;
        rst.assert();
        clk.next(128);

        $assert(zero_ones >: 8'd40 && zero_ones <: 8'd88, "2nd order zero density mismatch");
        $assert(positive_ones >: 8'd88, "2nd order positive density is too low");
        $assert(negative_ones <: 8'd40, "2nd order negative density is too high");
        $finish();
    }
}
