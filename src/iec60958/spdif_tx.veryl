/// S/PDIF用IEC 60958送信器。
///
/// S/PDIFではpreambleとchannel statusを上位から受け取り、
/// IEC60958TxでBMCシリアルストリームへ変換する。
import Iec60958::AudioSample;
import Iec60958::LinkType;

pub module SpdifTx (
    clk           : input  clock      ,
    rst           : input  reset      ,
    audio         : input  AudioSample,
    validity      : input  logic      ,
    user          : input  logic      ,
    channel_status: input  logic      ,
    is_b          : input  logic      ,
    block_start   : input  logic      ,
    data_valid    : input  logic      ,
    line_bit      : output logic      ,
    line_valid    : output logic      ,
    busy          : output logic      ,
) {
    inst core: Iec60958Tx #(
        LINK_TYPE: LinkType::Spdif,
    ) (
        clk           : clk           ,
        rst           : rst           ,
        audio         : audio         ,
        validity      : validity      ,
        user          : user          ,
        channel_status: channel_status,
        is_b          : is_b          ,
        block_start   : block_start   ,
        data_valid    : data_valid    ,
        line_bit      : line_bit      ,
        line_valid    : line_valid    ,
        busy          : busy          ,
    );
}
