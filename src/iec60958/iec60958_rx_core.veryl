/// IEC 60958共通サブフレーム受信コア。
///
/// BMC受信器からpreambleと28bit payloadを受け取り、偶数パリティが
/// 正しいサブフレームだけを`data_valid`で出力する。
import Iec60958::AudioSample;
import Iec60958::LinkType;
import Iec60958::PreambleLineCode;

pub module Iec60958Rx #(
    param LINK_TYPE: LinkType = LinkType::Spdif,
) (
    clk           : input  clock      ,
    rst           : input  reset      ,
    line_bit      : input  logic      ,
    line_valid    : input  logic      ,
    audio         : output AudioSample,
    validity      : output logic      ,
    user          : output logic      ,
    channel_status: output logic      ,
    is_b          : output logic      ,
    block_start   : output logic      ,
    data_valid    : output logic      ,
    parity_error  : output logic      ,
    preamble_error: output logic      ,
) {
    var payload_shift         : logic      <28>;
    var payload_count         : logic      <5> ;
    var in_payload            : logic          ;
    var frame_preamble_valid  : logic          ;
    var audio_reg             : AudioSample    ;
    var validity_reg          : logic          ;
    var user_reg              : logic          ;
    var channel_status_reg    : logic          ;
    var is_b_reg              : logic          ;
    var block_start_reg       : logic          ;
    var pending_valid         : logic          ;
    var pending_parity_error  : logic          ;
    var pending_preamble_error: logic          ;

    var bmc_data_bit      : logic           ;
    var bmc_data_valid    : logic           ;
    var bmc_error         : logic           ;
    var bmc_preamble      : PreambleLineCode;
    var bmc_preamble_valid: logic           ;
    var bmc_preamble_error: logic           ;

    inst bmc: Iec60958BmcRx (
        clk           : clk               ,
        rst           : rst               ,
        line_bit      : line_bit          ,
        line_valid    : line_valid        ,
        data_bit      : bmc_data_bit      ,
        data_valid    : bmc_data_valid    ,
        error         : bmc_error         ,
        preamble      : bmc_preamble      ,
        preamble_valid: bmc_preamble_valid,
        preamble_error: bmc_preamble_error,
    );

    assign audio          = audio_reg;
    assign validity       = validity_reg;
    assign user           = user_reg;
    assign channel_status = channel_status_reg;
    assign is_b           = is_b_reg;
    assign block_start    = block_start_reg;
    always_ff {
        if_reset {
            payload_shift          = 28'd0;
            payload_count          = 5'd0;
            in_payload             = 1'b0;
            frame_preamble_valid   = 1'b0;
            audio_reg              = 0;
            validity_reg           = 1'b0;
            user_reg               = 1'b0;
            channel_status_reg     = 1'b0;
            is_b_reg               = 1'b0;
            block_start_reg        = 1'b0;
            pending_valid          = 1'b0;
            pending_parity_error   = 1'b0;
            pending_preamble_error = 1'b0;
            data_valid             = 1'b0;
            parity_error           = 1'b0;
            preamble_error         = 1'b0;
        } else {
            data_valid             = pending_valid;
            parity_error           = pending_parity_error;
            preamble_error         = pending_preamble_error;
            pending_valid          = 1'b0;
            pending_parity_error   = 1'b0;
            pending_preamble_error = 1'b0;

            if bmc_error {
                in_payload             = 1'b0;
                payload_shift          = 28'd0;
                payload_count          = 5'd0;
                frame_preamble_valid   = 1'b0;
                pending_preamble_error = 1'b1;
            }

            if !in_payload {
                if bmc_preamble_valid || bmc_preamble_error {
                    in_payload           = 1'b1;
                    payload_shift        = 28'd0;
                    payload_count        = 5'd0;
                    frame_preamble_valid = bmc_preamble_valid;
                    block_start_reg      = bmc_preamble == PreambleLineCode::Z;
                    is_b_reg             = bmc_preamble == PreambleLineCode::Y;
                    if bmc_preamble_error {
                        pending_preamble_error = 1'b1;
                    }
                }
            } else if bmc_data_valid {
                let next_payload : logic<28> = {payload_shift[26:0], bmc_data_bit};
                payload_shift = next_payload;

                if payload_count == 5'd27 {
                    let parity: logic = ~(^next_payload[27:1]);
                    if !frame_preamble_valid {
                        pending_preamble_error = 1'b1;
                    } else if parity != next_payload[0] {
                        pending_parity_error = 1'b1;
                    } else {
                        audio_reg          = next_payload[27:4];
                        validity_reg       = next_payload[3];
                        user_reg           = next_payload[2];
                        channel_status_reg = next_payload[1];
                        pending_valid      = 1'b1;
                    }
                    in_payload           = 1'b0;
                    payload_shift        = 28'd0;
                    payload_count        = 5'd0;
                    frame_preamble_valid = 1'b0;
                } else {
                    payload_count = payload_count + 5'd1;
                }
            }
        }
    }
}

/// 共通送受信コアのS/PDIF preamble・payload・parityを検証する。
#[test(test_iec60958_core_spdif_loopback)]
module test_iec60958_core_spdif_loopback {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var audio_in           : Iec60958::AudioSample;
    var data_valid_in      : logic                ;
    var line_bit           : logic                ;
    var line_valid         : logic                ;
    var busy               : logic                ;
    var audio_out          : Iec60958::AudioSample;
    var validity_out       : logic                ;
    var user_out           : logic                ;
    var channel_status_out : logic                ;
    var is_b_out           : logic                ;
    var block_start_out    : logic                ;
    var data_valid_out     : logic                ;
    var parity_error       : logic                ;
    var preamble_error     : logic                ;
    var seen               : logic                ;
    var audio_seen         : Iec60958::AudioSample;
    var validity_seen      : logic                ;
    var user_seen          : logic                ;
    var channel_status_seen: logic                ;

    inst tx: Iec60958Tx #(
        LINK_TYPE: Iec60958::LinkType::Spdif,
    ) (
        clk           : clk          ,
        rst           : rst          ,
        audio         : audio_in     ,
        validity      : 1'b1         ,
        user          : 1'b0         ,
        channel_status: 1'b1         ,
        is_b          : 1'b0         ,
        block_start   : 1'b0         ,
        data_valid    : data_valid_in,
        line_bit      : line_bit     ,
        line_valid    : line_valid   ,
        busy          : busy         ,
    );
    inst rx: Iec60958Rx #(
        LINK_TYPE: Iec60958::LinkType::Spdif,
    ) (
        clk           : clk               ,
        rst           : rst               ,
        line_bit      : line_bit          ,
        line_valid    : line_valid        ,
        audio         : audio_out         ,
        validity      : validity_out      ,
        user          : user_out          ,
        channel_status: channel_status_out,
        is_b          : is_b_out          ,
        block_start   : block_start_out   ,
        data_valid    : data_valid_out    ,
        parity_error  : parity_error      ,
        preamble_error: preamble_error    ,
    );

    always_ff (clk, rst) {
        if_reset {
            seen                = 1'b0;
            audio_seen          = 0;
            validity_seen       = 1'b0;
            user_seen           = 1'b0;
            channel_status_seen = 1'b0;
        } else if data_valid_out {
            seen                = 1'b1;
            audio_seen          = audio_out;
            validity_seen       = validity_out;
            user_seen           = user_out;
            channel_status_seen = channel_status_out;
        }
    }

    initial {
        audio_in      = 24'sh123456;
        data_valid_in = 1'b0;
        rst.assert();
        data_valid_in = 1'b1;
        clk.next(1);
        data_valid_in = 1'b0;
        clk.next(120);

        $assert(seen == 1'b1, "IEC60958 S/PDIF loopback did not complete");
        $assert(audio_seen == 24'sh123456, "IEC60958 audio mismatch");
        $assert(validity_seen == 1'b1, "IEC60958 validity mismatch");
        $assert(user_seen == 1'b0, "IEC60958 user mismatch");
        $assert(channel_status_seen == 1'b1, "IEC60958 channel status mismatch");
        $assert(parity_error == 1'b0 && preamble_error == 1'b0, "IEC60958 error asserted");
        $finish();
    }
}
