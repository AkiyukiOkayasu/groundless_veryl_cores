/// AES3用IEC 60958送信器。
///
/// AES3 professional channel statusの生成とCRC更新を行い、
/// 共通送信コアへ接続する。
import Iec60958::AudioSample;
import Iec60958::LinkType;
import Iec60958::SampleRate;
import Aes3::ChannelMode;

pub module Aes3Tx (
    clk         : input  clock      ,
    rst         : input  reset      ,
    audio       : input  AudioSample,
    sample_rate : input  SampleRate ,
    channel_mode: input  ChannelMode,
    is_b        : input  logic      ,
    data_valid  : input  logic      ,
    line_bit    : output logic      ,
    line_valid  : output logic      ,
    busy        : output logic      ,
) {
    var sample_rate_reg : SampleRate    ;
    var channel_mode_reg: ChannelMode   ;
    var frame_counter   : logic      <8>;
    var crc             : logic      <8>;
    var channel_status  : logic         ;
    var need_block_start: logic         ;
    var block_start     : logic         ;
    var effective_rate  : SampleRate    ;
    var effective_mode  : ChannelMode   ;

    assign block_start = need_block_start && data_valid && !is_b;

    always_comb {
        effective_rate = sample_rate_reg;
        effective_mode = channel_mode_reg;
        if block_start {
            effective_rate = sample_rate;
            effective_mode = channel_mode;
        }

        if frame_counter <: 8'd184 {
            channel_status = Aes3::channel_status_bit(frame_counter, effective_rate, effective_mode);
        } else if frame_counter <: 8'd192 {
            channel_status = crc[frame_counter - 8'd184];
        } else {
            channel_status = 1'b0;
        }
    }

    always_ff {
        if_reset {
            sample_rate_reg  = SampleRate::Unknown;
            channel_mode_reg = ChannelMode::NotIndicated;
            frame_counter    = 8'd0;
            crc              = 8'hFF;
            need_block_start = 1'b1;
        } else if block_start {
            sample_rate_reg  = sample_rate;
            channel_mode_reg = channel_mode;
            frame_counter    = 8'd0;
            crc              = 8'hFF;
            need_block_start = 1'b0;
        } else if data_valid && is_b {
            if frame_counter <: 8'd191 {
                frame_counter = frame_counter + 8'd1;
            } else {
                need_block_start = 1'b1;
            }

            if frame_counter <: 8'd184 {
                let feedback: logic = crc[0] ^ channel_status;
                if feedback {
                    crc = (crc >> 1) ^ 8'hB8;
                } else {
                    crc = crc >> 1;
                }
            }
        }
    }

    inst core: Iec60958Tx #(
        LINK_TYPE: LinkType::Aes3,
    ) (
        clk           : clk           ,
        rst           : rst           ,
        audio         : audio         ,
        validity      : 1'b0          ,
        user          : 1'b0          ,
        channel_status: channel_status,
        is_b          : is_b          ,
        block_start   : block_start   ,
        data_valid    : data_valid    ,
        line_bit      : line_bit      ,
        line_valid    : line_valid    ,
        busy          : busy          ,
    );
}
