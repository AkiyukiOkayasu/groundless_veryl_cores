/// 2点間の線形補間器。
///
/// `phase`は0以上1未満のQ0.PHASE_WIDTH値で、sample0からsample1へ
/// 移動する割合を表す。乗算結果は補間後に切り捨てる。
pub module LinearInterpolator #(
    param SAMPLE_WIDTH: u32 = 32,
    param PHASE_WIDTH : u32 = 32,
) (
    sample0: input  signed logic<SAMPLE_WIDTH>,
    sample1: input  signed logic<SAMPLE_WIDTH>,
    phase  : input  logic       <PHASE_WIDTH> ,
    sample : output signed logic<SAMPLE_WIDTH>,
) {
    always_comb {
        let sample0_ext: signed logic<SAMPLE_WIDTH + 2>               = $signed({sample0[msb] repeat 2, sample0});
        let delta      : signed logic<SAMPLE_WIDTH + 1>               = $signed({sample1[msb], sample1})
            - $signed({sample0[msb], sample0});
        let phase_ext  : signed logic<PHASE_WIDTH + 1>                = $signed({1'b0, phase});
        let product    : signed logic<SAMPLE_WIDTH + PHASE_WIDTH + 2> = delta * phase_ext;
        let fraction   : signed logic<SAMPLE_WIDTH + 2>               = product >>> PHASE_WIDTH;
        let result     : signed logic<SAMPLE_WIDTH + 2>               = sample0_ext + fraction;
        sample      = $signed(result[SAMPLE_WIDTH - 1:0]);
    }
}

/// 4点Lagrange多項式をFarrow形式で評価する補間器。
///
/// 係数はQ2.16へ量子化している。Farrowの係数生成と評価をこの低レベル
/// コアへ分離することで、ASRC本体のsample window管理と交換できるようにする。
pub module FarrowInterpolator #(
    param SAMPLE_WIDTH: u32 = 32,
    param PHASE_WIDTH : u32 = 32,
) (
    sample_m1: input  signed logic<SAMPLE_WIDTH>,
    sample0  : input  signed logic<SAMPLE_WIDTH>,
    sample1  : input  signed logic<SAMPLE_WIDTH>,
    sample2  : input  signed logic<SAMPLE_WIDTH>,
    phase    : input  logic       <PHASE_WIDTH> ,
    sample   : output signed logic<SAMPLE_WIDTH>,
) {
    const COEFF_WIDTH   : u32 = 18;
    const COEFF_FRACTION: u32 = 16;
    const SAMPLE_EXT    : u32 = SAMPLE_WIDTH + 2;
    const PRODUCT_WIDTH : u32 = SAMPLE_EXT + COEFF_WIDTH;
    const H2_WIDTH      : u32 = PRODUCT_WIDTH + PHASE_WIDTH + 1;
    const H1_WIDTH      : u32 = PRODUCT_WIDTH + PHASE_WIDTH * 2 + 2;
    const NUM_WIDTH     : u32 = PRODUCT_WIDTH + PHASE_WIDTH * 3 + 3;

    always_comb {
        let sample_m1_ext: signed logic<PRODUCT_WIDTH>   = sample_m1;
        let sample0_ext  : signed logic<PRODUCT_WIDTH>   = sample0;
        let sample1_ext  : signed logic<PRODUCT_WIDTH>   = sample1;
        let sample2_ext  : signed logic<PRODUCT_WIDTH>   = sample2;
        let mu           : signed logic<PHASE_WIDTH + 1> = $signed({1'b0, phase});

        // c1 = -sample_m1/3 - sample0/2 + sample1 - sample2/6
        let c1_raw: signed logic<PRODUCT_WIDTH> = sample_m1_ext * -18'sd21845 + sample0_ext * -18'sd32768 + sample1_ext
            * 18'sd65536 + sample2_ext * -18'sd10923;
        // c2 = sample_m1/2 - sample0 + sample1/2
        let c2_raw: signed logic<PRODUCT_WIDTH> = sample_m1_ext * 18'sd32768 + sample0_ext * -18'sd65536 + sample1_ext
            * 18'sd32768;
        // c3 = -sample_m1/6 + sample0/2 - sample1/2 + sample2/6
        let c3_raw: signed logic<PRODUCT_WIDTH> = sample_m1_ext * -18'sd10923 + sample0_ext * 18'sd32768 + sample1_ext
            * -18'sd32768 + sample2_ext * 18'sd10923;

        // Horner evaluation while keeping Q2.16 and phase precision until final shift.
        let c2_wide     : signed logic<H2_WIDTH>  = c2_raw;
        let c3_mu       : signed logic<H2_WIDTH>  = c3_raw * mu;
        let h2          : signed logic<H2_WIDTH>  = (c2_wide <<< PHASE_WIDTH) + c3_mu;
        let c1_wide     : signed logic<H1_WIDTH>  = c1_raw;
        let h2_mu       : signed logic<H1_WIDTH>  = h2 * mu;
        let h1          : signed logic<H1_WIDTH>  = (c1_wide <<< (PHASE_WIDTH * 2)) + h2_mu;
        let h1_mu       : signed logic<NUM_WIDTH> = h1 * mu;
        let sample0_wide: signed logic<NUM_WIDTH> = sample0;
        let c0          : signed logic<NUM_WIDTH> = sample0_wide <<< (COEFF_FRACTION + PHASE_WIDTH * 3);
        let result      : signed logic<NUM_WIDTH> = (c0 + h1_mu) >>> (COEFF_FRACTION + PHASE_WIDTH * 3);
        sample       = $signed(result[SAMPLE_WIDTH - 1:0]);
    }
}

/// 入力サンプル列を線形補間して、分数比のoutput tickへ変換するASRC。
///
/// 入力は`input_valid && input_ready`で受け付け、内部のVeryl STD FIFOへ
/// 一時保持する。`ratio`は「output 1回あたりに進む入力サンプル数」を
/// Q(整数3bit).PHASE_WIDTHで表す。例えば96kHz入力から48kHzを作る場合は
/// `2 << PHASE_WIDTH`、96kHz入力から44.1kHzを作る場合は
/// `96_000 / 44_100 << PHASE_WIDTH`相当を設定する。
pub module LinearAsrc #(
    param SAMPLE_WIDTH: u32 = 32,
    param PHASE_WIDTH : u32 = 32,
    param INPUT_DEPTH : u32 = 8 ,
) (
    clk          : input  clock                        ,
    rst          : input  reset                        ,
    input_valid  : input  logic                        ,
    input_ready  : output logic                        ,
    input_sample : input  signed logic<SAMPLE_WIDTH>   ,
    output_tick  : input  logic                        ,
    output_ready : output logic                        ,
    output_valid : output logic                        ,
    output_sample: output signed logic<SAMPLE_WIDTH>   ,
    ratio        : input  logic       <PHASE_WIDTH + 2>,
) {
    const LEVEL_WIDTH: u32 = $clog2(INPUT_DEPTH + 1);

    var fifo_empty      : logic                     ;
    var fifo_almost_full: logic                     ;
    var fifo_full       : logic                     ;
    var fifo_level      : logic       <LEVEL_WIDTH> ;
    var fifo_q          : signed logic<SAMPLE_WIDTH>;
    var fifo_push       : logic                     ;
    var fifo_pop        : logic                     ;
    var sample0         : signed logic<SAMPLE_WIDTH>;
    var sample1         : signed logic<SAMPLE_WIDTH>;
    var window_count    : logic       <2>           ;
    var refill_count    : logic       <3>           ;
    var phase           : logic       <PHASE_WIDTH> ;
    var interpolated    : signed logic<SAMPLE_WIDTH>;

    inst input_fifo: SyncFifo #(
        WIDTH: SAMPLE_WIDTH              ,
        TYPE : signed logic<SAMPLE_WIDTH>,
        DEPTH: INPUT_DEPTH               ,
    ) (
        clk        : clk             ,
        rst        : rst             ,
        clear      : 1'b0            ,
        push       : fifo_push       ,
        data       : input_sample    ,
        pop        : fifo_pop        ,
        empty      : fifo_empty      ,
        almost_full: fifo_almost_full,
        full       : fifo_full       ,
        level      : fifo_level      ,
        q          : fifo_q          ,
    );

    inst interpolator: LinearInterpolator #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
    ) (
        sample0: sample0     ,
        sample1: sample1     ,
        phase  : phase       ,
        sample : interpolated,
    );

    always_comb {
        input_ready  = !fifo_full;
        fifo_push    = input_valid && input_ready;
        output_ready = window_count == 2'd2 && refill_count == 3'd0;
        fifo_pop     = !fifo_empty && ((window_count <: 2'd2) || (refill_count != 3'd0));
    }

    always_ff {
        if_reset {
            sample0       = 0;
            sample1       = 0;
            window_count  = 0;
            refill_count  = 0;
            phase         = 0;
            output_valid  = 0;
            output_sample = 0;
        } else {
            output_valid = 0;

            if fifo_pop {
                if window_count == 2'd0 {
                    sample0      = fifo_q;
                    window_count = 2'd1;
                } else if window_count == 2'd1 {
                    sample1      = fifo_q;
                    window_count = 2'd2;
                } else if refill_count >: 3'd3 {
                    refill_count -= 1;
                } else if refill_count == 3'd2 {
                    sample0      = fifo_q;
                    refill_count = 3'd1;
                } else {
                    sample1      = fifo_q;
                    refill_count = 3'd0;
                }
            }

            if output_tick && output_ready {
                let phase_sum    : logic<PHASE_WIDTH + 3> = {3'b0, phase} + {1'b0, ratio};
                let advance      : logic<3>               = phase_sum[PHASE_WIDTH + 2:PHASE_WIDTH];
                output_sample = interpolated;
                output_valid  = 1;
                phase         = phase_sum[PHASE_WIDTH - 1:0];

                if advance == 3'd1 {
                    sample0      = sample1;
                    refill_count = 3'd1;
                } else if advance != 3'd0 {
                    refill_count = advance;
                }
            }
        }
    }
}

/// 4サンプル窓のFarrow補間を使うASRC。
///
/// 初期化時に4サンプルを受け取り、出力tickごとに分数位相を進める。
/// `ratio`が整数部Nを持つ場合は、窓をNサンプル進めて不足分をFIFOから
/// 補充する。Farrow補間のため、最初の出力は初期窓の2番目のsample位置になる。
pub module FarrowAsrc #(
    param SAMPLE_WIDTH: u32 = 32,
    param PHASE_WIDTH : u32 = 32,
    param INPUT_DEPTH : u32 = 8 ,
) (
    clk          : input  clock                        ,
    rst          : input  reset                        ,
    input_valid  : input  logic                        ,
    input_ready  : output logic                        ,
    input_sample : input  signed logic<SAMPLE_WIDTH>   ,
    output_tick  : input  logic                        ,
    output_ready : output logic                        ,
    output_valid : output logic                        ,
    output_sample: output signed logic<SAMPLE_WIDTH>   ,
    ratio        : input  logic       <PHASE_WIDTH + 2>,
) {
    const LEVEL_WIDTH: u32 = $clog2(INPUT_DEPTH + 1);

    var fifo_empty      : logic                     ;
    var fifo_almost_full: logic                     ;
    var fifo_full       : logic                     ;
    var fifo_level      : logic       <LEVEL_WIDTH> ;
    var fifo_q          : signed logic<SAMPLE_WIDTH>;
    var fifo_push       : logic                     ;
    var fifo_pop        : logic                     ;
    var sample_m1       : signed logic<SAMPLE_WIDTH>;
    var sample0         : signed logic<SAMPLE_WIDTH>;
    var sample1         : signed logic<SAMPLE_WIDTH>;
    var sample2         : signed logic<SAMPLE_WIDTH>;
    var window_count    : logic       <3>           ;
    var refill_count    : logic       <3>           ;
    var refill_start    : logic       <2>           ;
    var phase           : logic       <PHASE_WIDTH> ;
    var interpolated    : signed logic<SAMPLE_WIDTH>;

    inst input_fifo: SyncFifo #(
        WIDTH: SAMPLE_WIDTH              ,
        TYPE : signed logic<SAMPLE_WIDTH>,
        DEPTH: INPUT_DEPTH               ,
    ) (
        clk        : clk             ,
        rst        : rst             ,
        clear      : 1'b0            ,
        push       : fifo_push       ,
        data       : input_sample    ,
        pop        : fifo_pop        ,
        empty      : fifo_empty      ,
        almost_full: fifo_almost_full,
        full       : fifo_full       ,
        level      : fifo_level      ,
        q          : fifo_q          ,
    );

    inst interpolator: FarrowInterpolator #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
    ) (
        sample_m1: sample_m1   ,
        sample0  : sample0     ,
        sample1  : sample1     ,
        sample2  : sample2     ,
        phase    : phase       ,
        sample   : interpolated,
    );

    always_comb {
        input_ready  = !fifo_full;
        fifo_push    = input_valid && input_ready;
        output_ready = window_count == 3'd4 && refill_count == 3'd0;
        fifo_pop     = !fifo_empty && ((window_count <: 3'd4) || (refill_count != 3'd0));
    }

    always_ff {
        if_reset {
            sample_m1     = 0;
            sample0       = 0;
            sample1       = 0;
            sample2       = 0;
            window_count  = 0;
            refill_count  = 0;
            refill_start  = 0;
            phase         = 0;
            output_valid  = 0;
            output_sample = 0;
        } else {
            output_valid = 0;

            if fifo_pop {
                if window_count <: 3'd4 {
                    if window_count == 3'd0 {
                        sample_m1 = fifo_q;
                    } else if window_count == 3'd1 {
                        sample0 = fifo_q;
                    } else if window_count == 3'd2 {
                        sample1 = fifo_q;
                    } else {
                        sample2 = fifo_q;
                    }
                    window_count += 1;
                } else if refill_start == 2'd0 {
                    sample_m1    =  fifo_q;
                    refill_start += 1;
                    refill_count -= 1;
                } else if refill_start == 2'd1 {
                    sample0      =  fifo_q;
                    refill_start += 1;
                    refill_count -= 1;
                } else if refill_start == 2'd2 {
                    sample1      =  fifo_q;
                    refill_start += 1;
                    refill_count -= 1;
                } else {
                    sample2      =  fifo_q;
                    refill_count -= 1;
                }
            }

            if output_tick && output_ready {
                let phase_sum    : logic<PHASE_WIDTH + 3> = {3'b0, phase} + {1'b0, ratio};
                let advance      : logic<3>               = phase_sum[PHASE_WIDTH + 2:PHASE_WIDTH];
                output_sample = interpolated;
                output_valid  = 1;
                phase         = phase_sum[PHASE_WIDTH - 1:0];

                if advance == 3'd1 {
                    sample_m1    = sample0;
                    sample0      = sample1;
                    sample1      = sample2;
                    refill_start = 2'd3;
                    refill_count = 3'd1;
                } else if advance == 3'd2 {
                    sample_m1    = sample1;
                    sample0      = sample2;
                    refill_start = 2'd2;
                    refill_count = 3'd2;
                } else if advance == 3'd3 {
                    sample_m1    = sample2;
                    refill_start = 2'd1;
                    refill_count = 3'd3;
                } else if advance == 3'd4 {
                    refill_start = 2'd0;
                    refill_count = 3'd4;
                }
            }
        }
    }
}

/// 線形補間と分数比sample列変換を検証するVeryl Native test。
#[test(test_linear_asrc)]
module test_linear_asrc {
    const SAMPLE_WIDTH: u32 = 16;
    const PHASE_WIDTH : u32 = 4;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var sample0      : signed logic<SAMPLE_WIDTH>   ;
    var sample1      : signed logic<SAMPLE_WIDTH>   ;
    var phase        : logic       <PHASE_WIDTH>    ;
    var interpolated : signed logic<SAMPLE_WIDTH>   ;
    var input_valid  : logic                        ;
    var input_ready  : logic                        ;
    var input_sample : signed logic<SAMPLE_WIDTH>   ;
    var output_tick  : logic                        ;
    var output_ready : logic                        ;
    var output_valid : logic                        ;
    var output_sample: signed logic<SAMPLE_WIDTH>   ;
    var ratio        : logic       <PHASE_WIDTH + 2>;

    inst interpolation: LinearInterpolator #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
    ) (
        sample0              ,
        sample1              ,
        phase                ,
        sample : interpolated,
    );

    inst asrc: LinearAsrc #(
        SAMPLE_WIDTH: SAMPLE_WIDTH,
        PHASE_WIDTH : PHASE_WIDTH ,
        INPUT_DEPTH : 4           ,
    ) (
        clk            ,
        rst            ,
        input_valid    ,
        input_ready    ,
        input_sample   ,
        output_tick    ,
        output_ready   ,
        output_valid   ,
        output_sample  ,
        ratio          ,
    );

    initial {
        sample0      = 16'sd1000;
        sample1      = 16'sd3000;
        phase        = 4'd0;
        input_valid  = 0;
        input_sample = 0;
        output_tick  = 0;
        ratio        = 0;
        clk.next(1);
        $assert(interpolated == 16'sd1000, "linear interpolation phase zero mismatch");
        phase = 4'd8;
        clk.next(1);
        $assert(interpolated == 16'sd2000, "linear interpolation midpoint mismatch");

        input_sample = 16'sd100;
        input_valid  = 1;
        ratio        = 6'd24;
        rst.assert();
        clk.next(1);
        input_sample = 16'sd200;
        clk.next(1);
        input_sample = 16'sd300;
        clk.next(1);
        input_valid = 0;
        clk.next(3);
        $assert(output_ready, "ASRC must become ready after two input samples");

        output_tick = 1;
        clk.next(1);
        output_tick = 0;
        $assert(output_valid && output_sample == 16'sd100, "ASRC first sample mismatch");
        clk.next(1);
        $assert(output_ready, "ASRC must refill one sample after a 1.5x advance");

        output_tick = 1;
        clk.next(1);
        output_tick = 0;
        $assert(output_valid && output_sample == 16'sd250, "ASRC interpolated sample mismatch");
        $finish();
    }
}

/// Farrow補間器の端点と中点を検証するVeryl Native test。
#[test(test_farrow_interpolator)]
module test_farrow_interpolator {
    var sample_m1: signed logic<16>;
    var sample0  : signed logic<16>;
    var sample1  : signed logic<16>;
    var sample2  : signed logic<16>;
    var phase    : logic       <4> ;
    var sample   : signed logic<16>;

    inst dut: FarrowInterpolator #(
        SAMPLE_WIDTH: 16,
        PHASE_WIDTH : 4 ,
    ) (
        sample_m1  ,
        sample0    ,
        sample1    ,
        sample2    ,
        phase      ,
        sample     ,
    );

    initial {
        sample_m1 = 16'sd0;
        sample0   = 16'sd100;
        sample1   = 16'sd200;
        sample2   = 16'sd300;
        phase     = 4'd0;
        $assert(sample == 16'sd100, "Farrow phase zero mismatch");
        phase = 4'd8;
        $assert(sample == 16'sd149, "Farrow midpoint mismatch");
        $finish();
    }
}

/// Farrow ASRCの4点窓、分数advance、FIFO補充を検証するNative test。
#[test(test_farrow_asrc)]
module test_farrow_asrc {
    var input_valid  : logic           ;
    var input_ready  : logic           ;
    var input_sample : signed logic<16>;
    var output_tick  : logic           ;
    var output_ready : logic           ;
    var output_valid : logic           ;
    var output_sample: signed logic<16>;
    var ratio        : logic       <6> ;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    inst dut: FarrowAsrc #(
        SAMPLE_WIDTH: 16,
        PHASE_WIDTH : 4 ,
        INPUT_DEPTH : 4 ,
    ) (
        clk            ,
        rst            ,
        input_valid    ,
        input_ready    ,
        input_sample   ,
        output_tick    ,
        output_ready   ,
        output_valid   ,
        output_sample  ,
        ratio          ,
    );

    initial {
        input_valid  = 1;
        input_sample = 16'sd0;
        output_tick  = 0;
        ratio        = 6'd24;
        rst.assert();
        clk.next(1);
        input_sample = 16'sd100;
        clk.next(1);
        input_sample = 16'sd200;
        clk.next(1);
        input_sample = 16'sd300;
        clk.next(1);
        input_valid = 0;
        clk.next(5);
        $assert(output_ready, "Farrow ASRC must fill its four-sample window");

        input_sample = 16'sd400;
        input_valid  = 1;
        clk.next(1);
        input_valid = 0;
        output_tick = 1;
        clk.next(1);
        output_tick = 0;
        $assert(output_valid && output_sample == 16'sd100, "Farrow ASRC first sample mismatch");
        clk.next(3);
        $assert(output_ready, "Farrow ASRC must refill after a one-sample advance");

        output_tick = 1;
        clk.next(1);
        output_tick = 0;
        $assert(output_valid && output_sample == 16'sd249, "Farrow ASRC interpolated sample mismatch");
        $finish();
    }
}
